<Window x:Class="Sts2CharForge.App.StartupProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sts2CharForge —— 选择配置存档" Width="760" Height="480"
        Icon="waku.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="先选择一个配置存档"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555"
                       Text="必须载入或新建一个存档，才能进入主界面配置角色。双击存档也可以直接载入。"/>
        </StackPanel>

        <ListBox x:Name="ProfileList" Grid.Row="1" Margin="0,12,0,0" MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#777" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="载入选中存档" Padding="16,6" FontWeight="Bold" Click="OnLoad"/>
            <Button Content="新建配置" Padding="12,6" Margin="8,0,0,0" Click="OnNew"/>
            <Button Content="删除选中存档" Padding="12,6" Margin="8,0,0,0" Click="OnDelete"/>
            <Button Content="打开存档文件夹" Padding="12,6" Margin="8,0,0,0" Click="OnOpenFolder"/>
            <Button Content="退出程序" Padding="12,6" Margin="8,0,0,0" Click="OnQuit"/>
        </StackPanel>
    </Grid>
</Window>
