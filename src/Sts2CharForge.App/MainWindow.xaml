                            </StackPanel>
                            <!-- 升级后的自定义描述（需求：「在锻造卡的卡牌自定义描述加一个能够填入卡牌升级后的自定义描述」）：
                                 留空 = 升级后和上面那段一样；填了就生成 {IfUpgraded:show:升级后|没升级} -->
                            <TextBlock Margin="6,10,0,0" Text="升级后的自定义描述（留空 = 和上面那段一样）" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBox x:Name="CardUpgradedCustomDesc" Style="{StaticResource Field}" Margin="6,2,0,0" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" IsEnabled="{Binding ValueEditable}"
                                     Text="{Binding UpgradedCustomDescription, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnUpgradedCustomDescChanged"
                                     ToolTip="这张牌**升级之后**卡面上显示的文字。留空 = 和上面那段一样（老存档就是留空）。锻造卡的「升级前 / 升级后」两块布干的事不一样时用它：生成出来是 {IfUpgraded:show:升级后那段|没升级那段}，游戏里按有没有升级自动显示对应那一版。"/>
                            <StackPanel Orientation="Horizontal" Margin="6,2,0,0">
                                <Button Content="填入参数…" Padding="8,4" IsEnabled="{Binding ValueEditable}"
                                        Click="OnInsertParam" Tag="{Binding ElementName=CardUpgradedCustomDesc}"
                                        ToolTip="列出这张牌里能用的数值占位符（卡牌给的就是带 :diff() 的高亮写法 {Damage:diff()}），点一下插到光标处。"/>
                                <Button Content="自动填入（升级后）" Padding="8,4" Margin="6,0,0,0" IsEnabled="{Binding ValueEditable}"
                                        Click="OnAutoFillCardUpgradedDesc" Tag="{Binding ElementName=CardUpgradedCustomDesc}"
                                        ToolTip="把**升级后**那张布 / 那套效果自动写出来的描述填进来（锻造卡：升级后那张节点图的文案；普通卡：和上面那段一样，一般用不着填）。"/>
                            </StackPanel>
                            <!-- ⚠ V0.2.137：V0.2.135 加在这底下的「高亮字段…」按钮 + 弹窗 + 那行汇总**已按用户要求撤掉**
                                 （用户原话：「自定义描述的高亮字段指的是把游戏本体中显示高亮的字符直接显示在生成器的
                                 升级后自定义描述中，让用户可以自己填」→ 拍板 A = 不要弹窗多选）。
                                 现在高亮就是**普通文字**：直接在框里写 {Damage:diff()}。
                                 旁边的「填入参数…」给的就是带 :diff() 的写法（见 CSharpCodeGen.ParamHints）。
                                 校验器那两条还在（写了 {X:diff()} 但字段不存在 → 错误；裸 {X} 不存在 → 警告）。 -->
                            <TextBlock Margin="6,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="高亮自己写：这一段里直接写 {Damage:diff()}（本体那套差异高亮写法）= 升级后按「升级前 → 升级后」的数值差异变绿；写 {Damage} 就是普通颜色。点上面的「填入参数…」会给你现成的高亮写法。"/>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- 本体卡（打击 / 防御）没有效果可编：整列禁用（数值由本体决定）。
                             锻造卡也整列禁用：效果由锻造页右边那张节点图决定（需求：卡牌页锁死效果栏）。 -->
                        <DockPanel Grid.Column="2" IsEnabled="{Binding ValueEditable}">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="效果由「锻造」页的节点图决定，这里锁死不用改；要改效果请去「锻造」页（中间照样能改名称 / 类型 / 稀有度 / 卡池 / 关键字）。"
                                           TextWrapping="Wrap" Foreground="#7A5A00" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CardEffectsAreForged, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </WrapPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                       Visibility="{Binding CardEffectsEditable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=CardEffectList}"/>
                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=CardEffectList}"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCard"
                                        IsEnabled="{Binding CanUndoCard}" ToolTip="{Binding UndoCardHint}"/>
                            </WrapPanel>
                            <Grid IsEnabled="{Binding CardEffectsEditable, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ListBox x:Name="CardEffectList" Grid.Row="0" SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}" ItemsSource="{Binding Effects}" DisplayMemberPath="Display" SelectionChanged="OnCardEffectSelectionChanged"/>
                                <!-- ⚠ x:Name 只为自检用（V0.2.143：卡牌页这份「条件选项」绑的是 SelectedItem，
                                     和遗物 / 药水 / 额外资源量三页右下角那块同一个形状 —— 那三页以前因为
                                     折叠行的 Button 吃掉了点击、SelectedItem 一直是 null，所以「选了存不住」。
                                     卡牌页的效果列表**不是**折叠行模板，所以本来就选得中、一直正常。 -->
                                <Border x:Name="CardEffectEditorBox" Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                        DataContext="{Binding SelectedItem, ElementName=CardEffectList}">
                                    <!-- 条件选项跟着每条效果走（在效果编辑面板的最下面），不再挂整张牌 -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorCard}"/>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 自定义参数 / 组 ============ -->
            <TabItem x:Name="ParamTab" Header="自定义参数 / 组">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="8"/>
                        <!-- V0.2.256：从 Auto 改成 * —— 「组」那块现在有两块勾选列表（牌 / 状态），
                             Auto 会把整块撑到窗口外面（用户报「右边只看到卡牌，没有第二块」：那一块正好被裁在可视区外）。
                             * + MinHeight 让它在剩余空间里自己排，两块都看得见。 -->
                        <RowDefinition Height="*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <!-- ===== 上半部分：自定义参数 ===== -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="自定义参数">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="新建参数" Padding="8,4" Margin="0,0,6,0" Click="OnAddParam"
                                            ToolTip="自动挑一个还没被占用的字母（M、N、P…；X / Y 已被「当前所有能量 / 当前所有额外资源量」占用）"/>
                                    <Button Content="删除" Padding="8,4" Click="OnRemoveParam"/>
                                </WrapPanel>
                                <ListBox x:Name="ParamList" DisplayMemberPath="Display" ItemsSource="{Binding Profile.CustomParams}"/>
                            </DockPanel>
                        </GroupBox>

                        <TextBlock x:Name="ParamEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="请选择参数（或者点「新建参数」）"
                                   Visibility="{Binding SelectedItem, ElementName=ParamList, Converter={StaticResource EmptyToVisibility}}"/>

                        <Grid x:Name="ParamDetail" Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=ParamList}"
                              Visibility="{Binding SelectedItem, ElementName=ParamList, Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="300"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="参数" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,6"
                                               Text="参数就是一个中间变量：卡面公式 / 锻造页【数值】模块里写 =M*3，M 到底是「自己最大生命」还是「指定敌人的易伤层数」在这里规定。这些值打出牌的那一刻才知道，所以在生成出来的模组里现算（血量、层数变了结果就跟着变）。"/>
                                    <TextBlock Text="参数名（一个字母）" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="=" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                                        <TextBox Style="{StaticResource Field}" MaxLength="1" CharacterCasing="Upper"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="X / Y 已经被占用（= 当前所有能量 / 当前所有额外资源量），不能再用"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ParamNameWarn" TextWrapping="Wrap" Foreground="#B00" FontSize="11" Margin="0,2,0,0"
                                               Text="{Binding ParamNameWarnText, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <TextBlock Text="取值来源" Style="{StaticResource Label}"/>
                                    <!-- 可搜索下拉（和「增益 / 减益」那个同一个控件）：V0.2.162 起这里有 7 个固定来源
                                         + 80 条实时读数（V0.2.194 的卡牌专属读数 ThisCardDamage 不在这里 ——
                                         参数是「打出这张牌那一刻先算一次」的，选它会恒 0），普通下拉点起来太长 ——
                                         打字（「状态牌」/「能量」/「回合」）就能筛。
                                         注意不能套 ComboBox 那套 Style / DisplayMemberPath（控件类型不同）。 -->
                                    <local:SearchComboBox Margin="0,3,8,3"
                                                          SearchPath="Display"
                                                          ItemsSource="{Binding ParamSourceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id" SelectedValue="{Binding Source, Mode=TwoWay}"
                                                          ToolTip="可以打字搜索（比如输入「状态牌」/「本回合打出」）。前 7 项是固定数值来源，后面都是「实时读数」（每次取值现算）。"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,4"
                                               Text="{Binding SourceHint, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    <TextBlock Text="数值（选了「数值（固定数字）」时用）" Style="{StaticResource Label}"
                                               Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Style="{StaticResource Field}" Width="120" HorizontalAlignment="Left"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="从谁身上取" Style="{StaticResource Label}"
                                               Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              ItemsSource="{Binding ParamTargetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Target}"
                                              Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVis}}"/>

                                    <!-- V0.2.271（用户要求「参数页增加牌组里某种牌数，范围包括自定义关键词和组」）：
                                         只有来源选「牌组里某种牌的数量」时才出现；候选 = 范围限定那一整份
                                         （不限 / 攻击 / 技能 / 能力 / 诅咒 / 状态 / 每个自定义关键词 / 每个组）。 -->
                                    <TextBlock Text="数牌组里的哪种牌" Style="{StaticResource Label}"
                                               Visibility="{Binding ShowDeckFilter, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              ItemsSource="{Binding DeckFilterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding DeckFilter}"
                                              Visibility="{Binding ShowDeckFilter, Converter={StaticResource BoolToVis}}"
                                              ToolTip="数的是**整副牌组**（跨战斗那一副，不是战斗里的抽牌堆）里符合这个范围的牌有几张。&#10;范围能选攻击 / 技能 / 能力 / 诅咒 / 状态，也能选「自定义关键词」页加的关键词，以及「组」页建的组里的牌。"/>

                                    <TextBlock Text="增益 / 减益（选了「增益/减益（状态层数）」时用）" Style="{StaticResource Label}"
                                               Visibility="{Binding IsPower, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 和「本体状态改写」页同一个可搜索下拉（本体 200+ 个状态，不打字很难找） -->
                                    <local:SearchComboBox Margin="0,4,0,4"
                                                          Visibility="{Binding IsPower, Converter={StaticResource BoolToVis}}"
                                                          ItemsSource="{Binding PowerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id" SelectedValue="{Binding PowerId, Mode=TwoWay}"
                                                          SearchPath="Display"
                                                          ToolTip="可以打字搜索（比如输入「易伤」）；＋ = 增益，－ = 减益">
                                        <local:SearchComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                        </local:SearchComboBox.ItemTemplate>
                                    </local:SearchComboBox>

                                    <TextBlock Text="备注（只给你自己看，不参与生成）" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="这个参数等于什么" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="这个参数给多少能量 / 额外资源量" FontWeight="Bold" Margin="0,12,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,4"
                                               Text="默认那两个字母就出现在这里：X = 当前所有能量（下注多少 = 给多少就全部给出去）、Y = 当前所有额外资源量。想让别的参数按它的值给量，就在这里选它。"/>
                                    <TextBlock Text="给予能量（按这个参数的值）" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              ItemsSource="{Binding ParamGrantChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding EnergyGrant}"/>
                                    <TextBlock Text="给予额外资源量（按这个参数的值）" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              ItemsSource="{Binding ParamGrantChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding ResourceGrant}"/>

                                    <TextBlock Text="当前所有参数" FontWeight="Bold" Margin="0,12,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ParamSummaryRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1,0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ===== 下半部分：组 ===== -->
                    <GroupBox Grid.Row="2" Header="组（只影响在生成器里的查看与筛选，不写进模组代码）">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*" MinWidth="480"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="新建组" Padding="8,4" Margin="0,0,6,0" Click="OnAddCardGroup"/>
                                    <Button Content="删除" Padding="8,4" Click="OnRemoveCardGroup"/>
                                </WrapPanel>
                                <ListBox x:Name="GroupList" DisplayMemberPath="Display" ItemsSource="{Binding Profile.CardGroups}"/>
                            </DockPanel>

                            <TextBlock x:Name="GroupEmptyHint" Grid.Column="2" FontSize="14" Foreground="#999"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="还没有组。点「新建组」建一个，然后在上面「卡牌属性」标题右边（或本页右边）勾选哪些牌属于它。"
                                       Visibility="{Binding SelectedItem, ElementName=GroupList, Converter={StaticResource EmptyToVisibility}}"/>

                            <Border x:Name="GroupDetail" Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="10"
                                    DataContext="{Binding SelectedItem, ElementName=GroupList}"
                                    Visibility="{Binding SelectedItem, ElementName=GroupList, Converter={StaticResource NotEmptyToVisibility}}">
                                <!-- V0.2.256（用户报「右边没有看到有两块勾选列表，还是只有卡牌」）：
                                     以前状态那一块是**独立的 Border**，和卡牌那块摆在同一个单元格里靠 Bottom 对齐，
                                     窗口一矮就被裁在可视区外（用户只看到「有哪些牌」）。
                                     现在**并排两列**：左边「有哪些牌」、右边「有哪些状态」—— 一眼看到两块，
                                     窗口矮时两列一起变矮（各自带滚动条），不会有一块被裁掉。 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="组名（改名字不会让已经勾好的卡掉出去）" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="备注" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="180"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*" MinWidth="150"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*" MinWidth="150"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0">
                                            <TextBlock DockPanel.Dock="Top" Text="这个组里有哪些牌（勾选即加入 / 取消）"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <WrapPanel DockPanel.Dock="Top">
                                                <Button Content="全选" Padding="8,4" Margin="0,0,6,6" Click="OnGroupSelectAllCards"/>
                                                <Button Content="全不选" Padding="8,4" Margin="0,0,6,6" Click="OnGroupSelectNoCards"/>
                                            </WrapPanel>
                                            <ListBox x:Name="GroupCardList"
                                                     ItemsSource="{Binding GroupCardRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource Check}" Content="{Binding Display}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                        <DockPanel Grid.Column="2">
                                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                                       Text="这个组里有哪些状态（勾选即加入 —— 「清空指定状态」里可以选这个组，一次全清）"
                                                       Foreground="#0A5"/>
                                            <ListBox x:Name="GroupPowerList"
                                                     ItemsSource="{Binding GroupPowerRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource Check}" Content="{Binding Display}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>

                                        <!-- V0.2.265（用户要求「音频也能加入组」）：这一列才让音频能进组。
                                             播放音频那条效果勾了「仅能被下个同组音频顶替」时，就靠这里勾的同组关系判断。 -->
                                        <DockPanel Grid.Column="4">
                                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                                       Text="这个组里有哪些音频（勾选即加入 —— 「播放音频文件」勾了「仅能被下个同组音频顶替」时靠它判断同组）"
                                                       Foreground="#A50"/>
                                            <ListBox x:Name="GroupAudioList"
                                                     ItemsSource="{Binding GroupAudioRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource Check}" Content="{Binding Display}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ 锻造 ============ -->
            <TabItem x:Name="ForgeTab" Header="锻造">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <GroupBox DockPanel.Dock="Top" Header="要锻造哪一类">
                            <StackPanel>
                                <RadioButton x:Name="ForgeKindNone" GroupName="ForgeKind" Content="（不选）" Margin="0,3"
                                             IsChecked="True"
                                             ToolTip="不选任何一类时，右侧是空白的，只提示「请选择卡牌、药水、遗物、状态」"/>
                                <RadioButton x:Name="ForgeKindCard" GroupName="ForgeKind" Content="卡牌列表" Margin="0,3"/>
                                <RadioButton x:Name="ForgeKindPotion" GroupName="ForgeKind" Content="药水列表" Margin="0,3"/>
                                <RadioButton x:Name="ForgeKindRelic" GroupName="ForgeKind" Content="遗物列表" Margin="0,3"/>
                                <!-- V0.2.194（用户原话：「我要的不是模块，是锻造页左边『要锻造哪一类』里多一个『状态列表』，
                                     像卡牌列表 / 药水列表 / 遗物列表那样，用那块布给自定义状态编效果」）：
                                     这一档列的是「自定义状态」页那些状态，所以文案就叫「状态列表」而不是「自定义状态列表」
                                     —— 后者会和「自定义状态」页那个名字撞车，让人以为是在这儿新建状态。 -->
                                <RadioButton x:Name="ForgeKindPower" GroupName="ForgeKind" Content="状态列表" Margin="0,3"
                                             ToolTip="用右边那块布（节点图 / 积木）给**自定义状态**编触发时机和效果。列表里是在「自定义状态」页建好的那些状态。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="ForgeListBox" DockPanel.Dock="Top" Margin="0,8,0,0">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="添加" Padding="8,4" Margin="0,0,6,0" Click="OnAddForged"
                                            IsEnabled="{Binding ForgeAddEnabled}"/>
                                    <Button Content="删除" Padding="8,4" Click="OnRemoveForged"
                                            IsEnabled="{Binding ForgeAddEnabled}"/>
                                </WrapPanel>
                                <ListBox x:Name="ForgeItemList" DisplayMemberPath="Display"/>
                            </DockPanel>
                        </GroupBox>

                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                   Text="锻造页只管右边那块布：左边选一类 → 「添加」新建一项（名字带 *），右边那张「布」就是编辑器 —— 默认是节点图（触发时机为根，往右连对象 / 状态 / 数值 / 效果），右上角「视图」可以切成「积木（可拖）」。卡牌 / 药水 / 遗物这三档的条目在「卡牌 / 药水 / 遗物」页照常显示，选中它们时属性照样能改、只有效果栏锁死。「状态列表」那一档不一样：它列的是「自定义状态」页里那些状态（这一档不新建状态，名字也不带 *），选中一只就能在这块布上编它的触发时机 / 效果；原本在「自定义状态」页配过触发时机 / 效果的，点右上角「⤓ 把现在的触发时机 / 效果搬到这块布上」搬过来，搬完就由这块布说了算。"/>
                    </DockPanel>

                    <!-- 一类都没选：整块空白 + 提示 -->
                    <TextBlock x:Name="ForgeEmptyHint" Grid.Column="2" FontSize="18" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="请选择卡牌、药水、遗物、状态"
                               Visibility="{Binding ForgeNoKind, Converter={StaticResource BoolToVis}}"/>

                    <Grid x:Name="ForgeDetail" Grid.Column="2" Visibility="{Binding ForgeHasKind, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="ForgeNoSelectHint" FontSize="14" Foreground="#999"
                                   HorizontalAlignment="Center" Text="请先在左边选中一件物品（或者点「添加」新建一件）"/>

                        <Grid x:Name="ForgeDetailBody" Grid.Row="2" DataContext="{Binding SelectedItem, ElementName=ForgeItemList}">
                            <!-- 需求：中间那半（属性）去掉 —— 属性回「卡牌 / 药水 / 遗物」页改，
                                 锻造页只留左边列表 + 右边这张「布」，布因此能占满整宽。 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <!-- 第三行：两块布的差异说明（升级前 / 升级后） -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 需求：左上角用醒目字样显示分页「升级前」和「升级后」 -->
                                <!-- ⚠ 视图切换框要**先声明**（DockPanel 从右往左排）：后声明的会被前面的挤到没宽度，
                                     只剩「视图：」三个字、单选按钮被挤出窗口（实测踩过）。 -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Right" Background="#EAF3FF" BorderBrush="#7AA7D9" BorderThickness="1"
                                            CornerRadius="3" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="视图：" FontSize="11" VerticalAlignment="Center" Foreground="#456"/>
                                            <RadioButton x:Name="ForgeViewGraph" GroupName="ForgeViewMode" Content="节点图" FontSize="11"
                                                         Margin="4,0,0,0" IsChecked="True" Checked="OnForgeViewModeChanged"
                                                         ToolTip="原来那张布：自己摆位置、自己连线。"/>
                                            <RadioButton x:Name="ForgeViewBlocks" GroupName="ForgeViewMode" Content="积木（可拖）" FontSize="11"
                                                         Margin="8,0,0,0" Checked="OnForgeViewModeChanged"
                                                         ToolTip="类 Scratch 的堆叠块：按执行顺序从上往下排，缩进 = 在谁里面。可以拖块换位置、✚ 加块、✕ 删块，改完自动写回节点图。"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ForgeGraphTabsBox" DockPanel.Dock="Left" Background="#FFF3CD" BorderBrush="#E0B000" BorderThickness="1"
                                            CornerRadius="3" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TabControl x:Name="ForgeGraphTabs" BorderThickness="0" Background="Transparent"
                                                        SelectionChanged="OnForgeGraphTabChanged">
                                                <TabItem Header="升级前"/>
                                                <TabItem Header="升级后"/>
                                            </TabControl>
                                        </StackPanel>
                                    </Border>
                                    <!-- 「升级后」分页上的悬浮按钮：一键复制升级前那块布的内容 -->
                                    <Button DockPanel.Dock="Left" x:Name="ForgeCopyPrevButton" Margin="10,0,0,0"
                                            Padding="10,3" FontWeight="Bold" Foreground="#0A5"
                                            Content="⧉ 一键复制「升级前」的内容"
                                            Visibility="{Binding ForgeCopyVisible, Converter={StaticResource BoolToVis}}"
                                            Click="OnForgeCopyUpgraded"
                                            ToolTip="把「升级前」那块布上的模块与连线整份复制到「升级后」（长按框选、多选移动在下一阶段做）"/>
                                    <!-- V0.2.194：把「自定义状态」页那套触发时机 + 效果搬到这块布上。
                                         只在「状态列表」档、选中的状态还没图、又在「自定义状态」页配过东西时才出现
                                        （没配过的状态选中时已经自动给了一块空布，没有可搬的）。 -->
                                    <Button DockPanel.Dock="Left" x:Name="ForgeMigrateButton" Margin="10,0,0,0"
                                            Padding="10,3" FontWeight="Bold" Foreground="#B60"
                                            Content="⤓ 把现在的触发时机 / 效果搬到这块布上"
                                            Visibility="{Binding ForgeMigrateVisible, Converter={StaticResource BoolToVis}}"
                                            Click="OnForgeMigrateToGraph"
                                            ToolTip="把「自定义状态」页给这只状态配的触发时机 + 效果整份搬到这块布上。&#10;搬完这块布说了算：以后改触发时机 / 效果请在锻造页改（「自定义状态」页那几栏改了不生效）。&#10;搬不动的那几条（同一个钩子上有两条时机）会写进下面的日志里。"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,4,0" FontSize="11" Foreground="#888"
                                               Text="卡牌 / 药水 / 遗物的属性在「卡牌 / 药水 / 遗物」页改，「状态列表」里那些自定义状态的属性（名字 / 类型 / 图标 / 层数颜色）在「自定义状态」页改 —— 这一页只管右边那块布；右上角「视图」可切「积木（可拖）」（拖块换位置 / ✚ 加块 / ✕ 删块，改完自动写回节点图）。"
                                               TextWrapping="Wrap"/>
                                </DockPanel>

                                <!-- 「升级前 / 升级后」两块布的差异说明（看不出改了什么时看这一行） -->
                                <TextBlock Grid.Row="2" Margin="2,2,2,0" FontSize="11" Foreground="#0A7"
                                           TextWrapping="Wrap"
                                           Text="{Binding ForgeGraphTabHint, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                <Grid Grid.Row="1">
                                    <local:ForgeCanvasView x:Name="ForgeCanvas"
                                                           PowerSource="{Binding PowerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Visibility="{Binding ForgeGraphVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 积木编辑器：按执行顺序自动堆叠，缩进 = 在谁里面。可拖 / 可加 / 可删，改完写回节点图。 -->
                                    <local:ForgeBlockView x:Name="ForgeBlocks"
                                                          Visibility="{Binding ForgeBlocksVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 遗物 ============ -->
            <TabItem Header="遗物">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <!-- 用户要求（第 11 批 ①②）：「遗物页去除左上角关于额外资源量的内容」——
                             那块「额外资源量遗物（自动生成的隐藏起始遗物）」已经整块搬到
                             「额外资源量」页了（那里才是它该在的地方；这个页面只剩纯遗物列表）。 -->
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="添加遗物" Padding="8,4" Margin="0,0,6,0" Click="OnAddRelic"/>
                            <Button Content="删除" Padding="8,4" Click="OnRemoveRelic"/>
                            <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding MultiSelectRelics, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ToolTip="Ctrl / Shift 点选本来就能多选（Ctrl+A 全选）；打开这个开关后**直接点列表行**就能加选（不用按 Ctrl），右侧会出现「全选」"/>
                            <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllRelics"
                                    Visibility="{Binding MultiSelectRelics, Converter={StaticResource BoolToVis}}"
                                    ToolTip="选中列表里的全部遗物"/>
                            <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoRelic"
                                    IsEnabled="{Binding CanUndoRelic}" ToolTip="{Binding UndoRelicHint}"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,4"
                                   Text="最左边的数字 = 这只遗物**现在排第几位**（拖动换位置后跟着重排）。序号每次多留 5 个：不够 5 只时后面几行是**灰色空槽**（拖遗物过去就放到那个位置）；空槽不能被选中。自动生成的英文类名会跟着序号走，手填的不会被改。"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="RelicDragHint" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                   Text="拖动提示：按住某一行的文字往下/往上拖，会出现一条蓝线 —— 松手就插到那条线的位置。"/>
                        <!-- 用户要求：序号按「每块 5 个」预留显示 —— 行数 = 5 × ceil(max(N,1)/5)，
                             多出来的行是**空槽**（SlotPlaceholder，只显示灰色序号、没有内容）。
                             ItemsSource 绑的是 MainWindow.RelicRows 这个**界面镜像集合**
                             （真遗物 + 末尾空槽）；真遗物集合 Profile.Relics 仍是唯一事实来源。 -->
                        <ListBox x:Name="RelicList" SelectionMode="{Binding MultiSelectRelics, Converter={StaticResource MultiSelectMode}}"
                                 ItemsSource="{Binding RelicRows}"
                                 AllowDrop="True" PreviewMouseLeftButtonDown="OnRelicListPreviewMouseDown"
                                 PreviewMouseMove="OnRelicListPreviewMouseMove"
                                 DragOver="OnRelicListDragOver" Drop="OnRelicListDrop"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RelicRowRoot" ToolTip="{Binding RowTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RelicRowOrdinal" Grid.Column="0" Text="{Binding OrdinalText}" FontWeight="Bold"
                                                   Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="RelicRowName" Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 空槽行：只有灰色序号（遗物名那一列整块收起来）。判据是接口上的 IsPlaceholder，
                                         真遗物 = false、空槽 = true（见 SlotPlaceholder / IRelicSlotRow）。 -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter TargetName="RelicRowRoot" Property="ToolTip" Value="{x:Null}"/>
                                            <Setter TargetName="RelicRowOrdinal" Property="Foreground" Value="#AAAAAA"/>
                                            <Setter TargetName="RelicRowOrdinal" Property="FontWeight" Value="Normal"/>
                                            <Setter TargetName="RelicRowName" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock x:Name="RelicEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择遗物"
                               Visibility="{Binding HasRelicSelection, Converter={StaticResource BoolToCollapsed}}"/>

                    <!-- 额外资源量遗物里选中的那条效果：编辑区（和遗物详情同一格，靠选择互斥 + 代码里藏掉空提示） -->
                    <!-- 额外资源量遗物里选中的那条效果：编辑区（借遗物页右边那一格显示 ——
                         遗物列表没选中任何遗物时才出现，靠的是两个 Visibility 互斥）。
                         V0.2.127 起「额外资源量」页右侧有了**自己的**效果栏（用户要求「在右侧增加效果栏」），
                         所以这一块在正常操作下不会再出现（用户点那条效果时人在「额外资源量」页）；
                         留着它是为了不改动遗物页既有行为（V0.2.124 起就是这个形状）。 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedItem, ElementName=ExtraResourceEffectList}"
                                  Visibility="{Binding SelectedItem, ElementName=ExtraResourceEffectList, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="额外资源量遗物上的效果（触发时机固定「战斗开始时」）" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="6">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPlain}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ⚠ 显隐判据绑在**窗口**上（RelativeSource AncestorType=Window）：不能写裸
                         {Binding HasRelicSelection} —— RelicDetail 自己把 DataContext 换成了选中的那只遗物，
                         裸绑定会去找 RelicSpec.HasRelicSelection（不存在 → PathError → Visibility 停在默认值 Visible）。 -->
                    <Grid x:Name="RelicDetail" Grid.Column="2" DataContext="{Binding RelicUiSelection}"
                          Visibility="{Binding HasRelicSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="遗物属性" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock Text="名称（中文）" Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="英文类名（留空 = 自动生成 &lt;角色类名&gt;Relic&lt;序号&gt;）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock TextWrapping="Wrap" Margin="6,0,0,2" Foreground="#888" FontSize="11" Text="{Binding ClassNameHint}"/>
                            <TextBlock Text="稀有度" Style="{StaticResource Label}"/>
                            <!-- 稀有度英文改中文（用户要求第 3 条）：界面显示中文（初始/常见/罕见/稀有/先古/商店），
                                 存进存档的还是英文 id（RelicRarityOptions 一项 = Id + Display；生成端写的是本体 RelicRarity 枚举）。 -->
                            <ComboBox x:Name="RelicRarityCombo" Style="{StaticResource Pick}"
                                      ItemsSource="{Binding RelicRarityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Rarity}"/>
                            <CheckBox Content="作为初始遗物" Style="{StaticResource Check}" IsChecked="{Binding IsStartingRelic}"/>
                            <CheckBox Content="加入遗物池（宝箱/精英/商店）" Style="{StaticResource Check}" IsChecked="{Binding InRelicPool}"/>
                            <!-- V0.2.260（用户要求）：遗物专属的先古道具 ——「欧洛巴斯之触 TouchOfOrobas」
                                 会把角色的**初始遗物**换成强化版；本体只认它自己那张表（燃烧之血→黑血…），
                                 自定义角色的初始遗物不在表里 → 会给「头环 Circlet」。勾上之后生成一个 Harmony 前缀，
                                 只对本模组角色生效。 -->
                            <CheckBox Content="替换欧洛巴斯之触所替换的初始遗物"
                                      Style="{StaticResource Check}"
                                      IsChecked="{Binding OrobasReplace}"
                                      ToolTip="勾上 = 拿到「欧洛巴斯之触」时，它会把你的**初始遗物**换成这一只（走本体自带的 SetupForTests，只对本模组角色生效）。&#10;不勾 = 本体那张「初始遗物 → 强化遗物」表里没有我们的遗物，你拿到欧洛巴斯之触只会得到「头环 Circlet」。&#10;这个勾只能勾在一只遗物上（勾多了会报错）。"/>
                            <Button Content="上传遗物图标…（建议 256×256 PNG）" Padding="8,4" Margin="6,6,0,0" HorizontalAlignment="Left" Click="OnPickRelicIcon"/>
                            <Border BorderBrush="#DDD" BorderThickness="1" Height="130" Width="130" HorizontalAlignment="Left" Margin="6,4,0,0" Background="#FAFAFA">
                                <Image Source="{Binding RelicIconPreview, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" Margin="6,8,0,0"
                                       Text="提示：本体的遗物都靠「稀有度 + 触发时机 + 效果」组成；初始遗物请把稀有度设为「初始」，并勾选「作为初始遗物」。"/>

                            <!-- ========== 触发时机列表 + 关系开关（V0.2.126：遗物 = 一份效果 + 一组触发时机）==========
                                 触发时机**只描述「什么时候触发」**（种类 / 盯哪个状态 / 数值 / 统计范围 / 只对哪类牌生效）；
                                 触发后做什么 = 右边效果栏那**一份共享效果**。
                                 关系开关（用户要求）：满足其中一个就触发（默认）/ 全部满足才触发；
                                 后者才有「重置范围」（本回合 / 本场战斗）。 -->
                            <TextBlock Text="触发时机列表（只决定「什么时候触发」，效果在右边那栏）" FontWeight="Bold" Margin="0,12,0,4" TextWrapping="Wrap"/>
                            <ListBox x:Name="RelicTriggerList" MinHeight="110" MaxHeight="150"
                                     SelectionMode="{Binding MultiSelectRelics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                     ItemsSource="{Binding Triggers}" DisplayMemberPath="Summary"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnRelicTriggerSelectionChanged"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="添加触发时机" Padding="8,4" Margin="0,0,6,0" Click="OnAddRelicTrigger"/>
                                <Button Content="删除触发时机" Padding="8,4" Click="OnRemoveRelicTrigger"/>
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                       Text="例：「每回合开始时」+「打出一张牌后」两条可以同时挂着：任意一条成立就跑一次效果，或者让两条都成立才跑（见下面的关系）。"/>
                            <!-- 关系开关（用户要求：整只遗物一个开关）-->
                            <TextBlock Text="触发时机之间的关系" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <RadioButton x:Name="RelicTriggerModeAny" GroupName="RelicTriggerMode" Content="满足其中一个就触发（默认）"
                                         Margin="0,2,0,0" IsChecked="{Binding TriggerModeIsAny}"
                                         ToolTip="任意一条触发时机成立 → 就跑一次遗物的效果（每条时机互相独立）。"/>
                            <RadioButton x:Name="RelicTriggerModeAll" GroupName="RelicTriggerMode" Content="全部满足才触发"
                                         Margin="0,2,0,0" IsChecked="{Binding TriggerModeIsAll}"
                                         ToolTip="所有触发时机都成立过 → 才跑一次遗物的效果（效果跑完重新凑；凑不齐就永远不跑）。"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="6,2,0,0"
                                       Text="{Binding TriggerModeHint}"/>
                            <!-- 「重置范围」：只在「全部满足才触发」时显示（用户要求）-->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding ShowAndScope, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="重置范围" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RelicAndScopeCombo" Width="130" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                          ItemsSource="{Binding TriggerScopes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                          SelectedValue="{Binding AndScope}"
                                          ToolTip="本回合 = 每个回合重新凑一次（默认）；本场战斗 = 整场战斗里凑齐一次就够。"/>
                            </StackPanel>
                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,6,0,0"
                                    DataContext="{Binding SelectedItem, ElementName=RelicTriggerList}">
                                <StackPanel>
                                    <TextBlock Text="选中的这条触发时机（它只管「什么时候触发」）" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="触发时机" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource Pick}"
                                              ItemsSource="{Binding RelicTriggers, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Kind}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="6,2,0,0"
                                               Text="{Binding Hint}"/>
                                    <!-- 「只对哪类牌生效」（第 9 批 ④：遗物侧和状态侧同步）：只在「打出一张牌后」显示 -->
                                    <StackPanel Visibility="{Binding ShowCardFilterField, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="只对哪类牌生效" Style="{StaticResource Label}"/>
                                        <ComboBox Style="{StaticResource Pick}"
                                                  ItemsSource="{Binding CardFilterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                                  SelectedValue="{Binding CardFilter}"
                                                  ToolTip="任意 / 攻击 / 技能 / 能力 / 诅咒 / 状态，以及你自己配的「自定义关键词」与「组」那一组牌（和状态页同一份候选）。&#10;只有「打出一张牌后」用得到。"/>
                                    </StackPanel>
                                    <!-- 「某个状态层数到达 N 层 / 变化 / 被移除」：盯哪个状态 -->
                                    <StackPanel Visibility="{Binding ShowPowerFields, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="盯哪个状态（留空 = 任意状态）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <local:SearchComboBox SearchPath="Display"
                                                              ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Id" SelectedValue="{Binding PowerId, Mode=TwoWay}"
                                                              ToolTip="只盯自己身上这个状态；留空 = 任何状态都算。直接打字搜索。">
                                            <local:SearchComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                            </local:SearchComboBox.ItemTemplate>
                                        </local:SearchComboBox>
                                        <!-- V0.2.266（用户要求）：层数变化细分「上升 / 下降」—— 只在「某个状态层数变化后」显示 -->
                                        <StackPanel Visibility="{Binding ShowPowerDirectionField, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="层数变化方向" Style="{StaticResource Label}"/>
                                            <ComboBox Style="{StaticResource Pick}"
                                                      ItemsSource="{Binding TriggerDirections, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                                      SelectedValue="{Binding PowerDirection}"
                                                      ToolTip="只在「某个状态层数变化后」有用：&#10;· 上升 / 下降都算（默认，老行为）；&#10;· 只在**上升**时触发（加到层数才触发，掉层不触发）；&#10;· 只在**下降**时触发（掉层才触发，加层不触发）。"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 触发时机上的数值（按时机换含义：每 N 次 / 每 N 点 / 数值 ≥ N / 到达 N 层） -->
                                    <StackPanel Visibility="{Binding ShowAmountField, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Visibility="{Binding ShowScopeField, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="统计范围" Style="{StaticResource Label}"/>
                                            <ComboBox Style="{StaticResource Pick}"
                                                      ItemsSource="{Binding TriggerScopes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Scope}"
                                                      ToolTip="本回合 = 每个回合重新计数；本场战斗 = 整场战斗累计（换战斗重新算）。"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="6,2,0,0"
                                                   Text="{Binding SpendHint}"/>
                                    </StackPanel>
                                    <!-- V0.2.126：「要和其他时机同时成立」的每时机勾选框已经删掉 ——
                                         关系现在是**整只遗物一个开关**（在上面「触发时机之间的关系」），
                                         这条时机的编辑器里不再有「效果」和「重置范围」。 -->
                                </StackPanel>
                            </Border>

                            <!-- 遗物自定义描述（用户要求：遗物也能自己写描述）；「填入参数」列出可用的 {变量} -->
                            <GroupBox Header="自定义描述（留空 = 用上面效果自动生成的那段）" Margin="0,10,0,0">
                                <StackPanel Margin="4">
                                    <TextBox x:Name="RelicCustomDesc" Style="{StaticResource Field}" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding CustomDescription, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="可以写风味文字，也可以写本体占位符：{Damage} 显示当前数值、{Damage:diff()} 显示升级后的值（遗物不可升级，一般用 {Damage} 就行）。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="填入参数…" Padding="8,4" Click="OnInsertParam" Tag="{Binding ElementName=RelicCustomDesc}"
                                                ToolTip="列出这只遗物里能用的数值占位符，点一下插到光标处。"/>
                                        <CheckBox Margin="10,0,0,0" Style="{StaticResource Check}" Content="替换掉自动生成的描述（不勾 = 追加在后面）"
                                                  IsChecked="{Binding CustomDescriptionReplaces}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- 条件选项：整只遗物的触发条件（不满足时整个遗物不触发）；
                                 每条效果自己的条件在**右边效果栏底下**那一块。 -->
                            <GroupBox x:Name="RelicConditionBox" Header="条件选项（整只遗物：不满足时不触发）" Margin="0,10,0,0">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <!-- V0.2.288：条件「指定敌人的意图为（）」那一行 -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="条件" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Pick}"
                                              ItemsSource="{Binding RelicConditions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                              SelectedValue="{Binding Condition.Kind}"/>

                                    <!-- V0.2.288（用户要求「条件增加『指定敌人的意图为（）』」）：意图下拉，
                                         参考本体故障机器人的「眼部攻击」（它只判「是否攻击」，这里按 IntentType 判任意意图） -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="意图" Style="{StaticResource Label}"
                                               Visibility="{Binding Condition.NeedsIntent, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Pick}"
                                              ItemsSource="{Binding IntentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                              Visibility="{Binding Condition.NeedsIntent, Converter={StaticResource BoolToVis}}"
                                              SelectedValue="{Binding Condition.Intent}"
                                              ToolTip="看目标敌人「下一次行动」的意图。目标取可打的第一个敌人。"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="数值 N" Style="{StaticResource Label}"
                                               Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 数值 N + 生命区间的第二个数值 M：放进会自动换行的面板里，
                                         面板窄的时候也不会互相压住 / 跑到可视区外面
                                         （遗物这只以前只有 N，选了「生命值在 N%~M% 之间」根本没地方填 M） -->
                                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Width="70" Style="{StaticResource Field}"
                                                 Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"
                                                 Text="{Binding Condition.Amount, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="填负数 = 判断反过来（例：生命值低于 -20 → 高于 20%；至少 -2 层 → 少于 2 层）。"/>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="~ 数值 M（%）" Style="{StaticResource Label}"
                                                   Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Width="70" Margin="4,0,0,0" Style="{StaticResource Field}"
                                                 Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"
                                                 Text="{Binding Condition.Amount2, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="生命区间的上界（%）。任意一个数值填负数 = 判断成「区间外」。"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="状态（增益 / 减益）" Style="{StaticResource Label}"
                                               Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"/>
                                    <local:SearchComboBox Grid.Row="1" Grid.Column="3" Margin="4,0,0,0"
                                             Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"
                                             ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                                             SelectedValuePath="Id" SelectedValue="{Binding Condition.PowerId, Mode=TwoWay}"
                                             SearchPath="Display">
                                        <local:SearchComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                        </local:SearchComboBox.ItemTemplate>
                                    </local:SearchComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="指向对象" Style="{StaticResource Label}"
                                               Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                                              Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"
                                              ItemsSource="{Binding ConditionTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                              SelectedValue="{Binding Condition.Target}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                        </ScrollViewer>
                        <!-- ============ 右侧 = 效果栏（用户要求第 5 条）============
                             V0.2.144（用户原话「遗物药水右侧的效果栏能不能同步卡牌的」）：照卡牌页版式 ——
                             上面**一行摘要列表**（140px），下面**一整块共享编辑区**（绑列表里选中的那条效果；
                             编辑器 = EffectEditorPlain，里面含这条效果自己的「条件选项」）。
                             以前的「折叠行（点开才展开）」和右下角那块独立条件框都撤掉了。
                             最底：添加效果 / 删除效果 / 撤回删除 -->
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=RelicEffectList}"/>
                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=RelicEffectList}"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoRelic"
                                        IsEnabled="{Binding CanUndoRelic}" ToolTip="{Binding UndoRelicHint}"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="效果栏：这只遗物的效果（触发时机满足后跑的就是这一份）" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <!-- 遗物效果列表（V0.2.126）：绑的是**整只遗物那一份**效果（RelicSpec.Effects）——
                                     触发时机只管「什么时候触发」，所以换选中哪条时机都不换绑。
                                     V0.2.144 起每行只显示一行摘要（EffectSpec.DisplayPlain —— 遗物不能升级，
                                     列表里不显示「（升级 +N）」那种括号），点一条 → 下面那块共享编辑区改它。
                                     ⚠ 以前每一行自己塞一整块编辑器（V0.2.122~137），要靠
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 压住那个 8260px 的老坑；
                                     现在行里只有一行摘要、编辑器在下面那块共享区里，这个坑从结构上没有了 ——
                                     但「Disabled + Stretch + 摘要换行」这套还是留着：长摘要要在列表宽度里换行，
                                     不许横向跑出面板（V0.2.124 那条红线，自检里有断言）。 -->
                                <ListBox x:Name="RelicEffectList" Grid.Row="1"
                                         SelectionMode="{Binding MultiSelectRelics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         ItemsSource="{Binding Effects}"
                                         DisplayMemberPath="DisplayPlain"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch"
                                         ToolTip="这只遗物的效果（触发时机满足后跑的就是这一份）。点一条 → 下面那块编辑区里改它（含这一条自己的条件）。">
                                    <ListBox.Resources>
                                        <!-- DisplayMemberPath 生成的那个 TextBlock 没有显式 Style，所以这条隐式样式管得到它
                                             （长摘要就会在列表宽度里自动换行，而不是撑出一条横向滚动条）。 -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>
                                <TextBlock Grid.Row="3" Margin="10,4" Foreground="#999" FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="点上面一条效果 → 就在这块里改它（含这一条效果自己的「条件选项」）"
                                           Visibility="{Binding SelectedItem, ElementName=RelicEffectList, Converter={StaticResource EmptyToVisibility}}"/>
                                <Border Grid.Row="3" x:Name="RelicEffectEditorBox" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                        DataContext="{Binding SelectedItem, ElementName=RelicEffectList}">
                                    <!-- ⚠ 没选中任何效果时把内容收起来（NotEmptyToVisibility）：ContentTemplate 遇上
                                         Content=null 也会把模板实例化出来，那些 Visibility 绑定解不出来就停在默认值
                                         （Visible）→ 界面上会凭空冒出几行开关（自检抓过「遗物页看见了概率独立」）。 -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPlain}"
                                                    Visibility="{Binding SelectedItem, ElementName=RelicEffectList, Converter={StaticResource NotEmptyToVisibility}}"/>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 药水 ============ -->
            <TabItem Header="药水">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="添加药水" Padding="8,4" Margin="0,0,6,0" Click="OnAddPotion"/>
                            <Button Content="删除" Padding="8,4" Click="OnRemovePotion"/>
                            <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding MultiSelectPotions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ToolTip="Ctrl / Shift 点选本来就能多选（Ctrl+A 全选）；打开这个开关后**直接点列表行**就能加选（不用按 Ctrl），右侧会出现「全选」"/>
                            <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllPotions"
                                    Visibility="{Binding MultiSelectPotions, Converter={StaticResource BoolToVis}}"
                                    ToolTip="选中列表里的全部药水"/>
                            <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoPotion"
                                    IsEnabled="{Binding CanUndoPotion}" ToolTip="{Binding UndoPotionHint}"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,4"
                                   Text="最左边的数字 = 这瓶药水**现在排第几位**（拖动换位置后跟着重排）。序号每次多留 5 个：不够 5 瓶时后面几行是**灰色空槽**（拖药水过去就放到那个位置）；空槽不能被选中。自动生成的英文类名会跟着序号走，手填的不会被改。"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="PotionDragHint" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                   Text="拖动提示：按住某一行的文字往下/往上拖，会出现一条蓝线 —— 松手就插到那条线的位置。"/>
                        <!-- 用户要求第 6 条「药水方面参考遗物的优化方案」：序号按「每块 5 个」预留显示 ——
                             行数 = 5 × ceil(max(N,1)/5)，多出来的行是**空槽**（SlotPlaceholder，只显示灰色序号、没有内容）。
                             ItemsSource 绑的是 MainWindow.PotionRows 这个**界面镜像集合**
                             （真药水 + 末尾空槽）；真药水集合 Profile.Potions 仍是唯一事实来源。 -->
                        <ListBox x:Name="PotionList" SelectionMode="{Binding MultiSelectPotions, Converter={StaticResource MultiSelectMode}}"
                                 ItemsSource="{Binding PotionRows}"
                                 AllowDrop="True" PreviewMouseLeftButtonDown="OnPotionListPreviewMouseDown"
                                 PreviewMouseMove="OnPotionListPreviewMouseMove"
                                 DragOver="OnPotionListDragOver" Drop="OnPotionListDrop"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="PotionRowRoot" ToolTip="{Binding RowTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PotionRowOrdinal" Grid.Column="0" Text="{Binding OrdinalText}" FontWeight="Bold"
                                                   Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="PotionRowName" Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 空槽行：只有灰色序号（名字那一列整块收起来）。判据是接口上的 IsPlaceholder，
                                         真药水 = false、空槽 = true（见 SlotPlaceholder / ISlotRow）。 -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter TargetName="PotionRowRoot" Property="ToolTip" Value="{x:Null}"/>
                                            <Setter TargetName="PotionRowOrdinal" Property="Foreground" Value="#AAAAAA"/>
                                            <Setter TargetName="PotionRowOrdinal" Property="FontWeight" Value="Normal"/>
                                            <Setter TargetName="PotionRowName" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock x:Name="PotionEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择药水"
                               Visibility="{Binding HasPotionSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCollapsed}}"/>

                    <!-- ⚠ 显隐判据绑在**窗口**上（RelativeSource AncestorType=Window）：不能写裸
                         {Binding HasPotionSelection} —— PotionDetail 自己把 DataContext 换成了选中的那瓶药水，
                         裸绑定会去找 PotionSpec.HasPotionSelection（不存在 → PathError → Visibility 停在默认值 Visible）。
                         详情的数据上下文是 PotionUiSelection（点中空槽行时它保持上一瓶，右侧不闪）。 -->
                    <Grid x:Name="PotionDetail" Grid.Column="2" DataContext="{Binding PotionUiSelection}"
                          Visibility="{Binding HasPotionSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="药水属性" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock Text="名称（中文）" Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="英文类名（留空 = 自动生成 &lt;角色类名&gt;Potion&lt;序号&gt;）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock TextWrapping="Wrap" Margin="6,0,0,2" Foreground="#888" FontSize="11" Text="{Binding ClassNameHint}"/>
                            <TextBlock Text="稀有度" Style="{StaticResource Label}"/>
                            <!-- 稀有度英文改中文（用户要求第 6 条：药水照抄遗物页）：
                                 界面显示中文（常见/罕见/稀有），存进存档的还是英文 id
                                 （PotionRarityOptions 一项 = Id + Display；生成端写的是本体 PotionRarity 枚举）。 -->
                            <ComboBox x:Name="PotionRarityCombo" Style="{StaticResource Pick}"
                                      ItemsSource="{Binding PotionRarityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Rarity}"/>
                            <TextBlock Text="使用时机" Style="{StaticResource Label}"/>
                            <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding PotionUsages, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Usage}"/>
                            <TextBlock Text="作用目标" Style="{StaticResource Label}"/>
                            <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding PotionTargets, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding TargetType}"/>
                            <CheckBox Content="加入药水池" Style="{StaticResource Check}" IsChecked="{Binding InPotionPool}"/>
                            <Button Content="上传药水图标…（建议 256×256 PNG，物品栏与弹窗都用它）" Padding="8,4" Margin="6,6,0,0"
                                    HorizontalAlignment="Left" Click="OnPickPotionIcon"/>
                            <Border BorderBrush="#DDD" BorderThickness="1" Height="130" Width="130" HorizontalAlignment="Left" Margin="6,4,0,0" Background="#FAFAFA">
                                <Image Source="{Binding PotionIconPreview, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform"/>
                            </Border>
                            <!-- V0.2.199：缩略图很容易看串（用户实测报过「上传的图标怎么在每一个药水都会显示」——
                                 真凶是换选中项时预览没刷新）。这里把当前这瓶的文件名直接写出来，换一瓶就跟着变。 -->
                            <TextBlock TextWrapping="Wrap" Margin="6,4,0,0" Foreground="#1F6FB2" FontSize="11"
                                       Text="{Binding PotionIconHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" Margin="6,8,0,0"
                                       Text="提示：选「任意时机」时不要用造成伤害/抽牌/挂减益这类需要战斗的效果，生成时会被忽略。&#10;药水实际打谁由上面的「作用目标」决定，卡面描述会按它生成（效果里的「作用对象」对药水不起作用）。"/>
                        </StackPanel>
                        </ScrollViewer>
                        <!-- ============ 右 = 效果栏 + 自定义描述（用户要求第 6 条「药水方面参考遗物的优化方案」）============
                             V0.2.144（用户原话「遗物药水右侧的效果栏能不能同步卡牌的」）：和遗物页一样改成
                             卡牌页那种版式 —— 上面**一行摘要列表**（140px），下面**一整块共享编辑区**
                             （绑列表里选中的那条效果；编辑器 = EffectEditorPotion，药水的说明文字一个字都没少）。
                             单条效果自己的「条件」跟着那条效果长在编辑区里（以前是右下角单独一块，已撤）。
                             最底：添加效果 / 删除效果 / 撤回删除
                             之后：药水自定义描述（保留原样） -->
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=PotionEffectList}"/>
                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=PotionEffectList}"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoPotion"
                                        IsEnabled="{Binding CanUndoPotion}" ToolTip="{Binding UndoPotionHint}"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="效果栏：这瓶药水的效果" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <!-- 一行摘要列表（和卡牌页 / 遗物页同一套写法）：每行就是 EffectSpec.DisplayPlain
                                     （药水不能升级，列表里不显示「（升级 +N）」那种括号）。
                                     选中一条 → 下面那块共享编辑区立刻就是它（含它自己的「条件选项」）。
                                     ⚠ 以前每一行自己塞一整块编辑器（V0.2.122~137），要靠
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 压住那个 8260px 的老坑；
                                     现在行里只有一行摘要、编辑器在下面那块共享区里，这个坑从结构上没有了 ——
                                     但「Disabled + Stretch + 摘要换行」这套还是留着：长摘要要在列表宽度里换行，
                                     不许横向跑出面板（V0.2.124 那条红线，自检里有断言）。 -->
                                <ListBox x:Name="PotionEffectList" Grid.Row="1"
                                         SelectionMode="{Binding MultiSelectPotions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         ItemsSource="{Binding Effects}" DisplayMemberPath="DisplayPlain"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch"
                                         ToolTip="这瓶药水的效果。点一条 → 下面那块编辑区里改它（含这一条自己的条件）。">
                                    <ListBox.Resources>
                                        <!-- DisplayMemberPath 生成的那个 TextBlock 没有显式 Style，所以这条隐式样式管得到它
                                             （长摘要就会在列表宽度里自动换行，而不是撑出一条横向滚动条）。 -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>
                                <TextBlock Grid.Row="3" Margin="10,4" Foreground="#999" FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="点上面一条效果 → 就在这块里改它（含这一条效果自己的「条件选项」）"
                                           Visibility="{Binding SelectedItem, ElementName=PotionEffectList, Converter={StaticResource EmptyToVisibility}}"/>
                                <Border Grid.Row="3" x:Name="PotionEffectEditorBox" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                        DataContext="{Binding SelectedItem, ElementName=PotionEffectList}">
                                    <!-- ⚠ 没选中任何效果时把内容收起来（见遗物页那一处同样的说明）。 -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPotion}"
                                                    Visibility="{Binding SelectedItem, ElementName=PotionEffectList, Converter={StaticResource NotEmptyToVisibility}}"/>
                                </Border>
                                <!-- 药水自定义描述（用户要求：药水也能自己写描述） -->
                                <GroupBox Grid.Row="4" Header="自定义描述（留空 = 用上面效果自动生成的那段）" Margin="0,8,0,0">
                                    <StackPanel Margin="4">
                                        <TextBox x:Name="PotionCustomDesc" Style="{StaticResource Field}" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding CustomDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="可以写风味文字，也可以写本体占位符：{Damage} 显示当前数值。"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="填入参数…" Padding="8,4" Click="OnInsertParam" Tag="{Binding ElementName=PotionCustomDesc}"
                                                    ToolTip="列出这瓶药水里能用的数值占位符，点一下插到光标处。"/>
                                            <CheckBox Margin="10,0,0,0" Style="{StaticResource Check}" Content="替换掉自动生成的描述（不勾 = 追加在后面）"
                                                      IsChecked="{Binding CustomDescriptionReplaces}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 诅咒 / 先古 / 状态 ============ -->
            <TabItem x:Name="CurseTab" Header="诅咒 / 先古 / 状态">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：三个列表（诅咒 / 先古卡 / 状态卡）。它们和普通卡用同一套 CardSpec，
                         所以效果编辑器 / 卡面 / 自定义描述全都照旧，只是分开放、详情面板各行不同。
                         状态卡**就是** Profile.Cards 里稀有度为「状态」的那些（用户要求并入这一页）。 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="8"/>
                            <RowDefinition Height="*"/><RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="自定义诅咒（不能被打出，在你的回合结束时若在手牌里触发）">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="添加诅咒" Padding="8,4" Margin="0,0,6,0" Click="OnAddCurse"/>
                                    <Button Content="删除" Padding="8,4" Margin="0,0,6,0" Click="OnRemoveCurse"/>
                                    <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllCurses"
                                            Visibility="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCurse"
                                            IsEnabled="{Binding CanUndoCurse}" ToolTip="{Binding UndoCurseHint}"/>
                                </WrapPanel>
                                <!-- 诅咒的卡框颜色：跟角色配色 或 本体的框色名（**没有自定义颜色**：用户要求去掉） -->
                                <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="诅咒卡框" Style="{StaticResource Label}" MinWidth="72"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                              ItemsSource="{Binding CurseFrameItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding CurseFrameSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="诅咒这一类的卡牌边框颜色：默认跟角色配色，也可以直接选本体的框色（诅咒不支持自定义颜色 —— 本体的诅咒外观是固定的灰色卡池，染色没有意义）。"/>
                                    <Border Grid.Column="2" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding Profile.CurseStyle.PreviewHex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"
                                            ToolTip="当前卡框颜色的色块"/>
                                </Grid>
                                <!-- V0.2.140：诅咒那一栏也照遗物 / 药水页那套 —— 每 5 个一块、空槽带灰色序号。
                                     ItemsSource 绑 MainWindow.CurseRows（真诅咒 + 末尾空槽行），
                                     真集合 Profile.Curses 仍是唯一事实来源；空槽可当拖放落点、选不中、不进全选。 -->
                                <ListBox x:Name="CurseList" ItemsSource="{Binding CurseRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         SelectionChanged="OnSpecialCardSelectionChanged"
                                         AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch"
                                         ToolTip="诅咒：打不出去，留在手牌里就会在回合结束时坑你。本体的「受伤 / 疑虑 / 苦恼 / 厄运」就是这一类。">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="CurseRowRoot" ToolTip="{Binding RowTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CurseRowOrdinal" Grid.Column="0" Text="{Binding OrdinalText}" FontWeight="Bold"
                                                           Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="CurseRowName" Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter TargetName="CurseRowRoot" Property="ToolTip" Value="{x:Null}"/>
                                                    <Setter TargetName="CurseRowOrdinal" Property="Foreground" Value="#AAAAAA"/>
                                                    <Setter TargetName="CurseRowOrdinal" Property="FontWeight" Value="Normal"/>
                                                    <Setter TargetName="CurseRowName" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="自定义先古卡（稀有度为「先古」，不进普通奖励）">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="添加先古卡" Padding="8,4" Margin="0,0,6,0" Click="OnAddAncientCard"/>
                                    <Button Content="删除" Padding="8,4" Margin="0,0,6,0" Click="OnRemoveAncientCard"/>
                                    <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllAncientCards"
                                            Visibility="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoAncientCard"
                                            IsEnabled="{Binding CanUndoAncient}" ToolTip="{Binding UndoAncientHint}"/>
                                </WrapPanel>
                                <!-- 先古卡的卡框颜色（RRGGBB）——和诅咒那一栏同一套机制 -->
                                <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="先古卡框" Style="{StaticResource Label}" MinWidth="72"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                              ItemsSource="{Binding SpecialFrameItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding AncientFrameSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="先古卡这一类的卡牌边框颜色：默认跟角色配色；也可以选本体的框色，或者选「自定义」后用下面的 RRGGBB。"/>
                                    <Border Grid.Column="2" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding Profile.AncientStyle.PreviewHex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"
                                            ToolTip="当前卡框颜色的色块"/>
                                </Grid>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,2,0,0">
                                    <TextBlock Text="自定义颜色（RRGGBB）" Style="{StaticResource Label}" MinWidth="140"/>
                                    <TextBox Style="{StaticResource Field}"
                                             IsEnabled="True"
                                             Text="{Binding Profile.AncientStyle.FrameColor, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="填 6 位十六进制（例如 E0B24C）。生成时会按它算 HSV 写一份卡框材质，只有先古卡用这个框色。"/>
                                </DockPanel>
                                <!-- V0.2.140：先古卡那一栏同理（每 5 个一块 + 空槽灰色序号，CurseRows 的兄弟 AncientRows） -->
                                <ListBox x:Name="AncientCardList" ItemsSource="{Binding AncientRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         SelectionChanged="OnSpecialCardSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch"
                                         ToolTip="先古卡 = 本体稀有度 Ancient 的强力牌（本体「丰饶 / 神化 / 幽灵形态」那种）。它们不会出现在战斗奖励里：拿到它们靠先古之民给的遗物（本体「尘封的书」会从你的卡池里随机挑一张先古卡），或者你自己的效果（「生成卡牌 / 获得卡牌（全局）」里选它）。">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="AncientRowRoot" ToolTip="{Binding RowTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AncientRowOrdinal" Grid.Column="0" Text="{Binding OrdinalText}" FontWeight="Bold"
                                                           Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="AncientRowName" Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter TargetName="AncientRowRoot" Property="ToolTip" Value="{x:Null}"/>
                                                    <Setter TargetName="AncientRowOrdinal" Property="Foreground" Value="#AAAAAA"/>
                                                    <Setter TargetName="AncientRowOrdinal" Property="FontWeight" Value="Normal"/>
                                                    <Setter TargetName="AncientRowName" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="4" Header="自定义状态卡（稀有度为「状态」，不进奖励、默认不能升级）">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button Content="添加状态卡" Padding="8,4" Margin="0,0,6,0" Click="OnAddStatusCard"/>
                                    <Button Content="删除" Padding="8,4" Margin="0,0,6,0" Click="OnRemoveStatusCard"/>
                                    <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllStatusCards"
                                            Visibility="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoStatusCard"
                                            IsEnabled="{Binding CanUndoStatus}" ToolTip="{Binding UndoStatusHint}"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#888"
                                           Text="这一栏就是「卡牌」页里稀有度选了「状态」的那些牌（同一份数据，两边改都一样）。"/>
                                <ListBox x:Name="StatusCardList"
                                         ItemsSource="{Binding StatusCards, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Display"
                                         SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         SelectionChanged="OnSpecialCardSelectionChanged"
                                         ToolTip="状态卡 = 本体「伤口 / 灼伤 / 眩晕 / 粘液」那种：稀有度「状态」，不能升级、不进战斗奖励，也不能从奖励里抽到。费用可调（本体的状态牌费用都是 0~1）。"/>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <!-- 两张详情面板都没选中时：一句提示 -->
                    <TextBlock x:Name="SpecialCardEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择诅咒 / 先古卡 / 状态卡"
                               Visibility="{Binding ShowSpecialCardHint, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== 诅咒详情 =====
                         ⚠ V0.2.140：数据上下文 / 显隐都改走窗口上的 CurseUiSelection / HasCurseSelection
                         —— 诅咒列表里现在有空槽行，绑 SelectedItem 的话点一下空槽右侧就会收起来
                         （照遗物页 V0.2.125 / 药水页 V0.2.127 的写法）。 -->
                    <Grid x:Name="CurseDetail" Grid.Column="2" DataContext="{Binding CurseUiSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding HasCurseSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="诅咒属性" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A5A00" FontSize="11"
                                               Text="类型 / 稀有度固定 Curse，效果写在右边 —— 触发时机是「在你的回合结束时，如果这张牌还在你的手牌中」（本体受伤 / 疑虑 / 苦恼 / 厄运都是这么做的）。费用默认 -1 = 打不出去（生成时自动加上本体的「不能被打出」）；填 ≥ 0 = 这张牌**能打出去**，这时不再强制「不能被打出」—— 但效果仍然在回合结束时触发，所以打出去本身不做事（只是能把它从手里丢掉）。"/>
                                </Border>
                                <TextBlock Text="名称（中文，列表里显示用）" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="英文类名（留空 = 自动编号 &lt;角色类名&gt;Curse&lt;诅咒列表第几位&gt;）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock TextWrapping="Wrap" Margin="6,0,0,2" Foreground="#888" FontSize="11" Text="{Binding ClassNameHint}"/>
                                <TextBlock Text="费用（-1 = 打不出去；≥ 0 = 能打出去）" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="本体所有诅咒的费用都是 -1（打不出去）。你想做一张「能打出去的诅咒」（例如 0 费把它自己从手里丢掉）就填 0 或正数 —— 生成时不再强制「不能被打出」。"/>
                                <CheckBox Margin="6,4,0,0" Style="{StaticResource Check}"
                                          Content="不能被打出（费用 -1 时自动加上；费用 ≥ 0 时由你决定）"
                                          IsChecked="{Binding Unplayable}"
                                          ToolTip="本体的诅咒全都带这个关键字。费用填 ≥ 0 后若还想让它打不出去，就勾上这里。"/>
                                <TextBlock Text="卡牌关键字（「不能被打出」是诅咒自带的）" Style="{StaticResource Label}" FontWeight="Bold" Margin="6,10,6,0"/>
                                <WrapPanel Margin="6,0,0,0">
                                    <CheckBox Content="固有（开局必在手牌）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Innate}"
                                              ToolTip="本体诅咒「苦恼 Writhe」就是 固有 + 不能被打出：开局就在手里卡着你。"/>
                                    <CheckBox Content="永恒（无法从牌组移除或变化）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Eternal}"
                                              ToolTip="本体诅咒「厄运 BadLuck」= 永恒 + 不能被打出：商店 / 事件都删不掉它。"/>
                                </WrapPanel>
                                <CheckBox Margin="6,6,0,0" Style="{StaticResource Check}"
                                          Content="战斗结束时，如果它还在牌组里就消失（本体「罪恶 Guilty」那套）"
                                          IsChecked="{Binding CurseRemoveAfterCombat}"
                                          ToolTip="不勾 = 一直留在牌组里（需要玩家自己想办法删掉）。勾上 = 每打一场战斗它就少一点存在感，最后自己消失 —— 本体「罪恶」是挂满 5 场战斗后自动删除。"/>
                                <Button Content="{Binding CardPortraitUploadHint, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,4" Margin="6,6,0,0" HorizontalAlignment="Left" Click="OnPickSpecialCardPortrait"/>
                                <Border BorderBrush="#DDD" BorderThickness="1" Height="190" Margin="6,4,0,0" Background="#FAFAFA">
                                    <Viewbox Stretch="Uniform" Margin="4">
                                        <Grid Width="{Binding CardPortraitFrameWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Height="{Binding CardPortraitFrameHeight, RelativeSource={RelativeSource AncestorType=Window}}" Background="Black">
                                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding CardPortraitPreview, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="{Binding CardPortraitPreviewStretch, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#0A7"
                                           Text="{Binding CardPortraitFrameHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding CardPortraitPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B60"
                                           Text="{Binding CardPortraitPreviewNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding CardPortraitPreviewNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                     <!-- V0.2.228：分辨率说明（上传的图比游戏显示区域大很多时才出现） -->
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                     Text="{Binding CardPortraitResolutionNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Visibility="{Binding CardPortraitResolutionNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                <TextBlock Margin="6,10,0,0" Text="自定义描述（留空 = 只用自动生成的那段）" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Field}" Margin="6,2,0,0" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding CustomDescription, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{}{Damage:diff()} 这类本体占位符照旧能用。"/>
                                <CheckBox Margin="6,2,0,0" Style="{StaticResource Check}"
                                          Content="替换掉自动生成的描述（不勾 = 追加在后面）"
                                          IsChecked="{Binding CustomDescriptionReplaces}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=CurseEffectList}"/>
                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=CurseEffectList}"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCard"
                                        IsEnabled="{Binding CanUndoCard}" ToolTip="{Binding UndoCardHint}"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ListBox x:Name="CurseEffectList" Grid.Row="0"
                                         SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         ItemsSource="{Binding Effects}" DisplayMemberPath="Display"/>
                                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                        DataContext="{Binding SelectedItem, ElementName=CurseEffectList}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPlain}"/>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <!-- ===== 先古卡 / 状态卡详情（两张牌共用这一块：一次只会选中其中一个）===== -->
                    <Grid x:Name="SpecialCardDetail" Grid.Column="2" DataContext="{Binding SpecialCard, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding ShowSpecialCardDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="先古卡属性" FontWeight="Bold" Margin="0,0,0,6"
                                           Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="状态卡属性" FontWeight="Bold" Margin="0,0,0,6"
                                           Visibility="{Binding IsStatusCard, Converter={StaticResource BoolToVis}}"/>
                                <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                        Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A5A00" FontSize="11"
                                               Text="先古卡就是稀有度为「先古」的普通牌（本体丰饶 / 神化 / 幽灵形态那种）：能打出、能升级，只是不进战斗奖励。拿到它的方式：先古之民给的遗物（本体「尘封的书」会从你的卡池里随机挑一张先古卡），或者你自己的效果里选它。"/>
                                </Border>
                                <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                        Visibility="{Binding IsStatusCard, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A5A00" FontSize="11"
                                               Text="状态卡就是本体「伤口 / 灼伤 / 眩晕 / 粘液」那种牌：稀有度固定「状态」、默认不能升级、不进战斗奖励（本体的奖励只从 Common / Uncommon / Rare 里抽）。拿到它的方式：你自己的效果（生成卡牌 / 获得卡牌（全局））或者敌人的效果。这一栏和「卡牌」页是**同一份数据** —— 在这里改，卡牌页也跟着变。"/>
                                </Border>
                                <TextBlock Text="名称（中文，列表里显示用）" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="英文类名（留空 = 自动编号 &lt;角色类名&gt;Card&lt;普通卡列表第几位&gt; —— 状态卡住在「卡牌」列表里）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock TextWrapping="Wrap" Margin="6,0,0,2" Foreground="#888" FontSize="11" Text="{Binding ClassNameHint}"/>
                                <TextBlock Text="类型" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="CurseCardTypeCombo" Style="{StaticResource Pick}" ItemsSource="{Binding CardTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding CardType}"
                                          ToolTip="本体那些状态牌（伤口 / 灼伤 / 眩晕 / 粘液）的类型都是 Status；先古卡和普通卡一样是 攻击 / 技能 / 能力。"/>
                                <TextBlock Text="费用" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="稀有度固定为「先古」（Ancient），生成时写死" Style="{StaticResource Label}" Foreground="#888" FontSize="11"
                                           Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="稀有度固定为「状态」（Status），生成时写死；默认 MaxUpgradeLevel = 0（和本体「粘液」一样不能升级）—— 想让它局内能被升级（像本体「凋萎」那样）就勾下面那个「可被无限升级」"
                                           Style="{StaticResource Label}" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding IsStatusCard, Converter={StaticResource BoolToVis}}"/>
                                <!-- V0.2.223（用户实测报的「状态牌局内升级好像没生效」）：这一页以前**没有**这个开关
                                     —— 状态牌只能在这一页编辑，于是永远升不了级（生成的是 MaxUpgradeLevel => 0），
                                     「升级卡牌」效果自然什么都不做。 -->
                                <CheckBox Content="可被无限升级（每次升级数值再涨一次 —— 状态牌 / 先古卡想局内升级就勾它）"
                                          Style="{StaticResource Check}"
                                          IsChecked="{Binding InfinitelyUpgradable}"
                                          Visibility="{Binding ShowInfinitelyUpgradable, Converter={StaticResource BoolToVis}}"
                                          ToolTip="勾上 = 生成 MaxUpgradeLevel => int.MaxValue：局内用「升级卡牌」效果（或营火）每升一级都会再跑一遍 OnUpgrade()，每条效果的「升级增量」累加，卡面标题显示成「名字+N」——和本体「凋萎 Wither」的 FakeUpgrade 是同一个效果（那边每次也是 DynamicVars.Damage.UpgradeValueBy(3m)）。&#10;不勾 = 状态牌 MaxUpgradeLevel => 0（和本体「粘液」一样升不了级）、先古卡 = 本体默认只能升 1 级。&#10;⚠ 走的是**标准升级**，所以这张状态牌在营火（铁匠）/ 商店也能被升级。"/>
                                <!-- V0.2.260（用户要求）：先古卡专属的两件先古道具。
                                     「古老牙齿 ArchaicTooth」把角色的**初始卡**换成一张先古卡（本体只认它自己那张表，
                                     自定义角色的初始卡不在表里 → 会变成「怀疑 Doubt」）；
                                     「尘封魔典 DustyTome」是从卡池里**随机**挑一张先古卡。
                                     勾上之后各生成一个 Harmony 前缀，只对本模组角色生效（别的角色照旧走本体）。 -->
                                <CheckBox Content="替换古老牙齿所替换的初始卡牌"
                                          Style="{StaticResource Check}"
                                          IsChecked="{Binding ToothReplace}"
                                          Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"
                                          ToolTip="勾上 = 拿到「古老牙齿」时，它会把你的**初始卡**换成这张先古卡（走本体自带的 SetupForTests，只对本模组角色生效）。&#10;不勾 = 本体那张「初始卡 → 先古卡」表里没有我们的卡，你拿到古老牙齿只会得到一张「怀疑 Doubt」。&#10;初始卡 = 卡牌页里勾了「初始牌」的第一张（按「初始卡组」那一栏从上往下）。"/>
                                <CheckBox Content="作为尘封魔典给的先古卡"
                                          Style="{StaticResource Check}"
                                          IsChecked="{Binding DustyTomeGrant}"
                                          Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"
                                          ToolTip="勾上 = 拿到「尘封魔典」时直接给这张先古卡（只对本模组角色生效）。&#10;不勾 = 本体从你的卡池里**随机**挑一张先古卡（它还会排掉古老牙齿换出来的那 5 张）。"/>
                                <!-- V0.2.261（用户问「那我如何决定是哪张牌被替换呢」）：
                                     被古老牙齿换掉的那张初始卡，现在可以自己指定（默认 = 初始卡组里第一张）。 -->
                                <TextBlock Text="被古老牙齿换掉的初始卡（留空 = 自动取初始卡组第一张）"
                                           Style="{StaticResource Label}" TextWrapping="Wrap"
                                           Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"/>
                                <ComboBox Style="{StaticResource Pick}"
                                          ItemsSource="{Binding ToothStarterChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                          SelectedValue="{Binding ToothStarterClass}"
                                          Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"
                                          ToolTip="古老牙齿会把这一张**初始卡**换成上面这张先古卡。&#10;留空（或选第一项）= 自动：取卡牌页勾了「初始牌」的第一张（按「初始卡组」从上往下）。&#10;⚠ 只有勾了「替换古老牙齿所替换的初始卡牌」，这个下拉才有意义。"/>
                                <TextBlock Text="⚠ 这两个勾各只能勾一张先古卡（古老牙齿 / 尘封魔典每次只给一张），勾多了会报错。"
                                           Style="{StaticResource Label}" Foreground="#B00" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding IsAncientCard, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="卡牌关键字" Style="{StaticResource Label}" FontWeight="Bold" Margin="6,10,6,0"/>
                                <WrapPanel Margin="6,0,0,0">
                                    <CheckBox Content="消耗（打出后移除）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Exhausts}"/>
                                    <CheckBox Content="虚无（回合末未打出则消耗）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Ethereal}"/>
                                    <CheckBox Content="固有（开局必在手牌）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Innate}"/>
                                    <CheckBox Content="保留（回合末不弃）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Retain}"/>
                                    <CheckBox Content="奇巧（被弃掉则免费打出）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Sly}"/>
                                    <CheckBox Content="永恒（无法从牌组移除或变化）" Style="{StaticResource Check}" Margin="0,2,14,2" IsChecked="{Binding Eternal}"/>
                                </WrapPanel>
                                <TextBlock Text="自定义关键词（勾选这张牌用到的）" Style="{StaticResource Label}" FontWeight="Bold" Margin="6,10,6,0"/>
                                <TextBlock Text="还没定义任何关键词：先到「自定义关键词」页添加。" Style="{StaticResource Label}" Foreground="#999" Margin="6,2,0,0"
                                           Visibility="{Binding NoCustomKeywords, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl Margin="6,0,0,0" ItemsSource="{Binding CustomKeywordRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Check}" Margin="0,2,14,2" Content="{Binding Name}"
                                                      ToolTip="{Binding KeyHint}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="升级后的关键字（不变 / 升级后获得 / 升级后失去）" Style="{StaticResource Label}" FontWeight="Bold" Margin="6,10,6,0"/>
                                <ItemsControl Margin="6,0,0,0" ItemsSource="{Binding UpgradeKeywordRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                <TextBlock Text="{Binding Zh}" Width="120" VerticalAlignment="Center"/>
                                                <ComboBox Width="140" Style="{StaticResource Pick}"
                                                          ItemsSource="{Binding KeywordUpgradeStates, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding State, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding CardPortraitUploadHint, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,4" Margin="6,6,0,0" HorizontalAlignment="Left" Click="OnPickSpecialCardPortrait"/>
                                <Border BorderBrush="#DDD" BorderThickness="1" Height="190" Margin="6,4,0,0" Background="#FAFAFA">
                                    <Viewbox Stretch="Uniform" Margin="4">
                                        <!-- 先古卡：预览框是竖的（606×852），而且按游戏里的做法「直接拉满」显示 -->
                                        <Grid Width="{Binding CardPortraitFrameWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Height="{Binding CardPortraitFrameHeight, RelativeSource={RelativeSource AncestorType=Window}}" Background="Black">
                                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding CardPortraitPreview, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="{Binding CardPortraitPreviewStretch, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#0A7"
                                           Text="{Binding CardPortraitFrameHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding CardPortraitPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B60"
                                           Text="{Binding CardPortraitPreviewNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding CardPortraitPreviewNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                     <!-- V0.2.228：分辨率说明（上传的图比游戏显示区域大很多时才出现） -->
                                <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                     Text="{Binding CardPortraitResolutionNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Visibility="{Binding CardPortraitResolutionNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}"/>
                                <TextBlock Margin="6,10,0,0" Text="自定义描述（留空 = 只用自动生成的那段）" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Field}" Margin="6,2,0,0" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding CustomDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Margin="6,2,0,0" Style="{StaticResource Check}"
                                          Content="替换掉自动生成的描述（不勾 = 追加在后面）"
                                          IsChecked="{Binding CustomDescriptionReplaces}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=AncientEffectList}"/>
                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=AncientEffectList}"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCard"
                                        IsEnabled="{Binding CanUndoCard}" ToolTip="{Binding UndoCardHint}"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ListBox x:Name="AncientEffectList" Grid.Row="0"
                                         SelectionMode="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiSelectMode}}"
                                         ItemsSource="{Binding Effects}" DisplayMemberPath="Display"/>
                                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                        DataContext="{Binding SelectedItem, ElementName=AncientEffectList}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorCard}"/>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 自定义关键词 ============ -->
            <TabItem x:Name="KeywordTab" Header="自定义关键词">
                <DockPanel Margin="8">
                    <!-- 最上面这一节：本体关键词改名（固定 7 行，不另开选项卡） -->
                    <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="本体关键词改名（把本体那 7 个关键词的显示名改成你自己的）" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#666"
                                       Text="留空 = 不改。改的是本体那 7 个关键词；改完后本体卡面上的金色词、以及本体卡牌描述里出现的旧名字都会跟着换。"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="本体关键词" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="新显示名（留空 = 不改）" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="新说明（留空 = 不改）" FontWeight="Bold" Margin="0,0,0,2"/>
                                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                              x:Name="KeywordRenameTable"
                                              ItemsSource="{Binding Profile.KeywordRenames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Margin="0,0,8,0" Text="{Binding VanillaName}"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource Field}"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource Field}"
                                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="{Binding KeywordRenameHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="添加关键词" Padding="8,4" Margin="0,0,6,0" Click="OnAddKeyword"/>
                                <Button Content="删除" Padding="8,4" Click="OnRemoveKeyword"/>
                                <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoKeyword"
                                        IsEnabled="{Binding CanUndoKeyword}" ToolTip="{Binding UndoKeywordHint}"/>
                            </WrapPanel>
                            <ListBox x:Name="KeywordList" SelectionMode="Extended" ItemsSource="{Binding Profile.CustomKeywords}" DisplayMemberPath="Display"/>
                        </DockPanel>
                        <TextBlock Grid.Column="2" FontSize="16" Foreground="#999"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="请选择关键词（没有就点左边的「添加关键词」）"
                                   Visibility="{Binding SelectedItem, ElementName=KeywordList, Converter={StaticResource EmptyToVisibility}}"/>

                        <Grid x:Name="KeywordDetail" Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=KeywordList}"
                              Visibility="{Binding SelectedItem, ElementName=KeywordList, Converter={StaticResource NotEmptyToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="关键词属性" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="名字（卡面上显示的那个词，例如「命定」）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="英文标识（本地化键，留空 = 自动用 KEYWORD_1…；不能和本体关键词撞名）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="说明（鼠标悬停在卡上时弹出的正文）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource Field}" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888" Margin="6,10,0,0"
                                               Text="用法：到「卡牌」页勾选哪张牌用这个词。生成时会自动：&#10;· 把名字拼在这张牌描述的最前面（和本体「消耗 / 虚无」一样的观感）；&#10;· 鼠标悬停在卡上时弹出「名字 + 说明」；&#10;· 把文案写进模组的 card_keywords.json（本体那张表，逐键合并，不动本体关键词）。&#10;本体的关键词是封闭枚举、模组加不了新值，所以走的是这套等价机制：不改本体、不需要补丁。"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ 先古之民 ============ -->
            <TabItem x:Name="AncientTab" Header="先古之民">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Text="左边选一位先古之民，右边填和他的对话（槽位从本机解包工程读取）。"/>
                        <TextBlock x:Name="AncientEmptyHint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#B00" Margin="0,6,0,0"
                                   Visibility="{Binding AncientCatalogMissing, Converter={StaticResource BoolToVis}}"
                                   Text="读不到先古之民列表：请到「构建 / 日志」页指定「解包后的原版工程目录」，然后回这里（列表会自动刷新）。"/>
                        <ListBox x:Name="AncientList" ItemsSource="{Binding Ancients}" DisplayMemberPath="Display"
                                 SelectionChanged="OnAncientSelectionChanged"/>
                    </DockPanel>

                    <TextBlock x:Name="AncientNoSelectHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请先选择左边的先古之民"
                               Visibility="{Binding SelectedItem, ElementName=AncientList, Converter={StaticResource EmptyToVisibility}}"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedItem, ElementName=AncientList, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedItem, ElementName=AncientList}">
                            <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="加一段对话" Padding="8,4" Margin="0,0,6,0" Click="OnAddAncientDialogue"/>
                                <Button Content="删掉这一段" Padding="8,4" Click="OnRemoveAncientDialogue" Tag="{Binding ElementName=AncientDialogueList}"/>
                            </StackPanel>

                            <ListBox x:Name="AncientDialogueList" ItemsSource="{Binding Dialogues}" MaxHeight="120" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,0,8"
                                    DataContext="{Binding SelectedItem, ElementName=AncientDialogueList}">
                                <StackPanel>
                                    <TextBlock Text="这一段" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#888"
                                               Text="{Binding SelectedItem.UnitHint, ElementName=AncientList}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Label}"
                                                   Text="{Binding SelectedItem.UnitFieldLabel, ElementName=AncientList}"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Margin="4,0,10,0"
                                                 ToolTip="{Binding SelectedItem.UnitHint, ElementName=AncientList}"
                                                 Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Check}"
                                                  Content="说完加入重复池（以后每次到访都可能随机再说这段）"
                                                  IsChecked="{Binding Repeating}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" Style="{StaticResource Pick}" Margin="0,0,8,0"
                                                              ItemsSource="{Binding SpeakerOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                                              SelectedValue="{Binding AncientSpeaks}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" MinHeight="40"
                                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Margin="8,0,0,0"
                                                             ToolTip="「下一句」按钮上的字（最后一句用不到）"
                                                             Text="{Binding NextText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="3" Content="删这一句" Padding="6,2" Margin="6,0,0,0"
                                                            Click="OnRemoveAncientLine"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="加一句" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnAddAncientLine"/>
                                </StackPanel>
                            </Border>

                            <TextBlock TextWrapping="Wrap" Foreground="#888" Text="{Binding Hint}"/>

                            <!-- 遗物替换：左边罗列他原本会给的遗物，右边是替换记录（记录要看得清、放得下） -->
                            <GroupBox Header="把原本会给的遗物换成你要的" Margin="0,14,0,0">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="280"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左：原本会给的遗物清单 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="① 他原本会给的遗物（点一个）" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,3,0,4"
                                                   Text="本体每位先古之民会从这张候选表里筛选 → 洗牌 → 随机给你 3 个（有时第 3 个是「尘封古书」）。"/>
                                        <TextBlock Margin="0,0,0,4" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding AncientOriginalRelicSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <ListBox x:Name="AncientOriginalRelicList" MinHeight="180" MaxHeight="320"
                                                 ItemsSource="{Binding AncientOriginalRelics, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 DisplayMemberPath="Display"/>
                                        <Button Content="② 替换掉选中的这个 →" Padding="8,5" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                Click="OnReplaceSelectedOriginalRelic"
                                                ToolTip="按选中的「原本的遗物」加一条替换记录（会出现在右边），然后再在右边选「换成哪个遗物」。"/>
                                    </StackPanel>

                                    <!-- 右：替换记录 + 明细 -->
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Text="③ 替换记录（这里能看到每条到底换什么）" FontWeight="Bold" FontSize="13"/>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                            <Button Content="加一条" Padding="8,4" Margin="0,0,6,0" Click="OnAddAncientRelicReplace"/>
                                            <Button Content="删掉这条" Padding="8,4" Click="OnRemoveAncientRelicReplace" Tag="{Binding ElementName=AncientRelicReplaceList}"/>
                                        </WrapPanel>
                                        <!-- 明细放在下面，列表给足高度：小窗口也看得见整条内容 -->
                                        <Border x:Name="AncientRelicReplaceDetail" DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,6,0,0"
                                                DataContext="{Binding SelectedItem, ElementName=AncientRelicReplaceList}">
                                            <StackPanel>
                                                <TextBlock Text="原本的遗物（他原本会给的）" FontWeight="Bold"/>
                                                <local:SearchComboBox Margin="0,4,0,0"
                                                                      ItemsSource="{Binding AncientOriginalRelics, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedValuePath="Id" SelectedValue="{Binding FromRelicId, Mode=TwoWay}"
                                                                      SearchPath="Display"
                                                                      ToolTip="只能从他原本会给的遗物里挑（左边那个列表就是这些）。">
                                                    <local:SearchComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                                    </local:SearchComboBox.ItemTemplate>
                                                </local:SearchComboBox>
                                                <TextBlock Text="换成哪个遗物（本体的其它遗物 + 你自己做的）" FontWeight="Bold" Margin="0,8,0,0"/>
                                                <local:SearchComboBox Margin="0,4,0,0"
                                                                      ItemsSource="{Binding AncientRelicChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedValuePath="Id" SelectedValue="{Binding RelicId, Mode=TwoWay}"
                                                                      SearchPath="Display"
                                                                      ToolTip="要换成你自己做的遗物，先在「遗物」页把它做出来，这里列表最后就是。">
                                                    <local:SearchComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                                    </local:SearchComboBox.ItemTemplate>
                                                </local:SearchComboBox>
                                                <TextBlock Margin="2,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#888"
                                                           Text="{Binding StateText}"/>
                                            </StackPanel>
                                        </Border>
                                        <ListBox x:Name="AncientRelicReplaceList" MinHeight="180" MaxHeight="320"
                                                 ItemsSource="{Binding RelicReplacements}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,4" Margin="0,1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FromDisplay}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ToDisplay}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                            <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{Binding StateOk, Converter={StaticResource OkToBrush}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 本体状态改写 ============ -->
            <TabItem x:Name="PowerOverrideTab" Header="本体状态改写">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="640" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Text="把本体某个状态（增益/减益，比如「中毒」）的名字、描述、图标、血条颜色、层数数字颜色改成你自己的。名字和描述走本地化表覆盖，图标和颜色走生成出来的补丁。注意：这是全局改动，本体其他角色身上的这个状态也会跟着变。"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="添加改写" Padding="10,4" Margin="0,0,6,0" Click="OnAddPowerOverride"/>
                            <Button Content="删除选中" Padding="10,4" Margin="0,0,6,0" Click="OnRemovePowerOverride"
                                    ToolTip="可 Ctrl / Shift 多选（或按 Ctrl+A 全选）一次删掉多条"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#888"
                                       Text="（同一个状态重复添加时，以最后一条为准）"/>
                        </StackPanel>
                        <ListBox x:Name="PowerOverrideList" SelectionMode="Extended" ItemsSource="{Binding Profile.VanillaPowerOverrides}"
                                 DisplayMemberPath="Display" SelectionChanged="OnPowerOverrideSelectionChanged"/>
                    </DockPanel>

                    <Border Grid.Column="2" x:Name="PowerOverrideDetail" BorderBrush="#DDD" BorderThickness="1" Padding="10">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Text="要改哪个状态" FontWeight="Bold"/>
                                <local:SearchComboBox Margin="0,4,0,0"
                                                ItemsSource="{Binding PowerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                SelectedValuePath="Id" SelectedValue="{Binding PowerId, Mode=TwoWay}"
                                                SearchPath="Display"
                                                ToolTip="可以打字搜索（比如输入「中毒」）；＋ = 增益，－ = 减益">
                                    <local:SearchComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                    </local:SearchComboBox.ItemTemplate>
                                </local:SearchComboBox>

                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="换状态时会自动把这个状态的本体名字/描述填进来打底，图标和颜色会清空（避免把上一个状态的设置带过来）。"/>

                                <CheckBox Margin="0,10,0,0" Style="{StaticResource Check}"
                                          Content="启用这条改写" IsChecked="{Binding Enabled}"/>

                                <TextBlock Margin="0,12,0,4" Text="新名字（留空 = 不改；填成和原名一样就等于没改）" FontWeight="Bold"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="把描述里的旧名字一起换成新名字" Padding="8,3" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" Click="OnRenameInDescription"/>
                                <CheckBox Margin="0,4,0,0" Style="{StaticResource Check}"
                                          Content="本体卡牌 / 遗物 / 药水描述里的旧名字也一起换掉（推荐）"
                                          IsChecked="{Binding ReplaceInVanillaText}"
                                          ToolTip="改名后，本体那些写着「施加 2 层中毒」的卡面描述也会一起变成新名字，不然卡面上还是旧名。"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="{Binding VanillaTextHint, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                <TextBlock Margin="0,12,0,4" Text="新描述（留空 = 不改；{Amount} = 层数占位符）" FontWeight="Bold"/>
                                <TextBox Style="{StaticResource Field}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="本体描述里会出现这个名字（比如「将中毒层数减少1」），改名时建议一起改掉（下面那个勾选项连本体卡面的描述一起换）。"/>

                                <TextBlock Margin="0,12,0,4" Text="图标（留空 = 用本体原图）" FontWeight="Bold"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Left" Content="选择图片…" Padding="10,3" Margin="0,0,6,0"
                                            Click="OnPickPowerIcon"/>
                                    <Button DockPanel.Dock="Left" Content="清除" Padding="10,3" Click="OnClearPowerIcon"/>
                                    <TextBox Style="{StaticResource Field}" IsReadOnly="True" Text="{Binding Icon, Mode=OneWay}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Width="64" Height="64" BorderBrush="#999" BorderThickness="1" Background="#22FFFFFF">
                                        <Image Margin="2" Stretch="Uniform"
                                               Source="{Binding PowerIconPreview, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Border>
                                    <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Width="330" Foreground="#888" FontSize="11"
                                               Text="建议方形带透明 PNG（本体状态图标是 64×64 上下的方图，大图 256×256 也行）。同一张图会同时用在状态栏小图标和施加/闪烁特效的大图上。"/>
                                </StackPanel>

                                <TextBlock Margin="0,12,0,4" Text="血条颜色（RRGGBB，留空 = 不改）" FontWeight="Bold"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding BarColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding BarColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="用本体原色" Padding="8,3" Click="OnUseDefaultBarColor"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                               Text="{Binding BarColorHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>

                                <TextBlock Margin="0,12,0,4" Text="层数数字颜色（RRGGBB，留空 = 本体默认）" FontWeight="Bold"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding AmountColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding AmountColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>

                                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="名字/描述写在生成的 localization/zhs/powers.json 里（本体加载模组本地化表时会覆盖同名键）；图标和颜色由生成的 Harmony 补丁接管，补丁出问题只会记日志、不会让战斗崩。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 自定义状态（能力牌用） ============ -->
            <TabItem x:Name="CustomPowerTab" Header="自定义状态">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="640" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Text="自己造一个状态（本体没有的那种），给能力牌用：选「什么时候触发」+「触发时做什么」。生成时会写出一个 PowerModel 子类，名字/描述写进本地化表，图标和层数颜色走补丁。名字/描述/图标/颜色都是全局的（谁身上挂了这个状态就长这样）。"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="添加状态" Padding="10,4" Margin="0,0,6,0" Click="OnAddCustomPower"/>
                            <Button Content="删除选中" Padding="10,4" Margin="0,0,6,0" Click="OnRemoveCustomPower"
                                    ToolTip="可 Ctrl / Shift 多选（或按 Ctrl+A 全选）一次删掉多个"/>
                            <Button Content="撤回删除" Padding="10,4" Margin="0,0,6,0" Click="OnUndoPower"
                                    IsEnabled="{Binding CanUndoPower}" ToolTip="{Binding UndoPowerHint}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#888" Text="（做好后在卡牌效果里选「施加增益/减益」→ 列表底部就是你造的状态）"/>
                        </StackPanel>
                        <ListBox x:Name="CustomPowerList" SelectionMode="Extended" ItemsSource="{Binding Profile.CustomPowers}"
                                 DisplayMemberPath="Display" SelectionChanged="OnCustomPowerSelectionChanged"/>
                    </DockPanel>

                    <Border Grid.Column="2" x:Name="CustomPowerDetail" BorderBrush="#DDD" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- V0.2.194：这只状态已经由锻造页那块布说了算时，在这儿醒目地提醒一句 ——
                                     生成端「图非空就只读图」（见 ForgeGraphGen.UsesGraph(CustomPowerSpec)），
                                     下面那几栏（触发时机 / 触发时做什么）改了**不生效**；不提醒的话用户会白改半天。
                                     显隐走窗口上的只读属性（和这一页其它提示同一套写法，选中项一变就重算）。 -->
                                <Border Background="#FFF3CD" BorderBrush="#E0B000" BorderThickness="1" CornerRadius="3"
                                        Padding="8,6" Margin="0,0,0,10"
                                        Visibility="{Binding CustomPowerUsesForgeGraph, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A5A00" FontWeight="Bold"
                                               Text="这只状态由**锻造页**那块布说了算 —— 改触发时机 / 效果请去「锻造」页的「状态列表」里改（这里改了不生效）。"/>
                                </Border>
                                <TextBlock Text="名字（游戏里显示的状态名）" FontWeight="Bold"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="0,10,0,4" Text="英文类名（留空自动生成）" FontWeight="Bold"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="0,10,0,4" Text="类型" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="140" Style="{StaticResource Pick}"
                                              ItemsSource="{Binding PowerTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Type}"/>
                                    <CheckBox Margin="14,0,0,0" Style="{StaticResource Check}"
                                              Content="只叠一层（重复施加只刷新，不叠加层数）" IsChecked="{Binding Single}"/>
                                </StackPanel>

                                <TextBlock Margin="0,10,0,4" Text="描述（留空 = 按触发时机自动写一句；{Amount} = 层数）" FontWeight="Bold"/>
                                <TextBox Style="{StaticResource Field}" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="按触发时机重新生成描述" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Left"
                                        Click="OnAutoPowerDescription"/>
                                <!-- 描述预览：跟着触发时机 + 触发时做什么实时变（以前改了什么这里都不动） -->
                                <TextBlock Margin="2,4,0,0" TextWrapping="Wrap" Foreground="#666" FontSize="11"
                                           Text="{Binding CustomPowerDescriptionHint, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                <TextBlock Margin="0,12,0,4" Text="图标（留空 = 本体占位图）" FontWeight="Bold"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Left" Content="选择图片…" Padding="10,3" Margin="0,0,6,0"
                                            Click="OnPickCustomPowerIcon"/>
                                    <Button DockPanel.Dock="Left" Content="清除" Padding="10,3" Click="OnClearCustomPowerIcon"/>
                                    <TextBox Style="{StaticResource Field}" IsReadOnly="True" Text="{Binding Icon, Mode=OneWay}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Width="64" Height="64" BorderBrush="#999" BorderThickness="1" Background="#22FFFFFF">
                                        <Image Margin="2" Stretch="Uniform"
                                               Source="{Binding CustomPowerIconPreview, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" Width="330">
                                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                   Text="建议方形带透明 PNG（本体状态图标是 64×64 上下的方图）。"/>
                                        <TextBlock Margin="0,6,0,0" Text="层数数字颜色（RRGGBB，留空 = 本体默认）" FontWeight="Bold"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                                    Background="{Binding AmountColor, Converter={StaticResource HexBrush}}"/>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding AmountColor, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <!-- 覆盖血条（需求：「增加一个像中毒一样覆盖血条的显示，只需要调整 RRGGBB」
                                             + 「每个状态的颜色各自独立、能同时看见、可以选从左边还是右边开始覆盖」）：
                                             层数 = 会失去的血量，血条上出现这个状态自己的一截（每条状态各一截） -->
                                        <TextBlock Margin="0,6,0,0" Text="覆盖血条颜色（RRGGBB，留空 = 不覆盖）" FontWeight="Bold"
                                                   ToolTip="身上有这个状态的生物，血条上会出现一截这个颜色的条。每个状态各占一截，颜色互不影响。"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" BorderBrush="#999" BorderThickness="1"
                                                    Background="{Binding HpBarColor, Converter={StaticResource HexBrush}}"/>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding HpBarColor, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="六位十六进制，例如 FF8800。&#10;层数 = 会失去的血量：3 层就盖住相当于 3 点血的那一段（和本体中毒同一个算法）。&#10;留空 = 这个状态不覆盖血条。&#10;每个状态各占一条：身上同时有 A 和 B 时两条都能看见。"/>
                                        </DockPanel>
                                        <!-- 「从哪端开始盖」：填了颜色才出现 -->
                                        <ComboBox Margin="0,3,0,0" Style="{StaticResource Pick}"
                                                  Visibility="{Binding ShowHpBarSide, Converter={StaticResource BoolToVis}}"
                                                  ItemsSource="{Binding HpBarSideChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                                  SelectedValue="{Binding HpBarSide}"
                                                  ToolTip="从右边开始（默认，像本体中毒）：从当前血量的右端往左盖，红条右端跟着让位。&#10;从左边开始：从血条最左端往右盖，红条左端跟着让位。&#10;同一边有好几条时依次往里堆，中间剩下的是红条。"/>
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                   Text="每个状态各占一条、颜色各自独立（A 和 B 能同时看见）；同一边有好几条时按上面列表的顺序往里堆，中间剩下的是红条。"/>
                                    </StackPanel>
                                </StackPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <CheckBox Style="{StaticResource Check}" Margin="0,2,14,2" Content="启用这个状态" IsChecked="{Binding Enabled}"/>
                                    <CheckBox Style="{StaticResource Check}" Margin="0,2,14,2" Content="回合结束时移除（临时状态）" IsChecked="{Binding RemoveAtTurnEnd}"/>
                                    <!-- V0.2.239（用户问「在自定义状态增加状态层数能否到负值」）：
                                         勾了 → 生成的状态类带 AllowNegative => true，和本体 力量 / 敏捷 / 专注 一样
                                         0 层也能扣成负数；「施加增益/减益」填负数时直接施加负值（本体尖啸那套）。
                                         不勾 → 负数只从目标身上已有的层数里扣（扣到 0 就移除这个状态）。 -->
                                    <CheckBox Style="{StaticResource Check}" Margin="0,2,14,2"
                                              Content="允许负层数（像力量那样，0 层也能扣成负的）"
                                              IsChecked="{Binding AllowNegativeLayers}"
                                              ToolTip="勾上：这个状态的层数可以小于 0（和本体「力量 / 敏捷 / 专注」同一个口径）——&#10;· 「施加增益 / 减益」填负数时**直接施加负值**：目标本来 0 层也会变成 -N（本体「尖啸」扣敌人力量就是这么做的）；&#10;· 负层数在游戏里按「减益」显示（红框 + 红字），正好回到 0 时状态被移除。&#10;不勾（默认）：层数最低到 0 —— 填负数只从**已有层数**里扣，扣到 0 就把这个状态去掉。&#10;（「每回合衰减」两种情况都是「减到 0 就移除」，不会继续往负数扣。）"/>
                                    <TextBlock Text="每回合衰减" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Width="46" Style="{StaticResource Field}" Text="{Binding DecayPerTurn, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="层" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </WrapPanel>

                                <!-- V0.2.248（用户要求「减少指定卡牌类别的费用（类似腐化，刺破帷幕这些）」）：
                                     生成的是本体的 TryModifyEnergyCostInCombatLate —— 腐化 / 刺破帷幕 / 免费攻击
                                     三个本体状态用的就是这个钩子。范围留空 = 不启用（不影响任何老存档的生成）。 -->
                                <GroupBox Header="费用修正（像腐化 / 刺破帷幕那样，让某一类牌变便宜）" Margin="0,12,0,0">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="哪一类牌" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                            <ComboBox Width="300" Style="{StaticResource Pick}" Margin="0,2"
                                                      ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                                      SelectedValue="{Binding CostReduceScope}"
                                                      ToolTip="和别处的「范围」是同一份候选：不限 / 攻击 / 技能 / 能力 / 诅咒 / 状态 / 任务 / 自定义关键词那一组 / 每个组。&#10;选「不限」= 你所有的牌都减（很少见）。"/>
                                            <TextBlock Text="减" VerticalAlignment="Center" Margin="12,2,4,2"/>
                                            <TextBox Width="52" Style="{StaticResource Field}" Margin="0,2"
                                                     Text="{Binding CostReduceAmount, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="这一类牌减多少费。填 0 = 直接变成 0 费（腐化那种）。最低减到 0，不会变成负费。"/>
                                            <TextBlock Text="费" VerticalAlignment="Center" Margin="4,2,0,2"/>
                                            <CheckBox Margin="14,2,0,2" Style="{StaticResource Check}"
                                                      Content="按层数（每层各减这么多）"
                                                      IsChecked="{Binding CostReducePerStack}"
                                                      ToolTip="勾上：按这个状态的层数算（3 层 × 每层 1 费 = 减 3 费）。&#10;不勾：只看有没有这个状态，和腐化一样减固定那么多。"/>
                                        </WrapPanel>
                                        <TextBlock Margin="2,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                   Text="范围留空 = 不改费用（不生任何代码）。只影响你自己的牌；选「组」时会把组里每张牌展开成判据，所以之后改组的内容会跟着变。"/>
                                    </StackPanel>
                                </GroupBox>

                                <TextBlock Margin="0,16,0,4" Text="触发时机（什么时候做事）" FontWeight="Bold" FontSize="14"/>
                                <!-- 实时汇总：配了哪些时机、每个时机做什么 —— 改了效果这里立刻跟着变 -->
                                <Border Background="#F5F7FA" BorderBrush="#DDE" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap" Foreground="#333" FontSize="12"
                                               Text="{Binding CustomTriggersSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="110"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="CustomTriggerList" Grid.Row="0" SelectionMode="Extended" ItemsSource="{Binding Triggers}"
                                             DisplayMemberPath="Display" SelectionChanged="OnCustomTriggerSelectionChanged"/>
                                    <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                        <Button Content="添加触发时机" Padding="8,4" Margin="0,0,6,0" Click="OnAddPowerTrigger"/>
                                        <Button Content="删除触发时机" Padding="8,4" Click="OnRemovePowerTrigger"/>
                                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888"
                                                   Text="同一个状态可以配好几个时机（比如「回合开始抽一张」+「回合结束获得格挡」）"/>
                                    </WrapPanel>
                                    <!-- 用户报过「在哪选择多个触发时机，我怎么看不到」——这里直接在时机列表下面点名：
                                         「同时成立」不是在上面的列表里勾，而是在**下面那条时机**的编辑器里勾。 -->
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="2,2,0,0" TextWrapping="Wrap"
                                               Foreground="#888" FontSize="11"
                                               Text="想让几条时机「**都在同一个窗口里成立过**才触发」（例：本回合既打过牌又受过伤）？选中下面列表里的时机 → 在它编辑器里勾「要和其他时机同时成立（都成立才触发）」，把参与的那几条**都勾上**即可。"/>

                                    <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Padding="8"
                                            DataContext="{Binding SelectedItem, ElementName=CustomTriggerList}">
                                        <StackPanel>
                                            <TextBlock Text="触发时机" FontWeight="Bold"/>
                                            <ComboBox Style="{StaticResource Pick}"
                                                      ItemsSource="{Binding TriggerOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Kind"
                                                      SelectedValue="{Binding Kind}"/>
                                            <TextBlock Margin="4,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                       Text="{Binding TriggerHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding NeedsCardFilter, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="只对哪类牌生效" VerticalAlignment="Center"/>
                                                <ComboBox MinWidth="160" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                                          ItemsSource="{Binding CardFilterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding CardFilter}"
                                                          ToolTip="任意 / 攻击 / 技能 / 能力 / 诅咒 / 状态，以及你自己配的「自定义关键词」与「组」那一组牌（V0.2.118 起）。&#10;只有「打出一张牌后」用得到。"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888"
                                                           Text="（只有「打出一张牌后」用得到）"/>
                                            </StackPanel>
                                            <!-- 「某个状态层数变化后」：只盯某一个状态（留空 = 除自己以外任意状态变层数都触发） -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding NeedsPower, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="盯的对象" VerticalAlignment="Center"/>
                                                <ComboBox Width="110" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                                          ItemsSource="{Binding WatchTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding PowerTarget}"
                                                          ToolTip="盯谁身上的状态：自己（默认）/ 任意敌人。那个钩子没有「这张牌打的目标」，所以没有「指定敌人」这一档。"/>
                                                <TextBlock Text="盯哪个状态" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <local:SearchComboBox Width="240" Margin="8,0,0,0"
                                                          SearchPath="Display"
                                                          ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id" SelectedValue="{Binding PowerId}"
                                                          ToolTip="可以直接打字搜索（和「增益 / 减益」下拉一样：输入「力」只剩含「力」的项，点选项或按回车自动补全）。留空 = 除自己以外任意状态变层数都触发。">
                                                    <local:SearchComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                                    </local:SearchComboBox.ItemTemplate>
                                                </local:SearchComboBox>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888"
                                                           Text="（留空 = 除自己以外任意状态的层数变化都触发）"/>
                                            </StackPanel>
                                            <!-- V0.2.266（用户要求）：层数变化细分「上升 / 下降」——
                                                 只在「某个状态层数变化后」显示（单独一行，不会和上面挤在一起）。 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding ShowPowerDirectionField, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="层数变化方向" VerticalAlignment="Center"/>
                                                <ComboBox Width="200" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                                          ItemsSource="{Binding TriggerDirections, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding PowerDirection}"
                                                          ToolTip="上升 / 下降都算（默认，老行为）／只在上升时触发／只在下降时触发。&#10;只对「某个状态层数变化后」这一档有意义。"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888"
                                                           Text="（上升 = 加层数；下降 = 掉层数）"/>
                                            </StackPanel>
                                            <!-- 触发时机上的数值（用户要求）：按时机换含义（每 N 点 / 每 N 次 / 数值 ≥ N） -->
                                            <StackPanel Margin="0,6,0,0"
                                                        Visibility="{Binding ShowTriggerAmountField, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TriggerAmountLabel}" VerticalAlignment="Center"/>
                                                    <TextBox Width="70" Margin="8,0,0,0" Style="{StaticResource Field}"
                                                             Text="{Binding TriggerAmount, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="留空或填 0 = 老行为（每次都触发 / 每 1 点）；填 N = 见下面那句说明。"/>
                                                    <TextBlock Text="统计范围" VerticalAlignment="Center" Margin="12,0,0,0"
                                                               Visibility="{Binding ShowTriggerScopeField, Converter={StaticResource BoolToVis}}"/>
                                                    <ComboBox Width="130" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                                              Visibility="{Binding ShowTriggerScopeField, Converter={StaticResource BoolToVis}}"
                                                              ItemsSource="{Binding TriggerScopes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding TriggerScope}"
                                                              ToolTip="本回合 = 每个回合重新计数；本场战斗 = 整场战斗累计（换战斗重新算）。"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                           Text="{Binding TriggerSpendHint}"/>
                                            </StackPanel>
                                            <!-- 「某个状态层数到达 N 层时」（用户要求：两边触发时机菜单相同）：
                                                 N 填这里；判的是「这一次变化跨过了 N 层」。 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding NeedsAmount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="到达 N 层" VerticalAlignment="Center"/>
                                                <TextBox Width="70" Margin="8,0,0,0" Style="{StaticResource Field}"
                                                         Text="{Binding TriggerAmount, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="层数**跨过**这个数的那一下触发：之前不到 N、变化之后到了 N 或更多（已经是 N 层再加一层不会重复触发）。例：填 5 = 从 4 涨到 5 时触发一次。"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888"
                                                           Text="（跨过 N 层那一下才触发；和「盯哪个状态」配合用）"/>
                                            </StackPanel>

                                            <!-- 「要和其他时机同时成立」（用户要求，V0.2.117）：同一个状态上把参与的那几条
                                                 时机都勾上 —— 都在同一个窗口里成立过才会触发（最后凑齐的那条跑自己的效果）。
                                                 重置范围挂在整只状态上（≥ 2 条勾了才显示）。 -->
                                            <CheckBox Margin="0,8,0,0" Content="要和其他时机同时成立（都成立才触发）"
                                                      IsChecked="{Binding RequireAllTriggers}"
                                                      ToolTip="勾上 = 这条时机要和**同一个状态上别的也勾了它的时机**都在同一个窗口里成立过，才会触发（最后凑齐的那条跑它自己的效果，然后这一轮的标记清掉）。&#10;例：本回合既「打出过牌」又「受到过伤害」才触发 → 那两条时机都勾上，效果写在其中一条上。&#10;⚠ 只有 1 条勾了 = 凑不齐，那条设置不生效（生成前的检查会给提示）。"/>
                                            <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                       Text="{Binding AndHint}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                        Visibility="{Binding ShowAndScope, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="重置范围" VerticalAlignment="Center"/>
                                                <ComboBox Width="130" Margin="8,0,0,0" Style="{StaticResource Pick}"
                                                          ItemsSource="{Binding TriggerScopes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding AndScope}"
                                                          ToolTip="本回合 = 每个回合重新凑一次（默认）；本场战斗 = 整场战斗里凑齐一次就够。&#10;「本场战斗」不需要额外代码（状态本来就是每场战斗一个新实例），「本回合」按回合号自动清零。"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888"
                                                           Text="（本回合 = 每回合重新凑；本场战斗 = 整场凑一次）"/>
                                            </StackPanel>

                                            <TextBlock Margin="0,10,0,4" Text="触发时做什么" FontWeight="Bold"/>
                                            <ListBox x:Name="CustomEffectList" Height="110" SelectionMode="Extended" ItemsSource="{Binding Effects}"
                                                     DisplayMemberPath="Display"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect"
                                                        Tag="{Binding ElementName=CustomEffectList}"/>
                                                <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect"
                                                        Tag="{Binding ElementName=CustomEffectList}"/>
                                            </WrapPanel>
                                            <Border BorderBrush="#EEE" BorderThickness="1" Padding="6" Margin="0,6,0,0"
                                                    DataContext="{Binding SelectedItem, ElementName=CustomEffectList}">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPower}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="生成的东西：cs/Powers/&lt;类名&gt;.cs（按触发时机重写本体钩子）+ localization/zhs/powers.json 里的名字/描述 + 状态外观补丁（图标、层数颜色）。卡牌里用「施加增益/减益」选这个状态，能力牌就成了。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 美术 ============ -->
            <TabItem x:Name="ArtTab" Header="美术资源">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="#666"
                                   Text="全部槽位用 PNG（需要透明通道就必须 PNG）。未上传的槽位默认生成中性占位图；勾上下面这项才用铁甲战士的素材占位 —— 战斗立绘 / 商店立绘 / 篝火立绘 / 选人背景会直接借用本体的 Spine 场景（游戏里就是铁甲战士本人），其余槽位用本体的图。"/>
                        <CheckBox DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold" Foreground="#B00"
                                  Content="未上传的槽位用本体（铁甲战士）素材占位"
                                  ToolTip="只为本地随手测试方便。勾上之后：战斗立绘 / 商店立绘 / 篝火立绘 / 选人背景直接用本体铁甲战士的场景（真 Spine 骨骼动画，能看到人），其余未上传的槽位（头像、选人立绘、地图标记等）用本体的图。发布模组前请关闭并提供自己的美术，否则模组里会带着本体美术资源。"
                                  IsChecked="{Binding Profile.Art.UseVanillaPlaceholders}"/>
                        <!-- V0.2.229（V0.2.228 那个「缩到 1000×760」的勾选框实测**和没缩一模一样**）：
                             工具本身是原样拷贝、不压缩；卡面在游戏里只画 250×190（先古卡 299×421），
                             而且没有 mipmap —— 引擎双线性缩小 4 倍时 16 个像素只采样 4 个，细节直接丢。
                             预缩到「显示尺寸 × N」才真的有效：2× 时刚好用满 4 个像素（实测 RMSE 0.27 vs 3.42）。 -->
                        <TextBlock DockPanel.Dock="Top" Text="卡面过大时缩小到（游戏实际显示尺寸的几倍）"
                                   Style="{StaticResource Label}" TextWrapping="Wrap"/>
                        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,2" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding CardArtShrinkChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding CardArtShrink, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="游戏里卡面只画 250×190（先古卡 299×421），而且卡面纹理没有 mipmap：引擎缩小 4 倍时 16 个像素里只采样 4 个，图越大细节丢得越多（发糊 / 锯齿）。&#10;· 原样拷贝 = 工具一个字节都不动（默认）&#10;· 缩到 2× （500×380，推荐）= 引擎缩小 2 倍时刚好用满 4 个像素 —— 实测和理想缩放的误差 0.27，直接缩是 3.42，这一档是唯一看得出区别的&#10;· 1×（250×190）= 1080p 满屏最锐利，放大窗口会糊&#10;· 4×（1000×760）= 本体素材口径，实测和「不缩」几乎一样，只省文件体积&#10;缩的是拷进工程的那份副本，**你上传的原图永远不动**；比目标小的图绝不放大。"/>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                   Text="{Binding CardArtShrinkHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" DataContext="{Binding Profile.Art}">
                            <TextBlock Text="头像描边颜色（十六进制，自动生成描边）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0"
                                        BorderBrush="#999" BorderThickness="1"
                                        Background="{Binding IconOutlineColor, Converter={StaticResource HexBrush}}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding IconOutlineColor, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="例如 2A2A2A 或 #2A2A2A。填了就按这个颜色自动生成描边图（取头像的透明通道做剪影），不会再让你传描边 PNG。"/>
                        </StackPanel>
                        <!-- ===== 音效 / 音频（V0.2.155）=====
                             上传的音频给「播放音频文件（我上传的）」这个效果种类用。本体注册不了新的 FMOD 事件，
                             所以这条绕开 FMOD：生成时把文件复制进工程 audio/（导出预设 all_resources，会打进 PCK），
                             运行时用 Godot 的 AudioStreamPlayer 播。 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="音效 / 音频（给「播放音频文件（我上传的）」用）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="支持 .ogg / .mp3 / .wav。上传只是记住你本机的那个文件，生成时才会复制进工程（一起打进 PCK）。名字会变成生成出来的文件名，改名字请在这里改。"/>
                            <ListBox x:Name="AudioAssetList" Height="110" Margin="0,4,0,0"
                                     ItemsSource="{Binding Profile.AudioAssets}"
                                     SelectedItem="{Binding SelectedAudioAsset, Mode=TwoWay}"
                                     DisplayMemberPath="Display"/>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="上传音频…" Padding="10,3" Click="OnAddAudioAsset"/>
                                <Button Content="删除" Padding="10,3" Margin="6,0,0,0" Click="OnRemoveAudioAsset"/>
                                <TextBlock Margin="8,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           MaxWidth="300" Text="{Binding AudioAssetHint}"/>
                            </WrapPanel>
                        </StackPanel>
                        <!-- 多人联机宝箱房那句催促文本：手势在上面那几个槽位里传，这一句在下面填。
                             本体那句是 gameplay_ui.TREASURE_FIGHT_TEXT（「开抢！！！」），
                             我们不改那个全局键，而是只在我方角色的这一局里换掉这一行字。 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" DataContext="{Binding Profile.Art}">
                            <TextBlock Text="多人联机：宝箱房那句催促文本（留空 = 本体「开抢！！！」）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TreasureFightText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="联机进宝箱房时屏幕中间那行字。只在你玩这个角色的这一局里换掉，本体的本地化键一个字都不改（别的角色、联机另一边的玩家看到的还是他们自己的那句话）。字太长会自动缩字号。"/>
                        </StackPanel>
                        <ListBox x:Name="ArtList" ItemsSource="{Binding ArtSlots}" DisplayMemberPath="Display"/>
                    </DockPanel>
                    <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="10" DataContext="{Binding SelectedItem, ElementName=ArtList}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#333" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap" Foreground="#0A7" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PathOrEmpty}" TextWrapping="Wrap" Foreground="#888"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="上传图片…" Padding="10,4" Margin="0,0,8,0" Click="OnPickArt"/>
                                <Button Content="清除（改用占位）" Padding="10,4" Click="OnClearArt"/>
                                <Button Content="撤回清除" Padding="10,4" Margin="6,0,0,0" Click="OnUndoArt"
                                        IsEnabled="{Binding CanUndoArt}" ToolTip="{Binding UndoArtHint}"/>
                            </StackPanel>
                            <Border Margin="0,12,0,0" BorderBrush="#DDD" BorderThickness="1" Height="340" Background="#FAFAFA">
                                <!-- 有「游戏里的显示区域」的槽位：黑底 + 按那个比例画框（Viewbox 让它随面板缩放）。
                                     上传图比例不对时，这里看到的就是游戏里会留的那圈黑边；没有固定显示区域的槽位照旧只显示图片。 -->
                                <Grid>
                                    <Viewbox Stretch="Uniform" Margin="6"
                                             Visibility="{Binding HasFrame, Converter={StaticResource BoolToVis}}">
                                        <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Background="Black">
                                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                        </Grid>
                                    </Viewbox>
                                    <Image Source="{Binding Preview}" Stretch="Uniform"
                                           Visibility="{Binding HasFrame, Converter={StaticResource BoolToCollapsed}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B60"
                                       Text="{Binding AspectNote}"
                                       Visibility="{Binding AspectNote, Converter={StaticResource NotEmptyToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 逐帧动画（动图拆帧） ============ -->
            <TabItem x:Name="AnimTab" Header="动画">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <!-- 署名：「逐帧动画」这一页的玩法与文案吸收自 TのG 的改造版（工具本身是按本仓库风格重写的）。
                             放最上面、加粗 + 金色，是要一眼就能看到（金色用偏深的 #B8860B：纯金 #FFD700 在白底上太浅看不清）。 -->
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="15" FontWeight="Bold"
                                   Foreground="#B8860B" Text="此动画板块由TのG制作"/>
                        <!-- 这一页只管「战斗 / 篝火 / 商店立绘」这一处，所以第一句先说清边界，
                             免得用户以为传了动图就全套美术都换了。 -->
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="#666"
                                   Text="动画只替换「战斗 / 篝火 / 商店立绘」这一处，其它美术槽位（头像 / 选人立绘 / 地图标记 / 能量图标 / 模组预览图…）完全不受影响。生成时会把动图拆成一张张帧图（游戏里不用装 GIF 解码器），再由生成的运行时把本体的动画请求翻成逐帧播放。"/>
                        <CheckBox DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold"
                                  Content="启用逐帧动画（动图拆帧）"
                                  ToolTip="不勾 = 生成结果和以前完全一样：不写任何帧图、也不写逐帧动画的运行时代码。"
                                  IsChecked="{Binding Profile.Animation.Enabled}"/>
                        <!-- 「素材已经放了、但总开关没勾」：勾选框在上面、素材在下面，很容易只做一半 ——
                             这里直接给一条提示 + 一键补救的按钮（不是错误，只是提醒）。 -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#FFF4E5"
                                BorderBrush="#E8B96A" BorderThickness="1"
                                Visibility="{Binding AnimNeedsEnableHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#8A5A00" FontWeight="Bold"
                                           Text="上面已经放了动画素材，但总开关是关的"/>
                                <TextBlock Margin="0,2,0,6" TextWrapping="Wrap" Foreground="#8A5A00" FontSize="11"
                                           Text="关着的话这些素材完全不生效（生成结果和没放素材一样）。"/>
                                <Button Content="一键启用逐帧动画" Padding="10,4" HorizontalAlignment="Left"
                                        FontWeight="Bold" Click="OnAnimEnableFromHint"/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="AnimList" ItemsSource="{Binding AnimSlots}" DisplayMemberPath="Display"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="10"
                                    DataContext="{Binding SelectedItem, ElementName=AnimList}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#333" Margin="0,4,0,4"/>
                                    <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap" Foreground="#0A7" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Path, TargetNullValue=（没上传：这个动作会退回待机）}"
                                               TextWrapping="Wrap" Foreground="#888"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="选择 GIF…" Padding="10,4" Margin="0,0,8,0" Click="OnPickAnim"/>
                                        <Button Content="清除" Padding="10,4" Click="OnClearAnim"/>
                                        <Button Content="撤回清除" Padding="10,4" Margin="6,0,0,0" Click="OnUndoAnim"
                                                IsEnabled="{Binding DataContext.CanUndoAnim, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{Binding DataContext.UndoAnimHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                    <!-- 缩略图只画**第一帧**：WPF 播不了动图，真正逐帧播放的是游戏里。 -->
                                    <Border Margin="0,12,0,0" BorderBrush="#DDD" BorderThickness="1" Height="260" Background="#FAFAFA">
                                        <Viewbox Stretch="Uniform" Margin="6">
                                            <Border Background="Black">
                                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"/>
                                            </Border>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B60"
                                               Text="{Binding FrameNote}"/>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#888"
                                               Text="上面这张只是**第一帧**（WPF 播不了动图）；游戏里按下面设置的速度逐帧播放。"/>
                                </StackPanel>
                            </Border>
                            <!-- 设置区：没勾总开关时整块不显示（ContentControl 只负责把 DataContext 换成 AnimationSpec，
                                 这样里面每一行都能直接绑字段名）。 -->
                            <ContentControl Margin="0,10,0,0" DataContext="{Binding Profile.Animation}">
                                <Border BorderBrush="#DDD" BorderThickness="1" Padding="10"
                                        Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="动画设置" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                                   Text="7 个动作共用同一个裁剪框（默认取所有动作所有帧的并集，这样换动作时角色不会跳位置）；想自己控制就填「手动裁剪框」。抠底 / 剥描边只改像素、不改裁剪框。"/>
                                        <TextBlock Text="手动裁剪框 x0,y0,x1,y1（留空 = 自动；x1/y1 是开区间）"
                                                   Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding ManualCrop, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Style="{StaticResource Check}" Content="抠背景（把纯色底变透明）"
                                                  ToolTip="取头尾两个像素的均值当底色，RGB 每通道差不超过容差的像素 alpha 清 0。只影响写帧，不影响裁剪框。"
                                                  IsChecked="{Binding KeyBackground}"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="容差（抠底的 RGB 距离，默认 12）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding KeyTolerance, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <CheckBox Style="{StaticResource Check}" Content="剥掉浅色描边"
                                                  ToolTip="把轮廓外最外 1~2 层浅色（每通道都亮过下面那个阈值）的像素剥成透明。**会吃掉不透明像素**；剥掉超过 2.5% 时整块还原保护素材。"
                                                  IsChecked="{Binding StripOutline}"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="亮度阈值（剥描边用的「浅色」标准，默认 170）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding OutlineLuminance, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <CheckBox Style="{StaticResource Check}" Content="最近邻过滤"
                                                  ToolTip="像素画必须开：帧图在游戏里会被缩放，线性过滤会混出源里没有的颜色、边缘发糊。"
                                                  IsChecked="{Binding NearestFilter}"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="播放速度系数（1 = 动图原速，2 = 双倍速）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding SpeedScale, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="缩放（0 = 按静态立绘高度自动算）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Y 偏移（0 = 自动：让脚落在静态立绘底边）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding YOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="每帧时长秒（0 = 用动图自己的延时取平均）" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding FrameSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <CheckBox Style="{StaticResource Check}" Content="篝火 / 商店里保持专属动画（不切回待机）"
                                                  ToolTip="不勾：篝火和商店会先播你传的专属动画，但本体过一会儿会发一次「回待机」，画面就切回待机动画了（本体默认行为）。"
                                                  IsChecked="{Binding KeepRestAndShopAnim}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="预览动画计划" Padding="10,4" FontWeight="Bold" Click="OnAnimPlanPreview"
                                                    ToolTip="真的解一遍动图，把裁剪框 / 帧数 / 每帧时长 / 缩放 / 位置 / 提示行列出来。只算不写文件。"/>
                                        </StackPanel>
                                        <TextBox Margin="0,8,0,0" Height="220" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding DataContext.AnimPlanText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#888"
                                                   Text="{Binding DataContext.AnimSettingDiag, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 配置存档 ============ -->
            <TabItem x:Name="EnvTab" Header="环境自检">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock TextWrapping="Wrap" Foreground="#333"
                                   Text="这里检查「这台电脑是否具备做模组的条件」。这一页只是提前告诉你缺什么，缺项也会在构建时以报错形式出现。"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,4,0,0"
                                   Text="缺的是「路径」的项（比如 Godot、游戏 data 目录、解包工程目录），右边会长出一个「选择路径…」按钮：点一下直接选，不用跑去别的页手填。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="重新检测" Padding="12,4" FontWeight="Bold" Click="OnRecheckEnv"/>
                            <TextBlock x:Name="EnvSummary" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="EnvList" Grid.Row="1" ItemsSource="{Binding EnvItems}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Foreground="#B00" Margin="0,2,0,0"
                                                   Visibility="{Binding Fix, Converter={StaticResource NotEmptyToVisibility}}"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                                   Visibility="{Binding IsOk, Converter={StaticResource BoolToCollapsed}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="选择路径…" Padding="8,3" Margin="8,0,0,0"
                                                Tag="{Binding Pick}" Click="OnPickEnvPath"
                                                ToolTip="直接在这一页把这个路径选好"
                                                Visibility="{Binding Pick, Converter={StaticResource NotEmptyToVisibility}}"/>
                                        <Button Content="打开下载页" Padding="8,3" Margin="8,0,0,0"
                                                Tag="{Binding Url}" Click="OnOpenEnvUrl"
                                                Visibility="{Binding Url, Converter={StaticResource NotEmptyToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="配置存档">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Text="存档 = 根目录「自定义角色存档」文件夹里的一个 json 文件（老版本的「程序文件\自定义角色」会自动搬过来）。列表支持多选（Ctrl/Shift 或点「全选」）；选中后可载入、删除；「用当前配置覆盖该存档」会把界面上的配置写回选中的存档。"/>
                        <ListBox x:Name="ProfileList" SelectionMode="{Binding MultiSelectProfiles, Converter={StaticResource MultiSelectMode}}" ItemsSource="{Binding Profiles}" DisplayMemberPath="Display"/>
                    </DockPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="存档操作" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Button Content="刷新列表" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnRefreshProfiles"/>
                        <Button Content="载入选中存档" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnLoadSelectedProfile"/>
                        <Button Content="用当前配置覆盖该存档" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnSaveProfileToFolder"/>
                        <Button Content="另存为新存档…" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnSaveProfileAsNew"/>
                        <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                      IsChecked="{Binding MultiSelectProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="Ctrl / Shift 点选本来就能多选（Ctrl+A 全选）；打开这个开关后**直接点列表行**就能加选（不用按 Ctrl），下面会出现「全选」"/>
                        <Button Content="全选" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnSelectAllProfiles"
                                Visibility="{Binding MultiSelectProfiles, Converter={StaticResource BoolToVis}}"
                                ToolTip="选中列表里的全部存档"/>
                        <Button Content="删除选中存档" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnDeleteSelectedProfile"/>
                        <Button Content="撤回删除" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnUndoProfile"
                                IsEnabled="{Binding CanUndoProfile}" ToolTip="{Binding UndoProfileHint}"/>
                        <Button Content="打开存档文件夹" Padding="8,4" HorizontalAlignment="Stretch" Click="OnOpenProfileFolder"/>
                        <Button Content="从工程恢复存档…" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnRecoverProfileFromProject"
                                ToolTip="存档被误覆盖时的救命功能：选一个以前生成出来的模组工程目录，工具会从里面的源码反推出存档（卡牌 / 遗物 / 药水 / 自定义状态 / 角色属性 / 名字全部找回），另存为「工程名_恢复.json」。"/>
                        <TextBlock Text="{Binding ProfileFolder}" TextWrapping="Wrap" Foreground="#888" Margin="0,10,0,0"/>
                        <TextBlock Text="提示：每次保存都会把旧内容自动备份到存档目录的「_备份」文件夹（最多留 30 份）。" TextWrapping="Wrap" Foreground="#888" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 插件（V0.2.315） ============ -->
            <TabItem x:Name="PluginTab" Header="插件">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Text="插件放在程序目录的「plugins」文件夹里（每个插件一个子目录 + plugin.json）。插件自带的效果种类会直接出现在「效果种类」下拉里；自带的 .cs 会一起编进模组。"/>
                        <Button DockPanel.Dock="Top" Content="重新加载插件" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnReloadPlugins"/>
                        <Button DockPanel.Dock="Top" Content="打开插件文件夹" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="OnOpenPluginFolder"/>
                        <TextBox DockPanel.Dock="Bottom" x:Name="PluginStatusText" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Foreground="#0A7" Margin="0,6,0,0"/>
                        <ListBox x:Name="PluginList" SelectionChanged="OnPluginSelected"/>
                    </DockPanel>
                    <TextBox Grid.Column="2" x:Name="PluginDetailBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="（左边选一个插件看详情）"/>
                </Grid>
            </TabItem>

            <!-- ============ 构建 ============ -->
            <TabItem x:Name="BuildTab" Header="构建 / 日志">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="解包工程（唯一需要你手动指定的东西）" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="解包后的原版工程目录" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.Paths.VanillaProject, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="OnVanillaPathCommitted" KeyDown="OnVanillaPathKeyDown"
                                         ToolTip="生成模组时的占位美术、场景模板、spine 插件都从这里取；「目标卡」下拉的中文名也从这里读。用 GDRE 解包自己的游戏本体即可，选完会自动重载。"/>
                                <Button Grid.Column="2" Content="选择…" Padding="8,4" Click="OnPickVanilla"/>
                            </Grid>
                            <TextBlock x:Name="EnvStatusText" Margin="6,4,6,0" TextWrapping="Wrap" Foreground="#0A7"
                                       Text="{Binding EnvStatusLine}"/>
                            <TextBlock Margin="6,2,6,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                       Text="Godot / .NET / 游戏目录 / 安装目录都由程序自动识别（找不到时才需要处理，见「环境自检」页）。"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="打开输出目录" Padding="10,4" Click="OnOpenOutput"/>
                        <Button Content="导出日志…" Padding="10,4" Margin="6,0,0,0" Click="OnExportLog"
                                ToolTip="把「日志」框里的内容存成 txt（构建失败时把这份发我，能直接看出卡在哪一步）。"/>
                        <Button Content="复制日志" Padding="10,4" Margin="6,0,0,0" Click="OnCopyLog"
                                ToolTip="把日志复制到剪贴板，直接粘贴给我。"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#0A7"
                                   Text="{Binding CatalogStatus}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="校验结果" Margin="0,0,0,8">
                        <ListBox x:Name="IssueList" ItemsSource="{Binding Issues}"/>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="日志">
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
