<Window x:Class="Sts2CharForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sts2CharForge.App"
        xmlns:profile="clr-namespace:Sts2CharForge.Core.Profile;assembly=Sts2CharForge.Core"
        Title="Sts2CharForge —— 杀戮尖塔2 自定义角色生成器" Height="880" Width="1420"
        MinWidth="960" MinHeight="600"
        Icon="waku.ico"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ===== 锻造页：按选中物品的类型自动换属性编辑器（绑定的都是同一个模型对象） ===== -->

        <!-- 锻造卡牌：**不出现**「费用」与「升级后 X + 1」（需求：不需要填入费用和「升级后x+1」） -->
        <DataTemplate DataType="{x:Type profile:CardSpec}">
            <StackPanel>
                <TextBlock Text="卡牌名称" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="类型" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding CardTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding CardType}"/>
                <TextBlock Text="稀有度" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding CardRarityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Rarity}"/>
                <TextBlock Text="英文类名（留空 = 自动生成）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="加入卡池（可被奖励/商店抽到）" Style="{StaticResource Check}" IsChecked="{Binding InCardPool}"/>
                        <!-- V0.2.284（用户要求）：回合结束时自动打出这张牌自己 -->
                        <CheckBox Style="{StaticResource Check}" Content="回合结束时自动打出这张牌（只在自己回合结束、且它还在手牌里时）"
                                  IsChecked="{Binding AutoPlayAtTurnEnd, Mode=TwoWay}"
                                  ToolTip="勾上：你的回合结束时，如果这张牌还在手牌里，就自动把它打出一次（目标取可打的第一个敌人）。&#10;打出去它就进弃牌堆，不会自己循环；被消耗 / 已经打出过的不会重复触发。"/>
                <TextBlock Text="卡牌关键字" Style="{StaticResource Label}" FontWeight="Bold" Margin="0,8,0,0"/>
                <WrapPanel>
                    <CheckBox Content="消耗" Style="{StaticResource Check}" IsChecked="{Binding Exhausts}"/>
                    <CheckBox Content="虚无" Style="{StaticResource Check}" IsChecked="{Binding Ethereal}"/>
                    <CheckBox Content="固有" Style="{StaticResource Check}" IsChecked="{Binding Innate}"/>
                    <CheckBox Content="保留" Style="{StaticResource Check}" IsChecked="{Binding Retain}"/>
                    <CheckBox Content="不能被打出" Style="{StaticResource Check}" IsChecked="{Binding Unplayable}"/>
                    <CheckBox Content="奇巧" Style="{StaticResource Check}" IsChecked="{Binding Sly}"/>
                    <CheckBox Content="永恒" Style="{StaticResource Check}" IsChecked="{Binding Eternal}"/>
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           Text="费用与「升级后 X + 1」不在这里填 —— 它们由右边那块布上的【触发时机】/【能量】模块决定。"/>
            </StackPanel>
        </DataTemplate>

        <!-- 锻造药水 -->
        <DataTemplate DataType="{x:Type profile:PotionSpec}">
            <StackPanel>
                <TextBlock Text="药水名称" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="稀有度" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding PotionRarityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Rarity}"/>
                <TextBlock Text="使用时机" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding PotionUsages, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Usage}"/>
                <TextBlock Text="目标" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding PotionTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding TargetType}"/>
                <TextBlock Text="英文类名（留空 = 自动生成）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="加入药水池（可被掉落/商店抽到）" Style="{StaticResource Check}" IsChecked="{Binding InPotionPool}"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           Text="效果由右边那块布上的节点图决定。"/>
            </StackPanel>
        </DataTemplate>

        <!-- 锻造遗物 -->
        <DataTemplate DataType="{x:Type profile:RelicSpec}">
            <StackPanel>
                <TextBlock Text="遗物名称" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="稀有度" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding RelicRarities, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Rarity}"/>
                <TextBlock Text="英文类名（留空 = 自动生成）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="作为初始遗物" Style="{StaticResource Check}" IsChecked="{Binding IsStartingRelic}"/>
                <CheckBox Content="加入遗物池（可被奖励/商店抽到）" Style="{StaticResource Check}" IsChecked="{Binding InRelicPool}"/>
                <TextBlock Text="触发时机（节点图里还有「当遗物被点击时」「血量低于 N」这些）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                          ItemsSource="{Binding RelicTriggers, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValue="{Binding Trigger}"/>
                <!-- V0.2.267：锻造遗物这边也要能选「层数变化方向」——
                     用户报「触发时机『某个状态层数变化后』没看到『层数变化方向』」，
                     原因就是以前只加在了遗物页 / 状态页的多时机编辑器里，这个模板漏了。 -->
                <StackPanel Visibility="{Binding ShowTriggerPowerDirection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="层数变化方向（只在「某个状态层数变化后」用得到）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                    <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Display" SelectedValuePath="Id"
                              ItemsSource="{Binding TriggerDirections, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding TriggerPowerDirection}"
                              ToolTip="上升 / 下降都算（默认，老行为）／只在上升时触发／只在下降时触发。&#10;盯的是哪个状态，在右边节点图的【触发时机】那一栏里配。"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 「转化为先古卡」配对表里的一行。放在**窗口**资源里而不是 App.xaml：那样 Click 才绑得到
             本窗口的处理器（App.xaml 里的模板里写 Click 会被解析成 App 的方法 → CS1061）。 -->
        <DataTemplate x:Key="AncientPairingRow">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="•" Foreground="#888"/>
                <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                          ItemsSource="{Binding AncientGroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding Row.Group, Mode=TwoWay}"
                          DropDownOpened="OnAncientRowDropDownOpened"/>
                <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" Foreground="#888"/>
                <TextBlock Grid.Column="3" Margin="4,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding PoolText}" Foreground="#555"/>
                <Button Grid.Column="4" Content="删除" Padding="8,2" Margin="6,0,0,0"
                        Click="OnRemoveAncientRow"/>
            </Grid>
        </DataTemplate>
        <!-- 「转化为先古卡」的配对表（放在**窗口**资源里：App.xaml 的模板里写 Click 会被解析成
             App 的方法 → CS1061；窗口资源里的 Click 才绑得到本窗口的处理器）。 -->
        <!-- ⭐ 公式的「可用量」清单（用户报「参数监听那几个量找不到在哪」）：
             放在**窗口**资源里、由 App.xaml 的卡牌模板用 DynamicResource 引用 ——
             一处定义，数值公式 / 次数公式 / 条件数值公式三块共用一个外观；数据源是本体的内置只读量清单
             （FormulaBuiltins.All，界面和生成端同一份，不会两套漂移）。 -->
        <DataTemplate x:Key="AncientPairingEditor">
            <GroupBox Header="配对表：每一行 = 一个「组」→ 换成哪几张先古卡" Margin="0,8,0,0"
                      Visibility="{Binding IsAncientTranscend, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="4">
                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11"
                               Text="左边选一个「组」（组在「自定义参数 / 组」页里建、在「卡牌」页给牌勾上），右边勾先古卡 —— 这一组里每张牌按勾选顺序各拿一张不同的先古卡；先古卡勾少了，多出来的牌保持原样（不重复）。升级和附魔会跟着带过去（和本体「古老牙齿」一致）。"/>
                    <ItemsControl Margin="0,6,0,0"
                                  ItemsSource="{Binding AncientRowItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{DynamicResource AncientPairingRow}">
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#A00" FontSize="11"
                               Text="{Binding AncientRowHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="＋ 加一行" Padding="10,3" Click="OnAddAncientRow"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Text="先古卡池（勾上的就是「换成哪些」）" Style="{StaticResource Label}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Text="给每一行勾先古卡：展开上面某一行的「组」下拉（或者直接点它），下面这些勾选就写进那一行。"/>
                    <ItemsControl Margin="0,2,0,0"
                                  ItemsSource="{Binding AncientCardRows, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Check}" Margin="0,2,14,2"
                                          Content="{Binding Name}" ToolTip="{Binding Hint}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
        </DataTemplate>
        <!-- 「转化为先古遗物」的两栏（源遗物筛选 + 目标遗物）。放在窗口资源里：Click 才绑得到本窗口。 -->
        <DataTemplate x:Key="AncientRelicSwapEditor">
            <GroupBox Header="转化为先古遗物（拾起时把身上的一个遗物换成另一个，位置不变）" Margin="0,8,0,0"
                      Visibility="{Binding IsAncientRelicSwap, Converter={StaticResource BoolToVis}}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="要换掉哪个遗物" Style="{StaticResource Label}" MinWidth="96"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Pick}"
                              ItemsSource="{Binding RelicSwapFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding SpawnFilter}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="换成哪只遗物" Style="{StaticResource Label}" MinWidth="96"/>
                    <local:SearchComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding RelicSwapTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id" SelectedValue="{Binding SpawnCardId}"
                                          SearchPath="Display"
                                          ToolTip="可以打字搜索（自己的遗物 + 本体全部遗物）">
                        <local:SearchComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                        </local:SearchComboBox.ItemTemplate>
                    </local:SearchComboBox>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <!-- ===== 效果栏版式（V0.2.144：遗物 / 药水 / 额外资源量三页右侧 = 卡牌页那一种）=====
             用户原话：「遗物药水右侧的效果栏能不能同步卡牌的」→ 拍板 A：照卡牌页版式重做。

             形状（三个页面右侧，与卡牌页同一个形状）：
               上面 = 一条固定高度（140px）的**一行摘要列表**
                      （卡牌页 `DisplayMemberPath="Display"`；这三页用 `DisplayPlain` ——
                       它们不能升级，摘要里不显示「（升级 +N）」那种括号）；
               中间 = 8px 间隔；
               下面 = 一整块**共享编辑区**（`DataContext="{Binding SelectedItem, ElementName=XXXEffectList}"`，
                      没选中任何效果时整块收起、只留一句指路文字），
                      里面引的就是原来那套编辑器模板（EffectEditorPlain / EffectEditorPotion），一个字都没重写。
                      **单条效果自己的「条件选项」就在这块编辑区里**（以前三页是右下角单独一块，已撤）。

             ⚠ 为什么不再用「折叠行（整行是 Button、点开才展开）」那一套（V0.2.137 的做法，已删）：
               ① 版式和卡牌页不一致（用户这一轮就是要求一致）；
               ② 整行是一颗 Button 会在冒泡阶段吃掉 MouseLeftButtonDown → 外层 ListBoxItem 选不中
                  → 绑 SelectedItem 的条件编辑器写进空对象、静默丢失（V0.2.143 修过一次；
                  现在行就是普通 ListBoxItem，这个坑从结构上不会再出现）；
               ③ 「单条效果的条件」以前单独摆在右下角一块里，现在跟着每条效果长在编辑区里（和卡牌页一样）。
               于是 OnToggleEffectRow / SelectEffectRowOf / ToggleEffectRow / EffectSpec.IsExpanded 全删了。 -->
    </Window.Resources>
    <!-- 整窗内容都挂在 RootsPanel 上：V0.2.240 给它加一个 LayoutTransform 缩放，
         小屏幕（1366×768 / 1280×720）上不再「有地方被窗口边裁掉」。
         ⚠ 必须是 LayoutTransform（不是 RenderTransform）：LayoutTransform 会一起参与布局测量，
         缩放后 WPF 认为内容只需要那么点地方 —— 于是不会被裁、滚动条也不会凭空出现。 -->
    <DockPanel x:Name="RootPanel">

        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新建配置" Padding="10,4" Margin="2" Click="OnNewProfile"/>
                <Button Content="打开配置…" Padding="10,4" Margin="2" Click="OnOpenProfile"/>
                <Button Content="保存配置" Padding="10,4" Margin="2" Click="OnSaveProfile"
                        ToolTip="直接保存进当前这个存档文件（不再弹路径选择）。若「模组 ID」和存档文件名不一样，会问一次要不要把存档名也改成 &lt;模组 ID&gt;.json；答「否」就仍然保存进原文件。想存成另一个文件请用「配置存档」页的「另存为新存档…」"/>
                <Separator Margin="8,0"/>
                <Button Content="① 一键生成 · 构建 · 安装" Padding="12,4" Margin="2" FontWeight="Bold"
                        ToolTip="按当前配置重新生成工程 → 编译 → 导出 PCK → 安装到安装目录（后台执行，界面不会卡住）"
                        Click="OnBuildInstall"/>
                <Button Content="仅生成工程（不编译）" Padding="10,4" Margin="2"
                        ToolTip="只把 C#/资源工程写到输出目录，方便用 Rider 打开查看" Click="OnGenerate"/>
                <Separator Margin="8,0"/>
                <TextBlock Text="安装目录：" VerticalAlignment="Center"/>
                <TextBox Width="380" VerticalAlignment="Center" Padding="3"
                         Text="{Binding Profile.Paths.InstallDir, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="选择…" Padding="8,4" Margin="4,0" Click="OnPickInstallDir"/>
                <Separator Margin="8,0"/>
                <!-- V0.2.240（用户反馈「屏幕小的时候有些地方被遮挡」）：整窗缩放。
                     小屏启动时会自动挑一档（见 MainWindow.FitWindowToScreen），这里也能手动改。
                     缩放走 RootPanel.LayoutTransform，所以布局也跟着变 —— 不是把画面糊掉那种缩放。 -->
                <TextBlock Text="界面缩放：" VerticalAlignment="Center"/>
                <ComboBox x:Name="UiScaleBox" Width="86" VerticalAlignment="Center" Padding="4,2"
                          SelectionChanged="OnUiScaleChanged"
                          ToolTip="整窗等比缩放（布局也会跟着缩，文字不糊）。&#10;小屏幕会自动选一档：高 ≥ 1000 → 100%；≥ 900 → 100%；≥ 800 → 90%；≥ 700 → 80%；更矮 → 70%（窄屏还会再降一档）。&#10;手动选过之后会记住（存在 %LOCALAPPDATA%\Sts2CharForge\ui-scale.txt）。"/>
            </StackPanel>
        </Border>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <!-- 左下角：卡牌数量统计（攻击 / 技能 / 能力 + 总数），一直能看到，改完立刻更新 -->
            <StatusBarItem>
                <TextBlock Text="{Binding CardCountText}" Foreground="#333" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding StatusText}"/></StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="6">

            <!-- ============ 角色 ============ -->
            <TabItem x:Name="RoleTab" Header="角色">
                <!-- V0.2.160：表单网格 + 下面那几块长说明**分成两层**。
                     以前长说明就在网格里（`ColumnSpan="3"` / `"4"` + 自动换行），它们「想要整幅宽度」，
                     WPF 的 Grid 会把这份宽度摊到被跨越的列上 ⇒ 两个输入列被撑成**各 1366px**，
                     第 4 列「角色显示名」被推到窗口外面（表单右边 3125 / 可视区右边 1395）；
                     而外层 ScrollViewer 的横向滚动默认是**关**的 ⇒ 看不见也点不到（用户实测报的就是这个）。
                     现在：网格只放「标签 + 输入框」，列宽改成 `Auto / *`（星号列按窗口伸缩、有下限），
                     长说明挪到网格**外面**的 StackPanel 里 —— 再怎么长都挤不到表单列。 -->
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="220"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <!-- V0.2.172：第 10 行（角色最大能量）—— 只加一行，已有 0~8 行一个都没动 -->
                                <RowDefinition Height="Auto"/>
                                <!-- V0.2.230：第 11 行（地图画线颜色 / 蜡笔） -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模组 ID" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.ModId, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="模组显示名" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding Profile.ModDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="角色英文类名" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.CharacterClass, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="角色显示名" Style="{StaticResource Label}"/>
                        <TextBox x:Name="RoleDisplayNameBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding Profile.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="初始生命" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.StartingHp, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="初始金币" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding Profile.StartingGold, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="性别" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding Genders}" SelectedItem="{Binding Profile.Gender}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="攻击/施法动画延迟" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                            <TextBox Width="70" Style="{StaticResource Field}" Text="{Binding Profile.AttackAnimDelay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="70" Style="{StaticResource Field}" Text="{Binding Profile.CastAnimDelay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="作者 / 版本" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="140" Style="{StaticResource Field}" Text="{Binding Profile.Author, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="90" Style="{StaticResource Field}" Text="{Binding Profile.Version, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="角色描述" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                 Style="{StaticResource Field}" Text="{Binding Profile.Description, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="死亡描述文本" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Height="44" AcceptsReturn="True" TextWrapping="Wrap"
                                 Style="{StaticResource Field}" Text="{Binding Profile.DeathText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="死亡结算画面上、角色立绘下面那句带引号的话（例：被 X 打败了）。本体的那句是按遭遇/放弃/假胜利随机取的通用文案，没有「每个角色一句」的键 —— 工具会打补丁把它换成你写的这句（只对你的角色生效）。"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="阵亡后台词" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Height="44" AcceptsReturn="True" TextWrapping="Wrap"
                                 Style="{StaticResource Field}" Text="{Binding Profile.DeadBanterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="自己阵亡的那一刻冒出的对话气泡（3 秒）。本体原本只有「角色名.banter.dead.endTurnPing」这个键，而它只在联机「回合结束 ping」时才会显示 —— 单人游戏永远看不到，所以工具额外在阵亡瞬间用它冒一个气泡。"/>

                        <!-- V0.2.173（用户要求）：删掉「（和先古之民/建筑师的对话）→ 已移到「先古之民」页」
                             那两行占位说明（那栏早就不在这里了，留着只是噪音）。 -->
                        <!-- V0.2.172（用户要求「增加角色最大能量」）：每回合的能量上限。
                             本体 CharacterModel.MaxEnergy 默认 3；这里不是 3 时生成端才写 override，
                             是 3 的时候一个字都不写（老存档 / 基线逐字不变）。 -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="角色最大能量" Style="{StaticResource Label}"/>
                        <TextBox x:Name="MaxEnergyBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding Profile.MaxEnergy, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="每回合的能量上限，本体默认 3。生成的角色类里只在不是 3 的时候写 public override int MaxEnergy => N;（本体 Player 建号时取的就是它，不需要任何补丁）。"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="4,0,0,0"
                                   Text="每回合的能量上限，本体默认 3；留 3 = 不覆盖（生成结果和以前逐字一样）。改大 / 改小都会明显改难度。"/>

                        <!-- V0.2.230（用户要求「能不能自定义在地图上的蜡笔的颜色」）：
                             地图上画线的那支「蜡笔 / 羽毛笔」的颜色。本体 NMapDrawings.CreateLine 里
                             `line2D.DefaultColor = player.Character.MapDrawingColor;`，默认黑色。 -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="地图画线颜色（蜡笔）" Style="{StaticResource Label}"/>
                        <DockPanel Grid.Row="9" Grid.Column="1">
                            <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0"
                                    BorderBrush="#999" BorderThickness="1"
                                    Background="{Binding Profile.MapDrawingColor, Converter={StaticResource HexBrush}}"/>
                            <TextBox x:Name="MapDrawingColorBox" Style="{StaticResource Field}"
                                     Text="{Binding Profile.MapDrawingColor, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="联机时在地图上画路线的那支「蜡笔」的颜色（RRGGBB，例：CB282B）。留空 = 本体默认黑色。本体每个角色都有自己的颜色：铁甲战士 CB282B / 静默猎手 2F6729 / 故障机器人 0D638C / 亡灵缚者 AC0486 / 摄政王 935206。"/>
                        </DockPanel>
                        <TextBlock Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="4,0,0,0"
                                   Text="在地图上画线用的颜色（联机时队友看到的就是这个颜色）。留空 = 本体默认黑色；6 位 RRGGBB（也能写 8 位带透明度）。"/>
                        </Grid>

                        <!-- 下面这几块是「长说明」：必须留在网格外面（见本页顶部的注释） -->
                        <TextBlock Text="生成调试日志" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Profile.DebugLog}"
                                  Content="打开「生成调试日志」（排查用：只影响日志，不影响游戏行为；排查完请关掉）"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="4,4,0,0"
                                   Text="默认关着。打开后重新生成，模组会在每条效果执行的地方往游戏日志里多打几行 [模组调试] …（游戏日志里是 [INFO] [模组调试] …）：写明「谁在跑（哪张牌 / 遗物 / 药水 / 状态 + 类名）、效果种类、目标是谁（名字 + 是不是自己）、执行前 / 执行后的数值」，其中「施加状态」会把**执行前**与**执行后**的层数各打一行 —— 目标身上本来没有这个状态时记「-」并标「本来没有这个状态」，已经有了就记真实层数（排查「填了 -2 层却不生效」这类问题就看这两行）。⚠ 加的都是「读一下、打一行」，不改任何游戏行为；但日志会变多，排查完请把这个勾去掉再重新生成一次。"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="6,10,0,0"
                                   Text="初始卡组里的「打击 ×5 + 防御 ×5」是「卡牌」页最上面那两条**你自己的卡**（英文类名固定成 Strike / Defend，因为本体没有这两个裸类名、不会撞 ID）：数值、升级、效果、卡面随便改，默认照抄本体（打击 1 费 6 伤害、防御 1 费 5 格挡，升级都 +3）。它们标了本体卡标签 Strike / Defend，所以本体那些「升级你的初始打击 / 防御」的遗物能认出它们；也不会进奖励 / 商店。"/>

                        <!-- V0.2.173（用户要求）：删掉「召唤伙伴 / 伙伴攻击的配置已经搬到「召唤物」选项卡」
                             那段占位说明（早就搬完了，留着只是噪音）。 -->
                        <!-- V0.2.172 加了这一栏，但**绑错了数据**（绑到了宝箱房那句「开抢！！！」）。
                              V0.2.173 按用户澄清改正：「多人催促文本」= 联机时右下角那个 Ping 按钮按下去
                             冒出的对话气泡（本体键 characters.<角色>.banter.alive.endTurnPing）
                             —— 和宝箱房那句毫无关系，现在绑 Profile.EndTurnPingText；
                             宝箱房那句仍然在「美术」页那个框（Profile.Art.TreasureFightText）。 -->
                        <TextBlock Text="多人催促文本（联机时右下角「Ping」按钮按下去冒出的那句）" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                        <TextBox x:Name="RoleEndTurnPingTextBox" Height="44" AcceptsReturn="True" TextWrapping="Wrap"
                                 Style="{StaticResource Field}" Text="{Binding Profile.EndTurnPingText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="联机战斗里，你结束回合之后只要还有别人没结束回合，屏幕右下角就会滑出一个「Ping」按钮；按一下，所有玩家都会在你头上看到一句 1.5 秒的对话气泡 —— 那句话就是这里填的（本体键：characters 表的 &lt;你的角色&gt;.banter.alive.endTurnPing；每个本体角色都有一句：铁甲战士「Make haste.」/ 静默猎手「...」）。留空 = 沿用工具默认的「……继续。」。这一栏不需要任何补丁，就是我们自己角色本地化表里的一行。⚠ 它和「美术」页那句宝箱房「开抢！！！」不是一回事。"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="4,4,0,0"
                                   Text="联机时右下角「Ping」按钮按下去，别人会在你头上看到这句（1.5 秒的对话气泡）。留空 = 沿用默认那句「……继续。」；宝箱房抢遗物那句「开抢！！！」在「美术」页那个框里，两者互不相干。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 召唤物（列表 + 右侧详情；类似「药水」页的结构） ============ -->
            <TabItem x:Name="SummonTab" Header="召唤物">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="添加召唤物" Padding="8,4" Margin="0,0,6,0" Click="OnAddSummon"/>
                            <Button Content="删除" Padding="8,4" Click="OnRemoveSummon"/>
                            <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding MultiSelectSummons, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ToolTip="Ctrl / Shift 点选本来就能多选（Ctrl+A 全选）；打开这个开关后**直接点列表行**就能加选（不用按 Ctrl），右侧会出现「全选」"/>
                            <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllSummons"
                                    Visibility="{Binding MultiSelectSummons, Converter={StaticResource BoolToVis}}"
                                    ToolTip="选中列表里的全部召唤物"/>
                            <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoSummon"
                                    IsEnabled="{Binding CanUndoSummon}" ToolTip="{Binding UndoSummonHint}"/>
                        </WrapPanel>
                        <ListBox x:Name="SummonList" SelectionMode="{Binding MultiSelectSummons, Converter={StaticResource MultiSelectMode}}" ItemsSource="{Binding Profile.Summons}" DisplayMemberPath="Display"/>
                    </DockPanel>
                    <TextBlock x:Name="SummonEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择召唤物（或点左边的「添加召唤物」）"
                               Visibility="{Binding SelectedItem, ElementName=SummonList, Converter={StaticResource EmptyToVisibility}}"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedItem, ElementName=SummonList}"
                                  Visibility="{Binding SelectedItem, ElementName=SummonList, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="召唤物属性" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                       Text="走的是本体的通用宠物 API（PlayerCmd.AddPet&lt;T&gt;），模型由本体自动注册，所以不需要任何 Harmony 补丁。宠物每场战斗都要重新召唤 —— 本体的 PlayerCombatState 在战斗结束时会清空宠物，它不跨战斗、也不进存档。这里可以配多只，同一场战斗里都在场：卡牌 / 遗物的效果里选「召唤伙伴 / 伙伴攻击」时会让你挑是哪一只，下拉里那条「★ 全部召唤物」= 这条效果对**每一只启用的**各算一次（每只自己判在不在场，不在场的自动跳过）。"/>
                            <CheckBox Style="{StaticResource Check}" Content="启用这只召唤物"
                                      IsChecked="{Binding Enabled}"
                                      ToolTip="勾上以后：生成它的 MonsterModel 子类 + 召唤命令、写 monsters.json 里它的名字；效果里的「召唤物」下拉才会列出它。"/>
                            <TextBlock Text="名字（宠物名牌）" Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="英文类名（留空 = 自动 &lt;角色类名&gt;Pet / Pet2 …）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="召唤时的生命（必须大于 0）" Style="{StaticResource Label}"/>
                            <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource Field}" Text="{Binding Hp, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="站位距离（摆在主人右边多远，单位像素）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource Field}" Text="{Binding StandDistance, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,2,0,0"
                                       Text="本体的奥斯提是 150~250，默认 110。"/>
                            <CheckBox Style="{StaticResource Check}" Content="替主人承伤（守卫：主人受可格挡攻击时改由它承担）"
                                      IsChecked="{Binding TakesDamageForOwner}"
                                      ToolTip="挂一个照本体 DieForYouPower 写的守卫状态：主人的**可格挡攻击伤害**改由它承担；中毒 / 失去生命这类穿盾伤害照旧打在主人身上。可以给多只召唤物都勾上 —— 实际承伤的是召唤物列表里**第一只活着的**，它死后自动换下一只。本体的伤害重定向是链式遍历，所以由生成代码自己仲裁，行为是确定的（不依赖本体的监听顺序）。"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,2,0,0"
                                       Text="「替主人承伤」可以勾多只（不再是错误，校验器只给一句提示）：承伤的是召唤物列表里第一只活着的，它死后自动换下一只。本体的伤害重定向 Hook.ModifyUnblockedDamageTarget 是链式遍历，直接靠本体排会变成「谁先监听谁生效」，所以我们生成一个共用的守卫类、在钩子里自己仲裁。"/>
                            <TextBlock Text="宠物图片（可空）" Style="{StaticResource Label}"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left" Content="选择图片…" Padding="10,3" Margin="0,0,6,0" Click="OnPickSummonImage"/>
                                <Button DockPanel.Dock="Left" Content="清除" Padding="10,3" Margin="0,0,6,0" Click="OnClearSummonImage"/>
                                <TextBox Style="{StaticResource Field}" IsReadOnly="True" Text="{Binding Image, Mode=OneWay}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Width="110" Height="110" BorderBrush="#999" BorderThickness="1" Background="#22FFFFFF">
                                    <Image Margin="2" Stretch="Uniform"
                                           Source="{Binding SelectedSummonImagePreview, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border>
                                <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Width="520" Foreground="#888"
                                           Text="建议竖版 PNG、带透明背景（越高越会被自动缩到约 220 像素高，底边贴地面线）。上传了就会生成 scenes/creature_visuals/&lt;召唤物 entry&gt;.tscn 并让它用它；不传也能跑，它会用本体的占位图（一张静态 error.png）。"/>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666"
                                       Text="怎么让它上场：① 卡牌页新建一张牌，加一条效果选「召唤伙伴」（数值 0 = 用上面这个血量），并在「召唤物（哪一只）」里选中它；② 或者遗物页加一条「召唤伙伴」并把触发时机选成「战斗开始时」（= 本体 Byrdpip 的写法，每场战斗开场就召唤）。指挥它打人：卡牌效果里选「伙伴攻击」并选中同一只，伤害由它承担（它不在场时这张牌会跳过这一条，不会报错）。想让一条效果对每只都生效（例：开场把三只全召出来、或让每只都替你承伤），在「召唤物（哪一只）」里选「★ 全部召唤物」即可 —— 生成时会按每只各写一份代码。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 额外资源量（V0.2.127 起页头去掉「/状态」）============ -->
            <!-- 页头按需求改名为「额外资源量」（原「额外资源量/状态」）：用户原话「额外资源量/状态页改名为额外资源量页」。
                 ⚠ 改名要**全局一致**：MainWindow.xaml.cs 里所有 SelectTabRoot("额外资源量") / 选项卡顺序断言
                 都跟着改（改名后自检必须仍然 PASS）。 -->
            <TabItem x:Name="ExtraResourceTab" Header="额外资源量">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" MinWidth="420"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左：额外资源量本体（数量 / 上限 / 继承 / 显示名 / 描述 / 图标）+ 那只隐藏起始遗物（用户要求：
                         「增加选择是否隐藏额外资源量遗物的选项」= 那个勾选框，V0.2.113 就有了，这里只是保证它还在、绑得对）。 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,0,6,0" DataContext="{Binding Profile.ExtraResource}">
                        <TextBlock Text="额外资源量（和能量一样是个计数器，显示在血条下方、与状态同一行）"
                                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#777"
                                   Text="说明：本体没有「自定义资源」这种扩展点，所以额外资源量做在本体已有的「资源计数器」上——位置是本体的，开启后会自动多一个隐藏的起始遗物来发放数量（它不占玩法位置）。图标和名字可以换成你自己的（见下面）。"/>
                        <CheckBox Margin="0,14,0,0" Style="{StaticResource Check}"
                                  Content="启用额外资源量" IsChecked="{Binding Enabled}"/>

                        <TextBlock Margin="0,12,0,0" Text="初始数量（每场战斗开始时发放的数量）" Style="{StaticResource Label}"/>
                        <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource Field}"
                                 Text="{Binding Initial, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,2,0,0" Text="填 0 = 开场不发放（只靠卡牌/遗物/药水获得）" Foreground="#888"/>

                        <TextBlock Margin="0,12,0,0" Text="数量上限（0 = 不限，和本体一样）" Style="{StaticResource Label}"/>
                        <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource Field}"
                                 Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888"
                                   Text="本体没有上限（数量想涨多少涨多少），这条是我们加的：涨到上限就不再增加（溢出的部分直接不加）。效果里的「增加额外资源量上限值」可以在战斗中把这个上限再抬高（每场战斗结束清掉加成，回到这里填的基础值）。"/>

                        <CheckBox Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="跨战斗继承（下一场开场数量 = 初始数量 + 上一场结束时剩下的）"
                                  ToolTip="只在**当前这一局**里继承：下一局重新开始时归零。&#10;存的是这只载体遗物的一个 [SavedProperty] 属性（本体自己的存档 + 联机同步机制），所以多人联机时每个玩家各算各的、不会互相串。"
                                  IsChecked="{Binding CarryOver}"/>
                        <TextBlock Margin="24,2,0,0" Text="不勾选：每场战斗开始都固定发放初始数量，战斗结束清空。勾选时也只在**这一局**内继承（换一局归零）" Foreground="#888"/>

                        <CheckBox Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="始终显示计数器（不勾选时只在数量大于 0 时显示）"
                                  IsChecked="{Binding AlwaysShowCounter}"/>

                        <TextBlock Margin="0,22,0,4" Text="显示名（中文名，留空 = 沿用本体的「辉星」）"
                                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBox Width="220" HorizontalAlignment="Left" Style="{StaticResource Field}"
                                 TextChanged="OnExtraResourceNameChanged"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888"
                                   Text="换了名字后：计数器下方、鼠标悬停提示、卡面描述（「获得 2 点××」）、条件说明（「拥有××至少 4 点」）都会用这个名字。建议 2~4 个字（计数器下那条比较窄）。"/>
                        <CheckBox Margin="0,8,0,0" Style="{StaticResource Check}"
                                  Content="在计数器下方显示名字（不勾选 = 只在鼠标悬停提示里显示）"
                                  IsChecked="{Binding ShowName}"/>

                        <TextBlock Margin="0,22,0,4" Text="自定义描述（留空 = 用工具自动写的那段）"
                                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBox Style="{StaticResource Field}" MinHeight="66" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="鼠标悬停那个计数器时弹出来的那段话。留空 = 工具自动写「&lt;名字&gt;：每场战斗开始时获得 N 点…」；填了就原样用它（上传了图标的话，这段文字前面会自动补上那张 24×24 的内联小图，除非你自己已经写了 [img]）。"/>
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#888"
                                   Text="这段只出现在**你自己的角色**的计数器上（补丁按「这个计数器归谁」判断），联机时别人看到的还是他自己的。"/>

                        <TextBlock Margin="0,22,0,4" Text="自定义图标（留空 = 沿用本体的星星图标）"
                                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Content="选择图片…" Padding="10,3" Margin="0,0,6,0"
                                    Click="OnPickExtraResourceIcon"/>
                            <Button DockPanel.Dock="Left" Content="清除" Padding="10,3"
                                    Click="OnClearExtraResourceIcon"/>
                            <TextBox Style="{StaticResource Field}" IsReadOnly="True"
                                     Text="{Binding Icon, Mode=OneWay}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="72" Height="72" BorderBrush="#999" BorderThickness="1" Background="#22FFFFFF">
                                <Image Margin="2" Stretch="Uniform"
                                       Source="{Binding ExtraResourceIconPreview, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                            <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Width="360" Foreground="#888"
                                       Text="建议方形 PNG（128×128 或 256×256）带透明背景：本体的计数器是个 128×128 的方框，非方图会上下留白。换图之后本体星星的两层旋转光效会被隐藏。"/>
                        </StackPanel>

                        <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#666"
                                   Text="在「卡牌 / 遗物 / 药水」的效果里可以选「获得额外资源量」：正数 = 获得，负数 = 花费。卡牌上的花费会写成这张牌的额外资源量费用——当前数量不够时，本体自带的判定会让这张牌直接打不出去（卡面费用数字显示成红色）。"/>

                        <!-- ===== 额外资源量那只**隐藏的起始遗物**（用户要求：这一页要能看到它、能加效果、
                                     能勾「在游戏中隐藏」）=====
                             用户第 11 批 ① 的原话是「遗物页去除左上角关于额外资源量的内容」+「增加选择是否隐藏
                             额外资源量遗物的选项」——那一整块于是从**遗物页左上角搬到了这里**（它本来就属于
                             「额外资源量」这一页）。它不在遗物页那张列表里（那张表只列你自己配的遗物）。 -->
                        <GroupBox Margin="0,22,0,0" Header="额外资源量遗物（自动生成的隐藏起始遗物）"
                                  Visibility="{Binding ExtraResourceRelicVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,4"
                                           Text="这只遗物是勾了上面「启用额外资源量」之后自动生成的（稀有度「初始」、不占遗物栏的玩法位置）：它负责每场战斗开始时发放资源量、以及记录跨战斗继承。下面这些效果会挂在这只遗物的「战斗开始时」上。它不在「遗物」页那张遗物列表里（那张表只列你自己配的遗物）。"/>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#444" FontSize="11"
                                           Text="{Binding ExtraResourceRelicSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <CheckBox DockPanel.Dock="Top" Margin="0,0,0,2"
                                          Content="在游戏中隐藏（不显示在遗物栏里）"
                                          IsChecked="{Binding HideInGame}"
                                          ToolTip="这只遗物只是载体（开场发资源量 / 记跨战斗继承），不是藏品。&#10;勾上 = 生成一个补丁：遗物栏照常把它建出来（节点列表长度/顺序和 Player.Relics 一致），&#10;只是把它那个节点设成不可见 —— 纯视觉隐藏；&#10;发放资源量、跨战斗继承这些功能一个字都不变（存档也兼容）。"/>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,4"
                                           Text="{Binding HideInGameHint}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,2,0,0"
                                           Text="效果栏在右边：这一份效果就是那只载体遗物的效果（触发时机固定「战斗开始时」），只能有一份 —— 这里没有第二份数据。"/>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>

                        <!-- ============ 右 = 效果栏（用户要求第 1 条：「在右侧增加效果栏」）============
                             V0.2.144：照卡牌页版式 —— 上面一行摘要列表（140px）+ 下面一整块共享编辑区。
                             单条效果自己的「条件」跟着那条效果长在编辑区里（以前是右下角单独一块，已撤）。
                             最底：添加效果 / 删除效果 / 撤回删除
                             数据还是**同一份** Profile.ExtraResource.Effects（列表没选中任何遗物时，遗物页右边那块
                             也会借这一份显示 —— 靠选择互斥，见 OnExtraResourceEffectSelectionChanged）。 -->
                    <DockPanel Grid.Column="2" DataContext="{Binding Profile.ExtraResource}">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="添加效果" Padding="8,4" Margin="0,0,6,0" Click="OnAddEffect" Tag="{Binding ElementName=ExtraResourceEffectList}"/>
                            <Button Content="删除效果" Padding="8,4" Click="OnRemoveEffect" Tag="{Binding ElementName=ExtraResourceEffectList}"/>
                            <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCard"
                                    IsEnabled="{Binding CanUndoCard, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding UndoCardHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="效果栏：额外资源量遗物的效果（触发时机固定「战斗开始时」）" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <!-- 一行摘要列表：每行就是 EffectSpec.DisplayPlain（和卡牌页同一套写法，
                                 只是这里用 DisplayPlain —— 额外资源量遗物上的效果不能升级，列表里不显示
                                 「（升级 +N）」那种括号，和遗物 / 药水页同一个口径）。
                                 选中一条 → 下面那块共享编辑区立刻就是它（含它自己的「条件选项」）。
                                 ⚠ 以前每一行自己塞一整块编辑器，要靠 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 压住那个 8260px 的老坑；现在编辑器在下面那块共享区里，这个坑从结构上没有了 ——
                                 但「Disabled + Stretch + 摘要换行」这套还是留着：长摘要要在列表宽度里换行，
                                 不许横向跑出面板（V0.2.124 那条红线，自检里有断言）。 -->
                            <ListBox x:Name="ExtraResourceEffectList" Grid.Row="1"
                                     ItemsSource="{Binding Effects}" DisplayMemberPath="DisplayPlain"
                                     SelectionChanged="OnExtraResourceEffectSelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     ToolTip="挂在这只隐藏起始遗物上的效果（触发时机固定「战斗开始时」）。点一条 → 下面那块编辑区里改它（含这一条自己的条件）。">
                                <ListBox.Resources>
                                    <!-- DisplayMemberPath 生成的那个 TextBlock 没有显式 Style，所以这条隐式样式管得到它
                                         （长摘要就会在列表宽度里自动换行，而不是撑出一条横向滚动条）。 -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ListBox.Resources>
                            </ListBox>
                            <TextBlock Grid.Row="3" Margin="10,4" Foreground="#999" FontSize="12" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="点上面一条效果 → 就在这块里改它（含这一条效果自己的「条件选项」）"
                                       Visibility="{Binding SelectedItem, ElementName=ExtraResourceEffectList, Converter={StaticResource EmptyToVisibility}}"/>
                            <Border Grid.Row="3" x:Name="ExtraResourceEffectEditorBox" BorderBrush="#DDD" BorderThickness="1" Padding="6"
                                    DataContext="{Binding SelectedItem, ElementName=ExtraResourceEffectList}">
                                <!-- ⚠ 没选中任何效果时把内容收起来（见遗物页那一处同样的说明）。 -->
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPlain}"
                                                Visibility="{Binding SelectedItem, ElementName=ExtraResourceEffectList, Converter={StaticResource NotEmptyToVisibility}}"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ 卡牌 ============ -->
            <TabItem Header="卡牌">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <GroupBox DockPanel.Dock="Top" Header="卡牌配色（整个角色生效）" Margin="0,0,0,8">
                            <StackPanel DataContext="{Binding Profile.Colors}">
                                <TextBlock Text="配色预设" Style="{StaticResource Label}"/>
                                <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Name"
                                          ItemsSource="{Binding PresetItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding PresetSelection, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="卡牌边框" Style="{StaticResource Label}"/>
                                <ComboBox Style="{StaticResource Pick}" DisplayMemberPath="Name"
                                          ItemsSource="{Binding FrameItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding FrameSelection, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="卡牌边框颜色（RRGGBB，留空 = 用上面的边框）" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0"
                                            BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding CardFrameColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding CardFrameColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Text="牌堆底色（RRGGBB）" Style="{StaticResource Label}"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0"
                                            BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding DeckEntryColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding DeckEntryColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Text="能量图标描边（RRGGBB）" Style="{StaticResource Label}"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="26" Margin="6,0,0,0"
                                            BorderBrush="#999" BorderThickness="1"
                                            Background="{Binding EnergyOutlineColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding EnergyOutlineColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                                           Text="对应本体的卡池配色：边框材质 materials/cards/frames/&lt;框色&gt;_mat.tres、牌堆底色、能量图标描边。只影响外观配色。"/>
                            </StackPanel>
                        </GroupBox>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="添加卡牌" Padding="8,4" Margin="0,0,6,0" Click="OnAddCard"/>
                            <Button Content="＋打击/防御" Padding="8,4" Margin="0,0,6,0" Click="OnAddVanillaBasics"
                                    ToolTip="把初始卡组用的「打击 ×5 / 防御 ×5」补回列表最上面。它们是你自己的卡（英文类名固定 Strike / Defend，数值默认照抄本体），标了本体卡标签 Strike / Defend —— 本体那些「升级你的初始打击 / 防御」的遗物就是按这个标签认牌的"/>
                            <Button Content="复制" Padding="8,4" Margin="0,0,6,0" Click="OnCopyCard"/>
                            <Button Content="删除" Padding="8,4" Click="OnRemoveCard"/>
                            <ToggleButton Content="多选" Style="{StaticResource MultiToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding MultiSelectCards, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ToolTip="Ctrl / Shift 点选本来就能多选（Ctrl+A 全选）；打开这个开关后**直接点列表行**就能加选（不用按 Ctrl），右侧会出现「全选」"/>
                            <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="OnSelectAllCards"
                                    Visibility="{Binding MultiSelectCards, Converter={StaticResource BoolToVis}}"
                                    ToolTip="选中列表里的全部卡牌"/>
                            <Button Content="撤回删除" Padding="8,4" Margin="6,0,0,0" Click="OnUndoCard"
                                    IsEnabled="{Binding CanUndoCard}" ToolTip="{Binding UndoCardHint}"/>
                        </WrapPanel>
                        <!-- 用户要求第 1 条《卡牌页优化.md》：卡牌名最左侧是**序号列**（从上到下 1..N，
                             序号是位置号、不跟随卡牌移动），可以**拖动卡牌项**换位置；
                             自动生成的英文类名跟着这个序号走（见 Naming.RenumberCardClassNames）。
                             ⚠ 序号口径按用户拍板 Q5 = A：**列表里全部行都占号**。
                             ⚠ V0.2.140（用户对 V0.2.130 那次的更正，原话「不是说卡牌左侧的序号做的像遗物一样，
                             五个五个列，直接显示出来，比如只有一张卡时，有1-5序号，当有6张卡时，出现6到10序号」）：
                             列表改成**和遗物 / 药水页一模一样**的版式 ——
                             行数 = 5 × ceil(max(N,1)/5)（1 张 → 1~5 行；6 张 → 1~10 行；11 张 → 1~15 行），
                             多出来的行是**空槽**（SlotPlaceholder，只显示灰色序号、没有内容、选不中、但可当拖放落点）。
                             ItemsSource 绑的是 MainWindow.CardRows 这个**界面镜像集合**
                             （真卡 + 末尾空槽行）；真卡集合 Profile.Cards 仍是唯一事实来源。
                             诅咒卡 / 先古卡那两栏各自同理（CurseRows / AncientRows，前缀 Curse / Ancient）。 -->
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,4"
                                   Text="最左边的数字 = 这张卡**现在排第几位**（1..N，含最上面的本体卡 / 初始打击防御；拖动换位置后跟着重排）。序号每次多留 5 个：不够 5 张时后面几行是**灰色空槽**（拖卡牌过去就放到那个位置）；空槽不能被选中。自动生成的英文类名会跟着这个序号走（&lt;角色类名&gt;Card&lt;序号&gt;），手填的不会被改。诅咒卡 / 先古卡在各自那一页从 1 数，用 Curse / Ancient 前缀。"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="CardDragHint" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                   Text="拖动提示：按住某一行的文字往下/往上拖，会出现一条蓝线 —— 松手就插到那条线的位置。"/>
                        <ListBox x:Name="CardList" SelectionMode="{Binding MultiSelectCards, Converter={StaticResource MultiSelectMode}}"
                                 ItemsSource="{Binding CardRows}" DisplayMemberPath="{x:Null}"
                                 AllowDrop="True" PreviewMouseLeftButtonDown="OnCardListPreviewMouseDown"
                                 PreviewMouseMove="OnCardListPreviewMouseMove"
                                 DragOver="OnCardListDragOver" Drop="OnCardListDrop"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="CardRowRoot" ToolTip="{Binding RowTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CardRowOrdinal" Grid.Column="0" Text="{Binding OrdinalText}" FontWeight="Bold"
                                                   Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="CardRowName" Grid.Column="1" Text="{Binding Display}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 空槽行：只有灰色序号（卡名那一列整块收起来）。判据是接口上的 IsPlaceholder，
                                         真卡 = false、空槽 = true（见 SlotPlaceholder / ISlotRow）。 -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter TargetName="CardRowRoot" Property="ToolTip" Value="{x:Null}"/>
                                            <Setter TargetName="CardRowOrdinal" Property="Foreground" Value="#AAAAAA"/>
                                            <Setter TargetName="CardRowOrdinal" Property="FontWeight" Value="Normal"/>
                                            <Setter TargetName="CardRowName" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 没选中卡牌时：收起属性/效果栏，只留一句提示。
                         ⚠ V0.2.140：显隐判据和 DataContext 都改走窗口上的 HasCardSelection / CardUiSelection
                         —— 列表里现在有空槽行，绑 SelectedItem 的话点一下空槽就会把右侧整块收掉
                         （照遗物页 V0.2.125 / 药水页 V0.2.127 的写法：空槽行也算「选中了一行」，详情不清空）。 -->
                    <TextBlock x:Name="CardEmptyHint" Grid.Column="2" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择卡牌"
                               Visibility="{Binding HasCardSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCollapsed}}"/>

                    <!-- 锻造卡（名字带 *）：中间照常改属性，右边效果栏锁死（效果由锻造页的节点图决定，需求） -->
                    <TextBlock x:Name="CardForgedHint" Grid.Column="2" FontSize="13" Foreground="#7A5A00"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"
                               DataContext="{Binding CardUiSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                               Text="{Binding ForgeEditingHint}"
                               Visibility="Collapsed"/>

                    <Grid x:Name="CardDetail" Grid.Column="2" DataContext="{Binding CardUiSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding HasCardSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,6,0">
                        <StackPanel>
                            <!-- 卡牌属性标题右边就是「组」勾选框（需求：在卡牌属性名称右侧可以勾选进入组） -->
                            <WrapPanel Margin="0,0,0,2">
                                <TextBlock Text="卡牌属性" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="组：" Margin="16,0,4,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                <ItemsControl ItemsSource="{Binding CardGroupRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Check}" Content="{Binding Name}"
                                                      ToolTip="{Binding KeyHint}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <TextBlock Text="{Binding CardGroupRowHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                            <!-- 本体卡（打击 / 防御）：数值由本体决定，不能改 —— 只有「初始份数 / 作为初始牌」可用 -->
                            <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                    Visibility="{Binding IsVanillaCard, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Foreground="#7A5A00" FontSize="11"
                                           Text="这是本体卡（只做引用）：初始卡组里用它的本体英文类名，数值 / 效果 / 关键字都由本体决定，不能改。本体的模型 ID 只按类名算，自己再造一张同名的卡会让模组加载直接报 DuplicateModelException。可以改「初始份数」，也可以整条删掉。"/>
                            </Border>
                            <TextBlock Text="名称（中文，列表里显示用）" Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
