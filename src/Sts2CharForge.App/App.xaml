<Application x:Class="Sts2CharForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sts2CharForge.App">
    <Application.Resources>
        <local:HexToBrushConverter x:Key="HexBrush"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility"/>
        <local:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>
        <local:MultiSelectModeConverter x:Key="MultiSelectMode"/>
        <local:OkToBrushConverter x:Key="OkToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- V0.2.144：`BoolToText`（V0.2.137 给效果栏折叠行用）已随折叠行一起删除。 -->
        <!-- 「多选」开关：外观与其他按钮一致，按下（开启）时高亮，一眼能看出开没开 -->
        <Style x:Key="MultiToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="2" BorderThickness="1"
                                BorderBrush="#ADADAD" Background="#F5F5F5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFE4FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A6FB5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,4,6,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="4,3,4,3"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="Pick">
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>
        <Style TargetType="CheckBox" x:Key="Check">
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 效果编辑面板的公共部分。
             注意：「效果种类」那一行**不在这里**（见 EffectKindPicker）——
             「自定义状态」的触发器只能放「不需要卡牌上下文」的种类，那一处要用收窄过的候选表，
             而卡牌 / 遗物 / 药水照旧用全量。 -->
        <DataTemplate x:Key="EffectCommon">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <!-- V0.2.258：多加一行专门放「清除指定状态 → 或者清空一个组」。
                         以前我把它塞在「增益 / 减益」那一行的第 3 列，可这个网格只有 2 列 ——
                         第 3 列被折回第 2 列，结果和「目标状态」那个下拉叠在一起（用户报「重叠在一起了」）。 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 效果种类（全量）：卡牌 / 遗物 / 药水用这一份。
                     宠物类效果也在这里面 —— 12 个宠物效果都能直接选，选到宠物效果时
                     下面那个「召唤物（哪一只）」下拉会出现。 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="效果种类" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Pick}"
                          ItemsSource="{Binding Kinds, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Kind" SelectedValue="{Binding Kind}"/>

                <!-- 「数值」+「数值公式」：用户要求（V0.2.112）「效果那边只要保留公式就行，去掉数值框」——
                     支持公式的 5 种（伤害 / 格挡 / 失去生命 / 回复生命 / 施加状态）只留「数值公式」那一栏，
                     公式留空 = 0（不显示也不执行）；老存档里那 5 种的固定数值打开存档时**自动转成公式**，
                     所以不会丢配置。其余种类没有公式可用（数值必须在生成时定下来），「数值」框照旧显示。 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid Visibility="{Binding ShowAmountBoxNormal, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数值" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <!-- 锻造【效果】模块（V0.2.129）：同一栏，但**框里能直接写公式 / 参数** ——
                         这是 V0.2.128 给锻造数字框加的能力（用户拍板 Q2=A），合并编辑器之后必须保住。
                         只有锻造链（IsForgeChain）看得到它；卡牌 / 遗物 / 药水 / 自定义状态四处一个字都不变。 -->
                    <Grid Visibility="{Binding ShowForgeValueRows, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数值" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding ForgeAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="这一栏和「卡牌」页那个「数值」是同一件事；锻造图里**所有**效果种类都能直接写公式或参数：&#10;X = 当前所有能量，Y = 当前额外资源量，一个字母的自定义参数（「自定义参数 / 组」页里定义），以及内置只读量（Turn / HandCount / DiscardedThisTurn…，清单见模块下面那个「可用量」小框）。&#10;支持 + - * / % ( )、比较 &gt; &lt; &gt;= &lt;= == !=、逻辑 &amp;&amp; || !、三元 条件 ? 成立时 : 不成立时（布尔当数值用时真取 1、假取 0），以及 .NET 的 Math 函数（min/max/abs/sign/clamp/floor/ceiling/round/truncate 直接写，pow/sqrt/cbrt/exp/log/log10/log2/sin/cos/tan/asin/acos/atan/atan2/sinh/cosh/tanh/asinh/acosh/atanh 写成 Math.xxx，常量 Math.PI / Math.E / Math.Tau）；填纯数字和以前一模一样。"/>
                    </Grid>
                    <!-- 数值公式（需求原文：「另加一栏『数值公式』」）：
                         留空 = 0（这条效果不显示也不执行）；写了 = 打出这张牌那一刻现算，卡面显示算出来的数字。
                         只对「伤害 / 格挡 / 失去生命 / 回复生命 / 施加增益减益」这 5 种出现 ——
                         其余种类的数值必须在生成时就定下来（抽几张 / 生成几张要提前分配变量和选牌上限）。
                         锻造链不显示它（上面那个「数值」框本身就能写公式）。 -->
                    <Grid Margin="0,4,0,0" Visibility="{Binding ShowAmountFormulaNormal, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数值（公式）" Style="{StaticResource Label}" MinWidth="96"
                                   ToolTip="写出「打出这张牌那一刻才算」的数字。留空 = 0（这条效果不显示也不执行）。"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}"
                                 x:Name="AmountFormulaBox"
                                 Text="{Binding AmountFormula, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例：M*3（M 是「自定义参数 / 组」页里定义的参数）、max(1, N/2)、X（当前能量）。&#10;⚠ 抽牌 / 生成卡牌 / 消耗这类「数值必须在生成时就定下来」的效果：这一栏只认**纯数字**（例：1、2+3 —— 等同于左边的固定数值，工具会自动折好）或者光秃秃一个 X。&#10;内置实时只读量（不用定义，直接写）：Turn 回合数 / HandCount·DrawCount·DiscardCount·ExhaustCount 各摞张数 / DeckCount 牌组张数 / DeckStatusCount 牌组里的状态牌数 / DiscardedThisTurn·ThisCombat 丢弃张数 / ExhaustedThisTurn·ThisCombat 消耗张数 / PlayedThisTurn·ThisCombat 打出的牌数 / GeneratedThisTurn·ThisCombat 生成张数（含复制）/ EnergySpentThisTurn·ThisCombat 花掉的能量 / StarsGainedThisTurn·ThisCombat 获得的额外资源量 / EnergyGainedThisTurn·ThisCombat 获得的能量 / PowersOnMe 身上状态数 / MyHp·MyMaxHp·MyBlock 自己 / EnemyCount 敌人数 / Floor 层数 …（名字太多，**完整清单见启动时那个「参数参考」小窗**，或者点右边的「…」直接插）。&#10;卡牌专用、读「本张牌这一次打出」的：ThisCardDamage 造成的伤害 / ThisCardBlock 获得的格挡 / ThisCardExhaust·ThisCardDiscard·ThisCardTransform·ThisCardGenerate 消耗·丢弃·变化·生成的张数（只能用在卡牌上）。&#10;支持 + - * / % ( )、比较 &gt; &lt; &gt;= &lt;= == !=、逻辑 &amp;&amp; || !、三元 条件 ? 成立时 : 不成立时（布尔当数值用时真取 1、假取 0），以及 .NET 的 Math 函数（min/max/abs/sign/clamp/floor/ceiling/round/truncate 直接写，pow/sqrt/cbrt/exp/log/log10/log2/三角/双曲写成 Math.xxx，常量 Math.PI / Math.E / Math.Tau，Math.Round(x, AwayFromZero) 是传统四舍五入，Convert.ToInt32(…) 是布尔转 0/1）；最前面可以写一个 =。&#10;留空 = 0（这条效果不显示也不执行）。"/>
                        <!-- V0.2.242：点「…」直接插参数 / 内置读数（卡牌专用那几条排最上面） -->
                        <Button Grid.Column="2" Content="…" Padding="6,1" Margin="4,0,0,0" Click="OnInsertFormulaParam"
                                Tag="{Binding ElementName=AmountFormulaBox}"
                                ToolTip="插入参数 / 内置读数（ThisCardDamage / ThisCardBlock / 四条张数排在最上面）"/>
                    </Grid>
                    <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Visibility="{Binding ShowAmountFormulaNormal, Converter={StaticResource BoolToVis}}"
                               Text="{Binding AmountFormulaHint}"/>
                </StackPanel>

                <!-- 作用对象（V0.2.150 起按种类显示：只有生成端真的会读它的种类才摆。
                     判据见 EffectFieldPolicy.UsesTargetSide —— 机械测量出来的，见那个类的注释）。 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="作用对象（本条效果对谁生效）" Style="{StaticResource Label}"
                           Visibility="{Binding ShowTargetSideRow, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding ShowTargetSideRow, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding TargetSides, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding TargetSide}"/>

                <!-- 需求右侧④：「全部友方（可以选择包不包括召唤物）」—— 只有选了「全部友方」才摆这一行。
                     默认（不勾）= 老行为：同一边的玩家单位全算（含召唤物），生成的过滤条件与 V0.2.131 逐字节相同。
                     这一行对**五条链**都显示（共用表），锻造节点图那边映射成【对象】的「全部友方（只剩自己）」。 -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical">
                <CheckBox Margin="0,2,0,0" Style="{StaticResource Check}"
                          Content="全部友方：不包括召唤物（只算玩家本体）"
                          IsChecked="{Binding AllAlliesExcludePets}"
                          Visibility="{Binding ShowAllyNoPetsOption, Converter={StaticResource BoolToVis}}"
                          ToolTip="只对上面「作用对象 = 全部友方」这一档有意义：&#10;不勾（默认）= 玩家这一边除自己以外的单位（队友 + 召唤物）；&#10;勾上 = 只对玩家本体这类单位生效，召唤物不算（生成时补一句 `c.PetOwner is null`）。"/>
                <!-- V0.2.201（用户问「怎么选全部友方包括自己」）：「全部友方」以前一律不含自己，
                     想含自己只能选「全体单位」——那会把敌人也一起打。这个勾就是把 `c != 自己` 去掉。 -->
                <CheckBox Margin="0,2,0,0" Style="{StaticResource Check}"
                          Content="全部友方：包括自己"
                          IsChecked="{Binding AllAlliesIncludeSelf}"
                          Visibility="{Binding ShowAllAlliesIncludeSelfRow, Converter={StaticResource BoolToVis}}"
                          ToolTip="只对上面「作用对象 = 全部友方」这一档有意义：&#10;不勾（默认）= 同一边里**除自己以外**的单位（队友 + 召唤物）；&#10;勾上 = 自己也算进去（生成时把过滤条件里的 `c != base.Owner.Creature` 去掉）。&#10;它只管**自己这一边**；两边的所有单位（含敌人）请用作用对象「全体单位」。"/>
                </StackPanel>

                <!-- 命中次数（需求右侧④：「不再需要考虑对群数，只考虑命中次数」）：
                     卡牌链上用下面那个横排（固定次数框 + 公式框并排）；其余四条链照旧用老控件（一个字都不变）。 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="对群数/命中次数" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowPlainFixedRepeatBox, Converter={StaticResource BoolToVis}}"
                           ToolTip="只有「造成伤害」「作用对象 = 随机敌人」和几种「伙伴攻击」会用到这个数字；其它种类会自动收起这一栏（填了不生效）。"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowPlainFixedRepeatBox, Converter={StaticResource BoolToVis}}"/>
                <!-- 锻造【效果】模块的「命中次数」：同一栏，框里能写公式（锻造图里一直摆着 —— 本体好几处会读它） -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="对群数/命中次数" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowForgeRepeatBox, Converter={StaticResource BoolToVis}}"
                           ToolTip="多段攻击的段数 / 随机挑几个敌人。锻造图里可以直接写公式或参数（X / Y / 内置只读量）。"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}"
                         Text="{Binding ForgeHitsText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowForgeRepeatBox, Converter={StaticResource BoolToVis}}"/>
                <!-- 卡牌链专用：命中次数（固定次数 + 公式并排；需求右侧④要它们挨着） -->
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0"
                            Visibility="{Binding ShowCardRepeatRow, Converter={StaticResource BoolToVis}}">
                    <TextBox Width="70" Style="{StaticResource Field}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="多段攻击的段数 / 随机挑几个敌人（用得到这个数字的种类才会出现这一行）。"/>
                    <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="96"
                               Text="命中次数（公式）"
                               Visibility="{Binding ShowRepeatFormulaBox, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="150" Style="{StaticResource Field}"
                             x:Name="RepeatFormulaBox"
                             Text="{Binding RepeatFormula, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowRepeatFormulaBox, Converter={StaticResource BoolToVis}}"
                             ToolTip="例：X（= 老勾选框「命中次数 = X」，本体「旋风斩 / 天际钻头」那种）、Turn、2+HandCount。算出来会夹到 1~20；留空 = 用左边那个固定次数。"/>
                    <!-- V0.2.242（用户报「怎么没看到 ThisCardBlock / ThisCardExhaust …」）：公式框旁边直接给一个
                         「…」——点开就是参数 / 内置读数清单（卡牌专用那几条排最上面），不用去翻参数参考窗。 -->
                    <Button Content="…" Padding="6,1" Margin="4,0,0,0" Click="OnInsertFormulaParam"
                            Tag="{Binding ElementName=RepeatFormulaBox}"
                            Visibility="{Binding ShowRepeatFormulaBox, Converter={StaticResource BoolToVis}}"
                            ToolTip="插入参数 / 内置读数（卡牌专用的那几条排最上面）"/>
                </StackPanel>

                <!-- 生效次数：卡牌链上用下面那个横排（固定框 + 公式框并排）。
                     V0.2.238（用户问「生效次数可以填写公式吗」）：遗物 / 药水 / 自定义状态这三条链**也**给
                     「固定框 + 公式框」，和卡牌链同一个形状 —— 生成端已经改成内联求值（见 EmitRepeated 的
                     inlineProfile），所以这里摆出来就真的有用（自检里钉着「摆了就被用到」）。 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="生效次数（整条效果重复几遍）" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowPlainFixedTimesBox, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0"
                            Visibility="{Binding ShowPlainFixedTimesBox, Converter={StaticResource BoolToVis}}">
                    <TextBox Width="70" Style="{StaticResource Field}" Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="整条效果重复执行几遍（1~20）。"/>
                    <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="96"
                               Text="生效次数（公式）"
                               Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="150" Style="{StaticResource Field}"
                             x:Name="TimesFormulaBoxPlain"
                             Text="{Binding TimesFormula, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"
                             ToolTip="例：Turn（这一场第几回合）、HandCount（手牌张数）、2+HandCount。算出来会夹到 1~20；留空 = 用左边那个固定次数。"/>
                    <Button Content="…" Padding="6,1" Margin="4,0,0,0" Click="OnInsertFormulaParam"
                            Tag="{Binding ElementName=TimesFormulaBoxPlain}"
                            Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"
                            ToolTip="插入参数 / 内置读数"/>
                </StackPanel>
                <!-- 锻造【效果】模块的「生效次数」：同一栏，框里能写公式（用户要求⑦ / V0.2.128 的能力） -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="生效次数（整条效果重复几遍）" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowForgeTimesBox, Converter={StaticResource BoolToVis}}"
                           ToolTip="整条效果重复几遍。锻造图里可以直接写公式或参数（X / Y / 内置只读量）。"/>
                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}"
                         Text="{Binding ForgeTimesText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowForgeTimesBox, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0"
                            Visibility="{Binding ShowCardTimesRow, Converter={StaticResource BoolToVis}}">
                    <TextBox Width="70" Style="{StaticResource Field}" Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="整条效果重复执行几遍（1~20）。"/>
                    <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="96"
                               Text="生效次数（公式）"
                               Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="150" Style="{StaticResource Field}"
                             x:Name="TimesFormulaBoxCard"
                             Text="{Binding TimesFormula, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"
                             ToolTip="例：X（= 老勾选框「生效次数 = X」，打出时消耗掉的能量）、Turn（这一场第几回合）、HandCount（手牌张数）。算出来会夹到 1~20；留空 = 用左边那个固定次数。"/>
                    <Button Content="…" Padding="6,1" Margin="4,0,0,0" Click="OnInsertFormulaParam"
                            Tag="{Binding ElementName=TimesFormulaBoxCard}"
                            Visibility="{Binding ShowTimesFormulaBox, Converter={StaticResource BoolToVis}}"
                            ToolTip="插入参数 / 内置读数（卡牌专用的那几条排最上面）"/>
                </StackPanel>

                <!-- ===== 卡牌链专用（需求右侧④给的顺序：…生效次数 → 概率 → 下回合生效 →（其余按种类））=====
                     概率 + 「不同效果的概率之间是否独立」+ 下回合生效这三件事给卡牌链单独摆在这里；
                     遗物 / 药水 / 自定义状态 / 锻造链继续用下面 StackPanel 里那两行老控件（对它们这两行恒为 Collapsed）。 -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0"
                            Visibility="{Binding ShowCardChanceRow, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="概率生效" Style="{StaticResource Check}" IsChecked="{Binding ChanceEnabled}"
                                  ToolTip="勾上以后，这条效果只有下面这个百分比的机会会真的执行；没掷中的话只跳过这一条，同一张牌里的其它效果照常执行。"/>
                        <TextBox Width="70" Margin="8,0,0,0" Style="{StaticResource Field}"
                                 IsEnabled="{Binding ChanceEnabled}"
                                 Text="{Binding ChancePercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="%"/>
                        <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="96"
                                   Text="概率（公式）"
                                   Visibility="{Binding ShowChanceFormulaBox, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Width="150" Style="{StaticResource Field}"
                                 Text="{Binding ChanceFormula, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowChanceFormulaBox, Converter={StaticResource BoolToVis}}"
                                 ToolTip="这条效果生效的百分比（0~100），现算。⚠ 写了公式的这条会**自己独立判一次**，不再和同组其它「概率生效」的效果共用一次掷骰。"/>
                    </StackPanel>
                    <!-- 「不同效果的概率之间是否独立」：默认（不勾）= 老行为 —— 同一张牌里勾了概率的效果
                         共用一次掷骰、各占一段区间（互斥）；勾上 = 这一条自己掷一次。 -->
                    <CheckBox Margin="0,2,0,0" Style="{StaticResource Check}"
                              Content="不同效果的概率各自独立判定（默认 = 同一张牌里共用一次掷骰、各占一段区间）"
                              IsChecked="{Binding ChanceIndependent}"
                              ToolTip="不勾（默认，和老版本一样）：同一张牌里所有勾了「概率生效」的效果**共用一次掷骰**、各占一段区间 —— 掷出 0~39 只跑第一条、40~99 只跑第二条（也就是「不会同时生效」）。&#10;勾上：这一条**自己独立掷一次**，可能和别的概率效果同时中、也可能同时不中。"/>
                </StackPanel>

                <!-- 下回合生效（卡牌链专用那一行；其余四条链用 StackPanel 里那一份老控件） -->
                <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0" Style="{StaticResource Check}"
                          Content="下回合生效（抽牌 / 格挡 / 能量 / 额外资源量 / 增益减益）"
                          IsChecked="{Binding NextTurn}"
                          Visibility="{Binding ShowCardNextTurnRow, Converter={StaticResource BoolToVis}}"
                          ToolTip="只有这五种真的有延迟分支（格挡 / 抽牌 / 能量 / 额外资源量 / 施加扣除状态）：本体的下回合状态或工具生成的延迟状态。别的种类勾不上（这一行不显示）——「生成 / 变化 / 复制卡牌的 下回合生成」还在做。"/>

                <!-- ⚠ 行号说明（V0.2.132 卡牌链重排）：5、6 行现在是**卡牌链专用**的「概率」「下回合生效」
                     （见上面那两块），所以种-类专属的这两行往后挪到 7、8 行。对遗物 / 药水 / 自定义状态 /
                     锻造链来说 5、6 行是空的（Collapsed 的 Auto 行高度为 0）—— 排版位置与以前**完全一样**。 -->
                <!-- 增益 / 减益（V0.2.150 起按种类显示：施加 / 翻倍 / 暴露 / 清除指定状态 / 临时增益 /
                     给伙伴施加状态这 6 种才读它，其余种类一律不摆 —— 见 EffectFieldPolicy.UsesPower）。 -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="增益 / 减益" Style="{StaticResource Label}"
                           Visibility="{Binding ShowPowerRow, Converter={StaticResource BoolToVis}}"/>
                <local:SearchComboBox Grid.Row="8" Grid.Column="1"
                                      Visibility="{Binding ShowPowerRow, Converter={StaticResource BoolToVis}}"
                                      SearchPath="Display"
                                      ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id" SelectedValue="{Binding PowerId}"
                                      ToolTip="直接打字搜索（输入「下」只剩含「下」的项），点选项或按回车自动补全。">
                    <local:SearchComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                    </local:SearchComboBox.ItemTemplate>
                </local:SearchComboBox>

                <!-- V0.2.255（用户要求「让状态进组，然后在清空指定状态的效果里可以选组」）：
                     只有「清除指定状态」用得到 —— 选一个组 = 把**组里所有状态**一次清掉
                     （成员在「组」页那个「这个组里有哪些状态」里勾）。留空 = 只清上面选的那一个状态。 -->
                <TextBlock Grid.Row="17" Grid.Column="0" Text="或者清空一个组" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding UsesPowerGroup, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="17" Grid.Column="1" Margin="0,2,0,0" Style="{StaticResource Pick}"
                          Visibility="{Binding UsesPowerGroup, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding PowerGroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding PowerGroup}"
                          ToolTip="选一个组 = 把组里**所有状态**一次清掉（组在「组」页建，成员在那边勾「这个组里有哪些状态」）。&#10;留空 = 只清上面那一个状态。&#10;两边都填时**组优先**（校验器会提醒一句）。"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="目标卡（生成 / 变化 / 强化用）" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowTargetCardRow, Converter={StaticResource BoolToVis}}"/>
                <local:SearchComboBox Grid.Row="9" Grid.Column="1"
                                      Visibility="{Binding ShowTargetCardRow, Converter={StaticResource BoolToVis}}"
                                      SearchPath="Display"
                                      ItemsSource="{Binding AllCards, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id" SelectedValue="{Binding SpawnCardId, Mode=TwoWay}"
                                      ToolTip="「生成卡牌」= 生成哪张卡；「变化卡牌」= 变成哪张卡（留空 = 随机变化）；「强化指定卡牌」= 强化哪一张卡（必填）。直接打字搜索，点选项或按回车自动补全。">
                    <local:SearchComboBox.ItemTemplate>
                        <!-- 中文名 + 英文类名都留着（Display 里已经拼好了） -->
                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                    </local:SearchComboBox.ItemTemplate>
                </local:SearchComboBox>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="临时增益什么时候撤" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding IsTempPower, Converter={StaticResource BoolToVis}}"
                           ToolTip="只管「临时增益（本回合 +X）」这一种效果。"/>
                <ComboBox Grid.Row="11" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding IsTempPower, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding TempPowerReverseChoices}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding TempPowerReverse}"
                          ToolTip="默认「本回合结束时撤掉」；选「下回合开始时才撤掉」= 撑过这一回合和敌人的回合（例：获得临时 5 点力量 → 下回合开始时失去 5 点力量）。"/>
                <TextBlock Grid.Row="12" Grid.Column="0" Text="生成到（生成卡牌用）" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowSpawnToRow, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="12" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding ShowSpawnToRow, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding SpawnTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding SpawnTo}"/>

                <!-- V0.2.151：标签保持短（「消耗 / 变化 / 丢弃用」那句挪进 ToolTip）——
                     效果栏第一列是 Auto 宽度，标签太长会把第二列那整列输入框挤成一条缝。 -->
                <TextBlock Grid.Row="13" Grid.Column="0" Text="选牌方式" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding ShowCardPickRow, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="13" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding ShowCardPickRow, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding CardPickModes, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding CardPick}"
                          ToolTip="「自己选」= 弹选牌界面让你挑（本体「净化 / 武装」那种）；「随机」= 从那一摞里随机抽（不问玩家）。&#10;要限定只对哪一类牌动手，用下面那一行「范围界定（哪些牌能选）」。&#10;用得到这一行的种类：消耗 / 丢弃 / 变化 / 升级 / 复制 / 重放 / 回合结束自动打出 / 放置卡牌 / 给予关键词 / 三种「全局牌组」效果。"/>

                <!-- 「从哪里选牌」：手牌 / 抽牌堆 / 弃牌堆（本体「充能 / 全息影像 / 挖掘」那种）。
                     「丢弃卡牌」只有手牌 / 抽牌堆（候选由 EffectSpec.SelectPileChoices 按效果种类给），
                     所以标题也绑到 SelectPileLabel 上（那一条的措辞是「从哪里丢弃」）。 -->
                <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource Label}" MinWidth="96"
                           Text="{Binding SelectPileLabel}"
                           Visibility="{Binding UsesSelectPile, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="14" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding UsesSelectPile, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding SelectPileChoices}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectPile}"
                          ToolTip="手牌 = 本体默认；抽牌堆 / 弃牌堆 / 消耗牌堆走本体的 FromCombatPile（「充能 / 净化」选抽牌堆，「全息影像 / 头槌 / 挖掘」选弃牌堆）；「牌顶」= 抽牌堆最上面那张（不用挑、也不随机）；「丢弃卡牌」只能选手牌 / 抽牌堆 / 牌顶，走 CardCmd.Discard 丢进弃牌堆。"/>

                <!-- 「放到哪一摞」（放置 / 复制卡牌专用，V0.2.116 / V0.2.226）：手牌 / 抽牌堆（底）/ 弃牌堆 / 消耗牌堆 / 牌顶
                     数值 0 = 把这张牌自己放到这里（复制卡牌 = 复制这张牌自己）；
                     数值 ≥ 1 = 把从「从哪里选牌」挑出来的那几张放到这里（复制卡牌 = 复制出来的那几张）。 -->
                <TextBlock Grid.Row="16" Grid.Column="0" Text="放到哪一摞" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding UsesPlaceTo, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="16" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding UsesPlaceTo, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding PlaceToChoices}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding PlaceTo}"
                          ToolTip="数值 0 = 把**这张牌自己**放到这里（「复制卡牌」= 复制这张牌自己）；数值 ≥ 1 = 把从「从哪里选牌」挑出来的那几张放到这里（「复制卡牌」= 复制出来的那几张）。&#10;「牌顶」= 抽牌堆最上面（本体 CardPilePosition.Top），「抽牌堆」那一档是本体默认的牌堆底。"/>

                <!-- 「召唤物」下拉：只在「召唤伙伴 / 伙伴攻击」这两种效果上出现（别的效果没有「哪一只」这回事）。
                     候选由 MainWindow.PetSummonsCard / PetSummonsPlain 给（只列**已启用**的召唤物），
                     SelectedValue 存的是 summon 的稳定标识（宠物类名），显示的是它的中文名。 -->
                <TextBlock Grid.Row="15" Grid.Column="0" Text="召唤物（哪一只）" Style="{StaticResource Label}" MinWidth="96"
                           Visibility="{Binding PetAction, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="15" Grid.Column="1" Style="{StaticResource Pick}"
                          Visibility="{Binding PetAction, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding PetSummonsCard, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding PetSummon}"
                          ToolTip="这条效果作用在**哪一只**召唤物上：卡牌 / 遗物在这里选。留空 = 用「召唤物」页里第一只启用的（老存档就是这样）。"/>

                <!-- 这里以下的都是「按条件出现的行」：一律放进这个竖直排列的 StackPanel 里。
                     为什么不各占一格 Grid 行：条件显隐时行高会在 0 和实际高度之间跳，
                     和相邻的 auto 行很容易挤在一起（用户报过「是否临时关键词与其他选项重叠」）。
                     ⚠ V0.2.132：卡牌链的「概率」「下回合生效」已经搬到上面的 5、6 行，
                     这里那两行的 Visibility 因此多了一个「非卡牌链」条件（其余四条链照旧）。 -->
                <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4,0,0">
                    <!-- 「取几张」（V0.2.150 起绑 ShowCountModeRow）：恰好 N / 最多 N（可以少选）/ 任意张。
                         判据 = 机械测量出来的「生成端真的读 CountMode 的种类」（比旧的 UsesCountMode 多几种）。 -->
                    <Grid Visibility="{Binding ShowCountModeRow, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="取几张" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding CountModeChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding CountMode}"
                                  ToolTip="恰好 N 张（默认）= 必须选满；最多 N 张 = 可以少选（本体「净化」那种，界面上会出现确认键）；任意张 = 想选几张都行（卡面不写数字）；全部 = **不弹选牌界面**，直接对所有符合条件的牌动手（本体「恶魔之焰」消耗所有手牌那种；这一档「选牌方式」不生效）。"/>
                    </Grid>
                    <!-- 「给予卡牌关键词」专用：紧跟「选牌方式」，因为数值 / 选牌方式 / 哪一摞牌都是给它的。
                         候选 = 本体那 7 个关键词 + 存档里的自定义关键词（KeywordChoices）。 -->
                    <Grid Visibility="{Binding IsGiveKeyword, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="给予关键词" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding KeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding GivenKeyword}"
                                  ToolTip="要给出去的关键词：上面是本体的 7 个（消耗 / 虚无 / 固有 / 保留 / 不能被打出 / 奇巧 / 永恒），下面是你自己造的关键词（「自定义关键词」页里加的）。"/>
                    </Grid>
                    <CheckBox Style="{StaticResource Check}"
                              Content="是否为临时关键词（只这一回合生效，回合结束自动去掉）"
                              Visibility="{Binding IsGiveKeyword, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding TempKeyword}"
                              ToolTip="勾上 = 这个关键词只本回合有效：保留 / 奇巧走本体的「单回合」标记，其它关键词（含自定义）会在回合结束时被摘掉、卡面上那几个字也一起消失。不勾 = 一直带着。"/>
                    <!-- V0.2.220（用户要求「在抽牌/拿牌等效果下额外填加一条『为抽到的牌添加永久/临时关键词』的选项」）：
                         只在这几档出现 —— 抽牌 / 刮削 / 从三摞拿牌 / 用目标卡填满手牌（生成端真的读这一栏的那几种）。
                         作用的牌 = **这一条效果真的抽到 / 拿到手的那几张**，不是整个手牌。-->
                    <Grid Visibility="{Binding ShowDrawnKeywordRow, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="为抽到的牌加关键词" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding DrawnKeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding DrawnKeyword}"
                                  ToolTip="这一条效果**真的抽到 / 拿到手**的那几张牌加上这个关键词（不是整个手牌）：上面是本体那 7 个，下面是你自己造的关键词。默认「（不加）」= 老行为，生成文本一个字符都不变。"/>
                    </Grid>
                    <CheckBox Style="{StaticResource Check}"
                              Content="抽到的牌的关键词只是临时的（回合结束自动去掉）"
                              Visibility="{Binding ShowDrawnKeywordTempRow, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding DrawnKeywordTemp}"
                              ToolTip="勾上 = 这些抽到的牌只这一回合带着这个关键词（保留 / 奇巧走本体的单回合标记，其它关键词含自定义的会在回合结束时被摘掉）。不勾 = 一直带着。"/>
                    <!-- 「强化指定卡牌」专用：紧跟「目标卡」，因为上面那个下拉选的就是要强化的那张卡。
                         数值 = 加多少（本场战斗内一直有效），填负数就是削弱那张卡。 -->
                    <Grid Visibility="{Binding IsBoostCard, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="强化什么" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding BoostStats, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding BoostStat}"
                                  ToolTip="像本体的「精准」那样给指定的那张卡加伤害，或者像「敏捷」那样加格挡。上面「目标卡」选的那张牌就是要强化的牌；「数值」= 加多少（本场战斗内一直有效，填负数就是削弱）。"/>
                    </Grid>
                    <!-- 生成 / 变化卡牌：取卡方式 + 范围限定 + 「生成出来的卡」的附加处理（用户要求）。
                         V0.2.150：「取卡方式」这一行绑 ShowSpawnPickRow（复制卡牌支持附加处理、
                         但不读取卡方式 / 范围限定，所以那一行不再在它上面白摆）。 -->
                    <Grid Visibility="{Binding ShowSpawnPickRow, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="取卡方式（生成 / 变化）" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding SpawnPicks, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SpawnPick}"
                                  ToolTip="「指定卡」= 用上面「目标卡」里选的那张；「按范围随机」= 从卡池里按下面的范围限定抽（本体「发现 / 炼制药水」那种）。"/>
                    </Grid>
                    <!-- 「指定卡」时的指路提示：用户报过「找不到在哪限定范围」—— 那一行只有切成「按范围随机」才出现 -->
                    <TextBlock Margin="102,2,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#888"
                               Text="想看「范围限定（攻击 / 技能 / 能力 / 诅咒 / 状态）」？把上面这行切成「按范围随机」，它就会出现在下面。"
                               Visibility="{Binding ShowSpawnPickHint, Converter={StaticResource BoolToVis}}"/>
                    <Grid Visibility="{Binding ShowSpawnFilter, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="范围限定（随机出什么）" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SpawnFilter}"
                                  ToolTip="攻击 / 技能 / 能力按牌的类型挑；诅咒 / 状态从那两个本体卡池 + 你自己的卡池里挑（你自己的诅咒 / 状态牌也在候选里）；下面「自定义关键词：…」那些 = 把某个自定义关键词当成一套**卡的组**，只从带这个关键词的牌里出（这一组牌在卡牌页勾关键词就能改）。"/>
                    </Grid>
                    <!-- 范围界定（需求 ③）：**选牌类**效果（消耗 / 丢弃 / 升级 / 给关键词 / 复制 / 重放 /
                         回合结束自动打出 / 从三摞牌拿牌 / 预见）也限定「只对哪一类牌 / 哪一组牌动手」。
                         和上面「范围限定」共用同一份候选（MainWindow.SpawnFilters）与同一个 SpawnFilter 字段
                         —— 文案、自定义关键词分组、校验都只有一份，不用记两套。 -->
                    <Grid Visibility="{Binding ShowCardScopeFilter, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="范围界定（哪些牌能选）" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SpawnFilter}"
                                  ToolTip="「自己选」和「随机」两条路都按这里限：攻击 / 技能 / 能力按牌的类型筛；诅咒 / 状态按稀有度筛（你自己的诅咒 / 状态牌也算）；下面「自定义关键词：…」那些 = 把某个自定义关键词当成一套**卡的组**，只对带这个关键词的牌动手（和「生成 / 变化卡牌」的范围限定是同一份选项）。选「不限」= 和以前完全一样。范围里一张牌都没有时，这条效果什么都不做（不会弹空选牌界面）。"/>
                    </Grid>
                    <!-- V0.2.249（用户要求「减少指定卡牌类别的费用（类似腐化，刺破帷幕），加在效果种类里」）：
                         上面「范围界定」那一行就是「哪一类牌」；这一行只管它持续多久。 -->
                    <Grid Visibility="{Binding IsCostDown, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="持续时间" Style="{StaticResource Label}" MinWidth="96"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource Check}"
                                  Content="只持续本回合（不勾 = 本场战斗一直有效，像腐化）"
                                  IsChecked="{Binding CostDownThisTurn}"
                                  ToolTip="不勾（默认）：这一类牌一直便宜到本场战斗结束（像本体「腐化」）。&#10;勾上：玩家回合结束时自动撤掉（像「本回合技能牌 -1 费」那种一次性效果）。"/>
                    </Grid>
                    <!-- 变化卡牌专用（V0.2.213，用户报的「没法选择目标卡或者组内的牌进行变化」）：
                         上面那个「范围限定」管的是**变成什么**（结果池），这两行管的是**挑哪几张去变**。
                         两个字段是分开的（TransformPick / ScopeCardId），不会一句话两个意思：
                           · 指定卡优先（填了它就以它为准）；
                           · 否则按「范围」筛（类型 / 自定义关键词那一组 / 卡牌组）。
                         老存档两栏都空 → 生成文本与以前逐字一致。 -->
                    <Grid Visibility="{Binding UsesTransformPick, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="变化哪些牌（范围）" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding TransformPick}"
                                  ToolTip="只把「这一档」的牌拿去变化（和上面「范围限定」是同一份选项，但这里筛的是**要被变的那几张**）：&#10;攻击 / 技能 / 能力按牌的类型；诅咒 / 状态按稀有度；「自定义关键词：…」= 把某个关键词当成一套卡的组；「组：…」= 你在「卡牌组」里建的那一组牌。&#10;⚠ 和上面「范围限定（随机出什么）」是两件事：那个管「变成什么」，这个管「变哪些」。&#10;选「不限」= 和以前一样（整摞牌都能被挑中）。"/>
                    </Grid>
                    <Grid Visibility="{Binding UsesTransformPick, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="只变化这张卡" Style="{StaticResource Label}" MinWidth="96"/>
                        <local:SearchComboBox Grid.Column="1"
                                              SearchPath="Display"
                                              ItemsSource="{Binding AllCards, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" SelectedValue="{Binding ScopeCardId, Mode=TwoWay}"
                                              ToolTip="填了它 = **只**把这一张卡拿去变化（上面那一栏就不生效了）；留空 = 不限（按上面那一栏 / 整摞牌）。&#10;想「只变化打击」就选打击；想「牌组里所有打击一起变」用法同上（配合「取几张 = 全部」）。直接打字搜索，点选项或按回车自动补全。">
                            <local:SearchComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </local:SearchComboBox.ItemTemplate>
                        </local:SearchComboBox>
                    </Grid>

                    <!-- 「只对这张卡（指定）」（V0.2.214，用户报的「丢弃 / 消耗卡牌无法选择目标卡或者组」）：
                         丢弃 / 消耗 / 升级 / 复制 / 重放 / 给关键词 / 从三摞拿牌 / 预见 这些「从牌堆里挑牌」的
                         效果上补一个「就这一张卡」——和上面「范围界定」（类型 / 组）是**与**的关系。
                         变化卡牌不显示这一行（它有自己那两行，语义是「变哪些」）。 -->
                    <Grid Visibility="{Binding UsesScopeCardFilterRow, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="只对这张卡（指定）" Style="{StaticResource Label}" MinWidth="96"/>
                        <local:SearchComboBox Grid.Column="1"
                                              SearchPath="Display"
                                              ItemsSource="{Binding AllCards, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" SelectedValue="{Binding ScopeCardId, Mode=TwoWay}"
                                              ToolTip="填了它 = 只对**这一张卡**动手（例：只丢弃「打击」、只消耗「防御」）；和上面「范围界定」是**与**的关系（两个都填就都要满足）。&#10;留空 = 不限（和以前一样）。直接打字搜索，点选项或按回车自动补全。">
                            <local:SearchComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </local:SearchComboBox.ItemTemplate>
                        </local:SearchComboBox>
                    </Grid>

                    <!-- 「从范围里自己挑一张」（用户要求：范围组里的卡不能自己选、只能随机）：
                         勾上之后候选 = 这一组范围里的全部卡（不随机抽），只对「按范围随机」这一档显示。 -->
                    <CheckBox Margin="0,2,0,0" Style="{StaticResource Check}"
                              Content="从范围里自己挑一张（候选 = 这一组里的全部卡，不再随机抽）"
                              IsChecked="{Binding SpawnChosen}"
                              Visibility="{Binding ShowSpawnChosen, Converter={StaticResource BoolToVis}}"
                              ToolTip="不勾 = 按范围随机抽（「多选1」填了就是先随机抽几张候选再挑）；&#10;勾上 = 选牌界面直接列出这一组范围里的所有卡（最多 60 张），你想拿哪张拿哪张；&#10;勾上**并且**「多选1」填了 M（≥2）= 先随机抽 M 张当候选、再自己挑一张（V0.2.206 起「多选1」不会再被这个勾静默忽略）。"/>
                    <!-- 「多选1」（用户要求）：候选张数 > 1 时，先随机抽这么多张候选、玩家挑 1 张生成。
                         默认 1 = 直接生成（原来的行为）。只对「生成卡牌 + 按范围随机」出现。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowSpawnChoice, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" MinWidth="96">多选1</TextBlock>
                        <TextBox Width="70" Margin="0,0,0,0" Style="{StaticResource Field}"
                                 Text="{Binding SpawnChoice, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="张中选一张"/>
                        <!-- V0.2.144：MaxWidth + 换行 —— 这段说明以前是**一行不换行**的超长文字，
                             在窄一点的编辑器里会横向跑出面板（被裁掉、看不全；卡牌页一直如此，
                             三页把编辑器常显之后自检也抓到了）。给一个宽度上限让它自己折行。 -->
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   MaxWidth="320" TextWrapping="Wrap"
                                   Text="（默认 1 = 直接生成；填 3 = 先抽 3 张候选让你挑 1 张，只生成选中的那一张 —— 这时「数值」里的张数不生效，它就是候选张数。本体「发现 Discovery」就是这个界面）"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding UsesSpawnOptions, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="生成 / 变化出来的卡：直接升级" Style="{StaticResource Check}" IsChecked="{Binding SpawnUpgraded}"
                                  ToolTip="本体 CardCmd.Upgrade：战斗里的升级只影响本场战斗（战斗牌是牌组牌的克隆）。"/>
                        <CheckBox Content="生成 / 变化出来的卡：免费打出（本场战斗内 0 费）" Style="{StaticResource Check}" IsChecked="{Binding SpawnFree}"
                                  ToolTip="本体 card.SetToFreeThisCombat()：这张牌在本场战斗里一直是 0 费。"/>
                        <CheckBox Content="生成 / 变化出来的卡：仅本回合免费" Style="{StaticResource Check}" IsChecked="{Binding SpawnFreeThisTurn}"
                                  ToolTip="本体 card.SetToFreeThisTurn()：回合结束自动恢复原费用。"/>
                        <CheckBox Content="生成 / 变化出来的卡：仅本回合升级" Style="{StaticResource Check}" IsChecked="{Binding SpawnUpgradedThisTurn}"
                                  ToolTip="本体没有「临时升级」API，工具会生成一个临时状态记着这几张牌，回合结束时把它们降回来。"/>
                        <!-- 需求 ⑦：「生成 / 变化出来的卡是否加上关键词」—— 像上面四个勾选框一样的一项。
                             「不加关键词」是默认档（老存档就是它，生成出来的代码 / 卡面描述一个字符都不变）。
                             候选和「给予关键词」共用同一份口径：本体那 7 个 + 存档里的自定义关键词。 -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="生成 / 变化出来的卡：加上关键词" VerticalAlignment="Center" FontWeight="Bold" MinWidth="96"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                      ItemsSource="{Binding SpawnKeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SpawnKeyword}"
                                      ToolTip="生成 / 变化出来的那些卡会自动带上这个关键词（第一项「不加关键词」= 什么都不加，和以前的版本一样）。上面是本体的 7 个关键词，下面是你自己造的关键词（「自定义关键词」页里加的）。生成代码和「给予卡牌关键词」共用同一套实现：本体关键词走 AddKeyword，自定义关键词走本工具的关键词补丁（卡面金字 + 悬停说明）。"/>
                        </Grid>
                    </StackPanel>

                    <!-- 播放音效（V0.2.154）：选一个本体 FMOD 事件（候选表是本体内真实用过的事件，
                         也可以直接打字填任何 event:/… 路径）。「数值」那一栏在这一条上是**音量%**
                         （留空 / 0 = 100%）。 -->
                    <Grid Visibility="{Binding IsPlaySfx, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="音效" Style="{StaticResource Label}" MinWidth="96"/>
                        <local:SearchComboBox Grid.Column="1"
                                              SearchPath="Display"
                                              ItemsSource="{Binding SfxChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" SelectedValue="{Binding Sfx, Mode=TwoWay}"
                                              ToolTip="本体音效库里的一个事件（FMOD），生成出来就是一句 SfxCmd.Play(路径, 音量)。&#10;候选是本体内真实用过的事件（攻击 / 格挡 / 治疗 / 金币 / 卡牌 / 遗物 / 地图 / 音乐…）。&#10;想用别的：**直接打字**填路径也行（形如 event:/sfx/xxx），校验器只拦「不像事件路径」的。">
                            <local:SearchComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </local:SearchComboBox.ItemTemplate>
                        </local:SearchComboBox>
                    </Grid>
                    <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Visibility="{Binding IsPlaySfx, Converter={StaticResource BoolToVis}}"
                               Text="「数值」那一栏在这一条上是**音量**：填 100 = 正常音量（留空 / 0 也是 100%），50 = 一半，200 = 两倍。"/>

                    <!-- 播放音频文件（V0.2.155）：选一个你在「美术资源」页上传的音频（.ogg / .mp3 / .wav）。
                         本体注册不了新的 FMOD 事件，所以这条绕开 FMOD：生成时把文件复制进工程 audio/，
                         运行时用 Godot 的 AudioStreamPlayer 播。 -->
                    <Grid Visibility="{Binding IsPlaySoundFile, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="音频文件" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding AudioAssetChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding Sfx, Mode=TwoWay}"
                                  ToolTip="你在「美术资源」页「音效 / 音频」区上传的那些文件（.ogg / .mp3 / .wav）。&#10;生成时会被复制成工程里的 audio/&lt;文件名&gt; 并一起打进 PCK，运行时用 Godot 的 AudioStreamPlayer 播（不走 FMOD）。&#10;要加 / 删音频请到「美术资源」页。"/>
                    </Grid>
                    <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Visibility="{Binding IsPlaySoundFile, Converter={StaticResource BoolToVis}}"
                               Text="「数值」那一栏在这一条上是**音量**（100 = 正常音量）。列表是空的？先去「美术资源」页的「音效 / 音频」区点「上传音频…」。"/>
                    <!-- V0.2.231（用户要求「音频效果底下增加音频是否被下一个自定义音频顶替」）：
                         不勾（默认）= 每次播放各开一个播放器，几段音频叠着响；
                         勾上 = 这段还在放的时候，只要又播放另一个「我上传的音频」，这段就立刻停掉。 -->
                    <CheckBox Margin="6,2,0,0" Style="{StaticResource Check}"
                              Visibility="{Binding ShowSfxReplaceRow, Converter={StaticResource BoolToVis}}"
                              Content="会被下一个自定义音频顶替（不勾 = 允许几段音频叠着响）"
                              IsChecked="{Binding SfxReplace, Mode=TwoWay}"
                              ToolTip="不勾（默认，老行为）：这条音频每次播放都新开一个播放器，和别的音频叠在一起响，上一段不会因为下一段开始而停。&#10;勾上：这段音频还在放着的时候，只要又播放了**另一个「我上传的音频」**（卡牌 / 遗物 / 药水 / 状态 / 锻造图里都算），这段会立刻被停掉、由新的接手 —— 适合「开场音乐 / 长音效」这种不想叠音的东西。&#10;勾了任意一条之后，本模组所有自定义音频都改由一个很小的生成文件 cs/ForgeSfx.cs 播放（没勾任何一条时生成结果和以前逐字一样）。"/>

                    <!-- 需求 ⑨：「获得药水」专用 —— 取药方式（指定 / 随机）+ 目标药水。
                         「目标药水」是一个**可搜索**的下拉，和「目标卡」完全同构（SearchComboBox，
                         候选 = MainWindow.AllPotions = EffectCatalog.Potions：中文名 + 本体药水类名），
                         按中文名打字就能搜到。它只在「指定药水」那一档出现：
                         随机档要哪一瓶由本体的 PotionFactory 决定（本体卡「炼制药水」那套）。 -->
                    <Grid Visibility="{Binding UsesPotionOptions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="取药方式（获得药水）" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding PotionPicks, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding PotionPick}"
                                  ToolTip="「指定药水」= 用下面「目标药水」里选的那一瓶（生成 PotionCmd.TryToProcure&lt;那一瓶&gt;）；「随机药水」= 本体卡「炼制药水」那套随机（PotionFactory，按稀有度抽；战斗外自动换成非战斗药物池）。药水栏满时两种都不发生任何事（不会丢掉 / 替换你已有的药水）。"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowPotionPicker, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标药水" Style="{StaticResource Label}" MinWidth="96"/>
                        <local:SearchComboBox Grid.Column="1"
                                              SearchPath="Display"
                                              ItemsSource="{Binding AllPotions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" SelectedValue="{Binding PotionId, Mode=TwoWay}"
                                              ToolTip="要获得的那一瓶本体药水（显示「中文名  (类名)」）：直接打字搜索中文名，点选项或按回车自动补全。候选来自本机解包工程的药水目录（读不到时从游戏 sts2.dll 反射）。药水栏满时这条效果什么都不发生。">
                            <local:SearchComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </local:SearchComboBox.ItemTemplate>
                        </local:SearchComboBox>
                    </Grid>

                    <!-- 复制卡牌专用：复制的份数（数值 = 选几张，这个 = 每张复制几份）。只有选这个效果时才出现。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowCopies, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" MinWidth="96">复制的份数</TextBlock>
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="份 / 张"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   MaxWidth="320" TextWrapping="Wrap"
                                   Text="（「数值」= 从牌堆里选几张牌，这里 = 每一张复制几份。例：数值 1 + 份数 2 = 选一张牌复制两份。本体「二刀流 DualWield」就是「选 1 张、复制 N 份」）"/>
                    </StackPanel>

                    <!-- 重放卡牌专用：重放次数（数值 = 选几张，这个 = 每张额外打出几次）。只有选这个效果时才出现。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowReplayTimes, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" MinWidth="96">重放次数</TextBlock>
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Text="{Binding ReplayTimes, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="次 / 张"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   MaxWidth="320" TextWrapping="Wrap"
                                   Text="（「数值」= 从牌堆里选几张牌，这里 = 每一张额外打出几次。重放 1 次 = 打出去时连着打 2 次，本体 CardModel.BaseReplayCount 就是这么算的。只能给别的牌加，对自己这张牌没用）"/>
                    </StackPanel>

                    <!-- 回合结束时自动打出专用：数值 0 = 这张牌自己；填 1 以上 = 先选好 N 张、回合结束时打出去。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowTurnEndPlay, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" MinWidth="96">回合结束时</TextBlock>
                        <TextBlock VerticalAlignment="Center" Foreground="#444" FontSize="11" TextWrapping="Wrap" MaxWidth="320"
                                   Text="数值 0 = 打出这张牌后，本回合结束时再自动打出它一次；填 1 以上 = 先按「选牌方式 / 从哪里选牌」挑好 N 张，本回合结束时逐张自动打出它们（不弹选牌界面）。注意：填 0 时只有卡牌能用「这张牌自己」"/>
                    </StackPanel>

                    <!-- 刮削专用：抽 N 张之后「对其中哪些牌动手」（条件）+「做什么」（操作）。
                         条件和操作都可选，默认「非 0 费 + 丢弃」= 本体「刮削 Scrape」的老行为。
                         条件下拉的候选是 MainWindow.ScrapeConds（= EffectCatalog.ScrapeCondsFor(_profile)：
                         非 0 费 / 不限 / 攻击 / 技能 / 能力 / 诅咒 / 状态 / 每个自定义关键词一组）。 -->
                    <Grid Visibility="{Binding ShowScrapeOptions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="其中符合条件的牌" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding ScrapeConds, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ScrapeCond}"
                                  ToolTip="抽上来的 N 张牌里，**哪些**会被下面的操作处理。「非 0 费」= 本体「刮削 Scrape」的判据（要花能量的牌，0 费牌留在手上）；「不限」= 抽到的每一张都动手；攻击 / 技能 / 能力按牌的类型筛；诅咒 / 状态按稀有度筛；「自定义关键词：…」那些 = 把某个自定义关键词当成一套**卡的组**（这一组牌在卡牌页勾关键词就能改，生成时会查成显式判据）。"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowScrapeOptions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="执行" Style="{StaticResource Label}" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding ScrapeOps, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ScrapeOp}"
                                  ToolTip="对那些牌做什么：丢弃（CardCmd.Discard，进弃牌堆、洗牌后会回来，奇巧这类钩子照常触发）/ 消耗掉（CardCmd.Exhaust，本场战斗不再回来）/ 升级（CardCmd.Upgrade，战斗里的升级只影响本场战斗）。"/>
                    </Grid>

                    <CheckBox Content="下回合生效（抽牌 / 格挡 / 能量 / 额外资源量 / 增益减益）" Style="{StaticResource Check}"
                              IsChecked="{Binding NextTurn}"
                              Visibility="{Binding ShowPlainNextTurnRow, Converter={StaticResource BoolToVis}}"
                              ToolTip="只有这五种真的有延迟分支（格挡 / 抽牌 / 能量 / 额外资源量 / 施加扣除状态）：本体的下回合状态或工具生成的延迟状态。别的种类勾不上（这一行不显示）——「生成 / 变化 / 复制卡牌的 下回合生成」还在做。"/>
                    <!-- V0.2.150：「随机目标允许重复选中同一个敌人」只在「作用对象 = 随机敌人」时才摆
                         （别的档它不参与生成 —— 见 EffectFieldPolicy.UsesAllowDuplicates）。 -->
                    <CheckBox Content="随机目标允许重复选中同一个敌人" Style="{StaticResource Check}" IsChecked="{Binding AllowDuplicates}"
                              Visibility="{Binding ShowAllowDuplicatesRow, Converter={StaticResource BoolToVis}}"/>
                    <!-- 概率生效：勾上以后这条效果只有这么多机会会真的执行（不满足就跳过这一条，别的效果照常）
                         ⚠ V0.2.132：卡牌链上这一行搬到了 Grid 第 6 行（和「概率公式」「是否独立」在同一行里），
                         所以这里的 Visibility 多一个「非卡牌链」条件；其余四条链与以前一模一样。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowPlainChanceRow, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="概率生效" Style="{StaticResource Check}" IsChecked="{Binding ChanceEnabled}"
                                  ToolTip="勾上以后，这条效果只有下面这个百分比的机会会真的执行；没掷中的话只跳过这一条，同一张牌 / 遗物 / 状态里的其它效果照常执行。"/>
                        <TextBox Width="70" Margin="8,0,0,0" Style="{StaticResource Field}"
                                 IsEnabled="{Binding ChanceEnabled}"
                                 Text="{Binding ChancePercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="%"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   Text="（1~100，只对「这一条效果」生效，其它效果不受影响）"/>
                    </StackPanel>
                    <!-- 锻造【效果】模块的「概率生效」：锻造图的概率就是**一个百分比**（100 = 必定），
                         所以这里合成一栏，并且框里能直接写公式（V0.2.128 的能力；卡牌那套勾选框 + 区间语义不适用于节点图）。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ShowChanceRowForge, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" MinWidth="96">概率生效（%）</TextBlock>
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Text="{Binding ForgeChanceText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="这条效果生效的百分比：100 = 必定，填 50 = 一半机会。锻造图里可以直接写公式或参数（X / Y / 内置只读量）。&#10;⚠ 锻造图的概率是**这一条各自判一次**（不像卡牌那边同一张牌的几条概率效果共用一次掷骰）。"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   Text="（100 = 必定；只对「这一条效果」生效）"/>
                    </StackPanel>
                    <!-- 本体「缓慢」专用：它的显示/生效数字不是层数（= 内部 SlowAmount×10，每打出一张牌 +10%），
                         所以「施加 30 层缓慢」看不到 30。这里填 30 = 敌人当场受到伤害 +30%。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding IsSlowPower, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" Text="直接把「缓慢」设成" FontWeight="Bold"/>
                        <TextBox Width="70" Margin="8,0,0,0" Style="{StaticResource Field}"
                                 Text="{Binding SlowPercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="%"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="11"
                                   MaxWidth="320" TextWrapping="Wrap"
                                   Text="（本体「缓慢」显示/生效的数字不是层数：它按「本回合每打出一张牌 +10%」算，施加多少层都看不到那个数字。填 30 = 敌人当场受到伤害 +30%，持续到它下一次回合开始。0 = 不设置）"/>
                    </StackPanel>
                    <!-- 「牺牲伙伴」专用：收益类型（格挡 / 伤害 / 获得增益·减益）+ 收益公式（固定 N / 最大生命 × 倍率 / 当前生命）。
                         放在这里（而不是各模板里）是因为「卡牌 / 遗物 / 药水 / 自定义状态」共用 EffectCommon。
                         收益 = 获得增益 / 减益时再多出「状态（牺牲后获得）」那一行 —— 它复用同一个 PowerId
                         字段和「增益 / 减益」那份候选列表，所以只是同一件事的第二个入口。 -->
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="牺牲伙伴：收益" Style="{StaticResource Label}" MinWidth="96"
                               Visibility="{Binding IsPetSacrifice, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Row="12" Grid.Column="1"
                                Visibility="{Binding IsPetSacrifice, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="110" Style="{StaticResource Pick}"
                                      ItemsSource="{Binding PetSacrificeGains, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectedValue="{Binding PetSacrificeGain}"
                                      ToolTip="牺牲伙伴换来的东西：格挡（给你自己）/ 伤害（打敌人，按「作用对象」打）/ 获得增益·减益（层数按右边公式算，状态挂在你身上）。"/>
                            <ComboBox Width="190" Style="{StaticResource Pick}"
                                      ItemsSource="{Binding PetSacrificeFormulas, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectedValue="{Binding PetSacrificeFormula}"
                                      ToolTip="收益怎么算：固定 N（用上面的「数值」）/ 最大生命 × 倍率 / 当前生命。"/>
                            <TextBlock Text="×" VerticalAlignment="Center" FontWeight="Bold"
                                       Visibility="{Binding PetSacrificeUsesMultiplier, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Width="56" Style="{StaticResource Field}"
                                     Visibility="{Binding PetSacrificeUsesMultiplier, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding PetSacrificeMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按最大生命算时的倍率（默认 3 = 本体「牺牲」那张牌）。"/>
                        </StackPanel>
                        <!-- 只有收益 = 获得增益 / 减益 时才出现（IsPetSacrificePower）。
                             和上面的「增益 / 减益」栏是**同一个字段**（PowerId），改哪边都一样。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding IsPetSacrificePower, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="状态（牺牲后获得）" Style="{StaticResource Label}" MinWidth="96"/>
                            <local:SearchComboBox Width="240" SearchPath="Display"
                                                  ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Id" SelectedValue="{Binding PowerId}"
                                                  ToolTip="牺牲伙伴之后挂到**你自己**身上的状态（层数按上面的公式算）。和上面的「增益 / 减益」是同一栏：在哪边选都一样。可以直接打字搜索。">
                                <local:SearchComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                </local:SearchComboBox.ItemTemplate>
                            </local:SearchComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 一条效果自己的「条件选项」（卡牌用：可以选「不满足时这张牌打不出去」） -->
        <DataTemplate x:Key="EffectConditionCard">
            <GroupBox Header="条件选项（只对上面这一条效果生效）" Margin="0,8,0,0">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="条件" Style="{StaticResource Label}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Pick}"
                              ItemsSource="{Binding CardEffectConditions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Kind}"/>

                    <!-- 需求⑩「卡牌时机」：选了它才出现这个「子时机」下拉（被消耗 / 被生成 / 被保留 / 被丢弃 / 被变化 / 被给予自定义关键词）。
                         它和别的条件不一样：带它的效果不写进 OnPlay，而是挂到本体对应时机的钩子上。 -->
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="卡牌时机" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsTiming, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsTiming, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionTimings, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Timing}"
                              ToolTip="这张牌在什么时候触发这条效果（挂到本体对应的钩子上，和本体「战鼓」一样）。"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="数值 N" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"/>
                    <!-- 数值 N + 生命区间的第二个数值 M：放进会自动换行的面板里，
                         面板窄的时候也不会互相压住 / 跑到可视区外面（遗物那只以前连 M 框都没有） -->
                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="填负数 = 判断反过来（例：生命值低于 -20 → 高于 20%；至少 -2 层 → 少于 2 层）。"/>
                        <!-- 条件数值的公式（用户要求⑦：所有能填数值的地方都能写公式）：
                             只长在**卡牌**这个模板上（公式求值要卡牌那条链的两个局部变量）。 -->
                        <TextBox Width="160" Margin="4,0,0,0" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.ShowAmountFormula, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.AmountFormula, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="数值 N 的公式（留空 = 用左边那个固定数字）。写法与「数值公式」一样：参数 M / N…、X / Y、内置只读量 Turn / HandCount / DiscardedThisTurn / PowersOnMe…。写了公式时「填负数 = 反向」不生效（要反向请把负号写进公式）。"/>
                        <!-- 生命区间：第二个数值（M%）。任一填负数 = 判断成「区间外」（用户要求） -->
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="~ 数值 M（%）" Style="{StaticResource Label}"
                                   Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Width="70" Margin="4,0,0,0" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount2, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="生命区间的上界（%）。任意一个数值填负数 = 判断成「区间外」。"/>
                        <TextBox Width="160" Margin="4,0,0,0" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.ShowAmount2Formula, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount2Formula, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="数值 M（区间上界）的公式（留空 = 用左边那个固定数字）。写法和数值 N 的公式一样。"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="#888" FontSize="11"
                               Visibility="{Binding Condition.ShowAmountFormula, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Condition.ConditionFormulaHint}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"/>
                    <local:SearchComboBox Grid.Row="1" Grid.Column="3" Margin="4,0,0,0"
                             Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"
                             ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedValuePath="Id" SelectedValue="{Binding Condition.PowerId, Mode=TwoWay}"
                             SearchPath="Display">
                        <local:SearchComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                        </local:SearchComboBox.ItemTemplate>
                    </local:SearchComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="指向对象" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Target}"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                              Style="{StaticResource Check}"
                              Content="条件不满足时这张牌打不出去（不勾 = 能打出，只是这条效果不生效）"
                              IsChecked="{Binding Condition.UnplayableWhenUnmet}"/>
                    <!-- V0.2.247（用户要求）：上一张打出的牌的「关键词 / 范围（可按组）」两条新条件 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="关键词" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionKeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Keyword}"
                              ToolTip="「上一张打出的牌带有某关键词」用得到：本体关键词（消耗 / 虚无 / 固有 / 保留 / 不能被打出 / 奇巧 / 永恒）。要判自定义关键词请用右边的「牌的范围」。"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="牌的范围" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Scope}"
                              ToolTip="「上一张打出的牌是某范围」用得到：攻击 / 技能 / 能力 / 诅咒 / 状态 / 任务 / 自定义关键词那一组 / 每个组（和「范围界定」同一份候选）。留空 = 任意牌（这条条件等于没判）。"/>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <!-- 一条效果自己的「条件选项」（遗物 / 自定义状态用：不满足时只有这一条效果不生效） -->
        <DataTemplate x:Key="EffectConditionPlain">
            <GroupBox Header="条件选项（只对上面这一条效果生效）" Margin="0,8,0,0">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="条件" Style="{StaticResource Label}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Pick}"
                              ItemsSource="{Binding PlainEffectConditions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Kind}"/>

                    <!-- 需求⑩「卡牌时机」的子时机。这一版模板是遗物 / 自定义状态用的：那些地方的条件表里
                         没有「卡牌时机」（ForCard = false，校验器会报错），所以这个下拉永远不会显示出来 ——
                         但绑定还是写上，免得以后放开时漏一处。 -->
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="卡牌时机" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsTiming, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsTiming, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionTimings, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Timing}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="数值 N" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"/>
                    <!-- 数值 N + 生命区间的第二个数值 M：放进会自动换行的面板里，
                         面板窄的时候也不会互相压住 / 跑到可视区外面（遗物那只以前连 M 框都没有） -->
                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="填负数 = 判断反过来（例：生命值低于 -20 → 高于 20%；至少 -2 层 → 少于 2 层）。"/>
                        <!-- 生命区间：第二个数值（M%）。任一填负数 = 判断成「区间外」（用户要求） -->
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="~ 数值 M（%）" Style="{StaticResource Label}"
                                   Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Width="70" Margin="4,0,0,0" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount2, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="生命区间的上界（%）。任意一个数值填负数 = 判断成「区间外」。"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"/>
                    <local:SearchComboBox Grid.Row="1" Grid.Column="3" Margin="4,0,0,0"
                             Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"
                             ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedValuePath="Id" SelectedValue="{Binding Condition.PowerId, Mode=TwoWay}"
                             SearchPath="Display">
                        <local:SearchComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                        </local:SearchComboBox.ItemTemplate>
                    </local:SearchComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="指向对象" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Target}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="#888" FontSize="11"
                               Text="不满足时只有这一条效果不生效，其它效果照常执行。"/>
                    <!-- V0.2.247（用户要求）：上一张打出的牌的「关键词 / 范围（可按组）」两条新条件 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="关键词" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionKeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Keyword}"
                              ToolTip="「上一张打出的牌带有某关键词」用得到：本体关键词（消耗 / 虚无 / 固有 / 保留 / 不能被打出 / 奇巧 / 永恒）。要判自定义关键词请用右边的「牌的范围」。"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="牌的范围" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Scope}"
                              ToolTip="「上一张打出的牌是某范围」用得到：攻击 / 技能 / 能力 / 诅咒 / 状态 / 任务 / 自定义关键词那一组 / 每个组（和「范围界定」同一份候选）。留空 = 任意牌（这条条件等于没判）。"/>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <!-- 自定义状态（能力）的触发器用：和上面那块一样，只是候选表是「状态里能用的条件」
             （PowerEffectConditions = ForPower；里面有「某状态层数刚好达到 N 层」这种只有
              「某个状态层数变化后」那条钩子才成立的条目）。 -->
        <DataTemplate x:Key="EffectConditionPower">
            <GroupBox Header="条件选项（只对上面这一条效果生效）" Margin="0,8,0,0">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="条件" Style="{StaticResource Label}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Pick}"
                              ItemsSource="{Binding PowerEffectConditions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Kind}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="数值 N" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"/>
                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Width="70" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="「拥有某状态至少 N 层」填负数 = 少于 N 层。「刚好达到 N 层」不支持负数。"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="~ 数值 M（%）" Style="{StaticResource Label}"
                                   Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Width="70" Margin="4,0,0,0" Style="{StaticResource Field}"
                                 Visibility="{Binding Condition.NeedsAmount2, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Condition.Amount2, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"/>
                    <local:SearchComboBox Grid.Row="1" Grid.Column="3" Margin="4,0,0,0"
                             Visibility="{Binding Condition.NeedsPower, Converter={StaticResource BoolToVis}}"
                             ItemsSource="{Binding AllPowers, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedValuePath="Id" SelectedValue="{Binding Condition.PowerId, Mode=TwoWay}"
                             SearchPath="Display">
                        <local:SearchComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                        </local:SearchComboBox.ItemTemplate>
                    </local:SearchComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="指向对象" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsTarget, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Target}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="#888" FontSize="11"
                               Text="不满足时只有这一条效果不生效。「某状态层数刚好达到 N 层」只能挂在触发时机「某个状态层数变化后」上（校验器会拦住别的时机）。"/>
                    <!-- V0.2.247（用户要求）：上一张打出的牌的「关键词 / 范围（可按组）」两条新条件 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="关键词" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsKeyword, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ConditionKeywordChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Keyword}"
                              ToolTip="「上一张打出的牌带有某关键词」用得到：本体关键词（消耗 / 虚无 / 固有 / 保留 / 不能被打出 / 奇巧 / 永恒）。要判自定义关键词请用右边的「牌的范围」。"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="牌的范围" Style="{StaticResource Label}"
                               Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource Pick}"
                              Visibility="{Binding Condition.NeedsScope, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding SpawnFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding Condition.Scope}"
                              ToolTip="「上一张打出的牌是某范围」用得到：攻击 / 技能 / 能力 / 诅咒 / 状态 / 任务 / 自定义关键词那一组 / 每个组（和「范围界定」同一份候选）。留空 = 任意牌（这条条件等于没判）。"/>
                </Grid>
            </GroupBox>
        </DataTemplate>

        <!-- 卡牌用：带「升级增量」+「次数公式」
             ⚠ V0.2.131：原来这里的「升级后费用」那一栏**搬到卡牌页中间的费用栏下方**了
             （需求右侧②：「去除升级后费用（重复了）」—— 是搬家不是删除）；
             三个「= X」勾选框（数值 / 生效次数 / 命中次数·对群数）也按需求右侧③删掉了，
             X 改成在「数值（公式）」「次数公式」那几个框里写（X 这个能力本身一个字没少）。 -->
        <DataTemplate x:Key="EffectEditorCard">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="升级增量" Style="{StaticResource Label}"
                                   Visibility="{Binding ShowUpgradeAmountRow, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding UpgradeAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowUpgradeAmountRow, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <!-- 次数类公式（用户要求⑦：所有能填数值的地方都能写公式，次数类优先）。
                         只做在卡牌上，所以这一块长在「卡牌专用」的模板里（遗物 / 药水 / 状态看不到）。
                         ⚠ V0.2.132：需求右侧④给的顺序是「…命中次数 → 生效次数 → 概率 → 下回合生效」，
                         所以「生效次数 / 命中次数 / 概率」三格已经**搬到上面 EffectCommon 里那三行**
                         （和各自的固定值框并排）；这里只剩「复制的份数 / 重放次数」这两格
                         （它们是「其余按种类只留用得到的」那一档，跟着复制 / 重放效果出现）。 -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectCommon}"/>
                    <GroupBox Header="次数公式（复制的份数 / 重放次数；留空 = 用上面那个固定次数）" Margin="0,6,0,0">
                        <StackPanel>
                            <Grid Visibility="{Binding ShowCopiesFormulaBox, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="复制的份数" Style="{StaticResource Label}" MinWidth="96"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}"
                                         Text="{Binding CopiesFormula, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="每张复制几份。算出来会夹到 1~20。"/>
                            </Grid>
                            <Grid Margin="0,4,0,0" Visibility="{Binding ShowReplayFormulaBox, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="重放次数" Style="{StaticResource Label}" MinWidth="96"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}"
                                         Text="{Binding ReplayFormula, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="每张额外打出几次。算出来会夹到 1~20。"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="6,4,0,0"
                                       Text="{Binding CountFormulaHint}"/>
                        </StackPanel>
                    </GroupBox>
                    <!-- V0.2.182：这里原来摆着「可用量」清单（80 条内置只读量铺成一大片）—— 用户要求
                         「参数占的面积太大了，全删了、不占用生成器内的位置」，改成**启动时弹出的参考窗**
                         （ParamReferenceWindow：按类分好 + 写明出处）。要看清单点那个窗，编辑器里不再占地方。 -->
                    <!-- 条件选项：每条效果各自一份（以前是整张牌一个条件，现在改成跟着效果走） -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectConditionCard}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 遗物用：不能升级，没有「升级增量」
             ⚠ V0.2.137：模板拆成「外壳（滚动条）+ 内容」两层 —— 内容这一层单独一份
             `EffectEditorPlainInner`，好让三页（遗物 / 药水 / 额外资源量）的效果栏
             在**共享编辑区**里引到不含滚动条的那一层（外壳自己已经有 ScrollViewer）。
             V0.2.144：三页右侧统一成卡牌页那种「上面一行摘要列表 + 下面一块共享编辑区」，
             折叠行模板 EffectEditorCollapsible 已删；这块 Inner 现在被编辑区直接引用。 -->
        <DataTemplate x:Key="EffectEditorPlainInner">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectCommon}"/>
                <!-- V0.2.182：这里原来也摆着一份「可用量」清单（和卡牌页那份同一个模板）—— 同上，删掉，
                     改到启动时弹出的 ParamReferenceWindow 里看。 -->
                <!-- 「转化为先古卡」的配对表（只在遗物上、只在选了那个效果种类时出现）。
                     模板本体放在 MainWindow.xaml 的窗口资源里（AncientPairingEditor）——
                     App.xaml 里的模板里写 Click 会被解析成 App 的方法（CS1061），放窗口里才绑得到。 -->
                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource AncientPairingEditor}"/>
                <!-- 「转化为先古遗物」的两栏（只在遗物上、只在选了那个效果种类时出现） -->
                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource AncientRelicSwapEditor}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectConditionPlain}"/>
                <!-- 「召唤物」下拉（遗物版）：候选和卡牌版一样，只是走独立模板方便自检区分 -->
                <Grid Margin="0,6,0,0" Visibility="{Binding PetAction, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="召唤物（哪一只）" Style="{StaticResource Label}" MinWidth="96"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                              ItemsSource="{Binding PetSummonsPlain, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding PetSummon}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EffectEditorPlain">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPlainInner}"/>
            </ScrollViewer>
        </DataTemplate>

        <!-- 自定义状态（能力）的触发器用：没有升级/X，多了三个「= 本状态层数」开关 -->
        <DataTemplate x:Key="EffectEditorPower">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="效果种类" Style="{StaticResource Label}"/>
                        <!-- 【自定义状态专用】候选表是收窄过的 PowerKinds：状态触发器的钩子里没有手牌 /
                             选牌界面这些卡牌上下文，所以只能放「不需要卡牌上下文」的种类。
                             以前这里是全量候选，用户能选到状态里不支持的种类、选完才被校验器拦下来
                             （用户实测报过：「追忆（增益）玩家回合开始时 → 从弃牌堆拿 1 张」被拦住）。 -->
                        <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                                  ItemsSource="{Binding PowerKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Display" SelectedValuePath="Kind" SelectedValue="{Binding Kind}"/>
                    </Grid>
                    <TextBlock Margin="6,0,0,2" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Text="这里只列「状态里能用」的种类（状态钩子里没有手牌 / 选牌界面）。要选别的种类，请把它放到卡牌 / 遗物 / 药水上。"/>
                    <CheckBox Margin="6,0,0,0" Style="{StaticResource Check}"
                              Content="数值 = 本状态的层数"
                              IsChecked="{Binding AmountIsStack}"
                              ToolTip="本体恶魔形态那种：「每回合获得等于层数的力量」。勾上之后「数值」那一栏就不用了；不勾就用上面填的数字。"/>
                    <CheckBox Margin="6,0,0,0" Style="{StaticResource Check}"
                              Content="生效次数 = 本状态的层数"
                              IsChecked="{Binding TimesIsStack}"
                              ToolTip="整条效果按层数重复执行：5 层 +「造成 2 点伤害」= 每次触发打 5 次（共 10 点，本体旋风斩那种多段）。勾上之后「生效次数」那一栏就不用了。层数很大时会执行很多次，注意别把层数堆到几百。"/>
                    <CheckBox Margin="6,0,0,0" Style="{StaticResource Check}"
                              Content="命中次数 / 对群数 = 本状态的层数"
                              IsChecked="{Binding RepeatIsStack}"
                              ToolTip="只对「随机敌人」这类按次数挑目标的效果有意义：层数 = 挑几个目标。"/>
                    <TextBlock Margin="6,2,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="11"
                               Text="注意：层数本身不会让效果多跑几遍 —— 想让层数决定强度就勾「数值 = 层数」，想让层数决定次数就勾「生效次数 = 层数」。&#10;⚠ 勾了「数值 = 本状态的层数」之后，下面效果里的「数值」框填什么都**不用**了（用的是触发那一刻的当前层数）—— 所以「生成卡牌」会按当时的层数生成那么多张、伤害也会按层数算。想用固定数字就把这个勾去掉。"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectCommon}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectConditionPower}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 药水用：和遗物一样，但保留底下的说明文字。
             ⚠ V0.2.137：和 EffectEditorPlain 同一个拆法（外壳 + `EffectEditorPotionInner`）。
             V0.2.144：三页版式统一成卡牌页那种「摘要列表 + 一块共享编辑区」，
             所以 `EffectEditorPotionInner` 现在被药水页那块共享编辑区**直接**引用
             （折叠行模板 EffectEditorCollapsible 已经删掉）。 -->
        <DataTemplate x:Key="EffectEditorPotionInner">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectCommon}"/>
                <!-- 药水上的「召唤伙伴 / 伙伴攻击」是**不支持**的（校验器会报错拦住），
                     这里仍然给一个下拉，免得用户在药水上选了这两种效果却找不到「哪一只」，
                     以为是界面出问题了 —— 生成时写出的是「药水不支持」那行说明注释。 -->
                <Grid Margin="0,6,0,0" Visibility="{Binding PetAction, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="召唤物（哪一只）" Style="{StaticResource Label}" MinWidth="96"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}"
                              ItemsSource="{Binding PetSummonsPlain, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding PetSummon}"/>
                </Grid>
                <TextBlock Margin="6,6,0,0" TextWrapping="Wrap" Foreground="#888"
                           Text="作用对象：自己 = 给自己加增益 / 对自己造成伤害；单体敌人 = 选一个目标；全体敌人 = 直接全打。&#10;生效次数 = 整条效果重复执行几遍，填 1 就只执行一次。&#10;生成卡牌：数值 = 生成几张，目标卡 = 生成哪张；消耗 / 变化卡牌：数值 = 处理几张手牌。&#10;注意：药水**不支持**「召唤伙伴 / 伙伴攻击」（没有 choiceContext / 玩家选中的目标），校验器会报错拦住。"/>
                <!-- 这一条效果自己的「条件选项」（V0.2.144）：
                     以前药水页的条件只长在**右下角那一块独立框**里（那块现在撤掉了，因为整页版式
                     改成了卡牌页那种「摘要列表 + 一块共享编辑区」，条件跟着这一条效果走）。
                     候选表还是 PlainEffectConditions（ForRelic && ForPower）—— 和以前那块完全同一份；
                     生成端 / 校验器一个字都没动（V0.2.127 起药水条件就是走遗物那一套 CondCtx.Potion）。 -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectConditionPlain}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EffectEditorPotion">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectEditorPotionInner}"/>
            </ScrollViewer>
        </DataTemplate>

        <!-- 锻造【效果】模块专用（V0.2.129 = 《锻造优化.md》第 3 条 / 用户拍板 Q1=A）：
             和「卡牌」页的效果编辑器**就是同一套** —— 同一个 EffectSpec、同一份 EffectCommon 模板，
             所以「每一条效果的选择出现的可填写项」两边**完全一致**（效果种类底下按种类出现的那一整套：
             数值 / 数值公式 / 作用对象 / 命中次数 / 生效次数 / 增益减益 / 目标卡 / 生成到 / 取牌方式 /
             从哪里选牌 / 取几张 / 范围界定 / 多选1 / 附加处理 / 目标药水 / 复制的份数 / 刮削 / 下回合生效 /
             概率 / 缓慢 / 牺牲伙伴…）。
             这一层只做两件事：
               ① 上面那句说明（锻造图自己的三条规矩：数值那几栏直接写公式、【对象】模块决定目标、
                  没接的种类 / 栏位会被校验器报错拦住）；
               ② 摆一份「可用量」清单（公式里能写哪些量）。
             卡牌那份模板里的「升级增量 / 升级后费用 / 次数公式 / 条件选项」**不摆**：
             节点图里它们没有落点（升级由两张布决定、次数在「生效/命中次数」框里写、条件用【条件】模块），
             摆出来只会让用户白填 —— 真从别的途径填了，校验器会报错说清（ForgeGraphGen.UnsupportedEffectSettings）。 -->
        <DataTemplate x:Key="EffectEditorForge">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="2,0,2,4" TextWrapping="Wrap" Foreground="#0A7" FontSize="11"
                               Text="{Binding ForgeEffectHint}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EffectCommon}"/>
                    <!-- V0.2.182：这里原来也摆着一份「可用量」清单（节点图那份）—— 同上，删掉，
                         改到启动时弹出的 ParamReferenceWindow 里看。 -->
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Application.Resources>
</Application>
